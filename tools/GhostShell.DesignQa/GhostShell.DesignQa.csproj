<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/GhostShell.App/GhostShell.App.csproj" />
    <ProjectReference Include="../../src/GhostShell.Databases/GhostShell.Databases.csproj" />
    <ProjectReference Include="../../src/GhostShell.Previews/GhostShell.Previews.csproj" />
    <!-- The harness renders the real file panel over a real local provider, so
         a preview capture is the shipped path rather than a mock of it. -->
    <ProjectReference Include="../../src/GhostShell.Files/GhostShell.Files.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1852;CA1812</NoWarn>
  </PropertyGroup>

</Project>
