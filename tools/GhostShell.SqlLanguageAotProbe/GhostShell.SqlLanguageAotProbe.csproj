<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GhostShell.SqlLanguageAotProbe</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GhostShell.Application/GhostShell.Application.csproj" />
    <!-- Compile the exact production client sources in isolation. The broader
         Infrastructure assembly still contains legacy reflection-based JSON;
         that unrelated migration must not hide regressions in this new AOT
         boundary. -->
    <Compile Include="../../src/GhostShell.Infrastructure/CalciteSqlLanguageService.cs" Link="CalciteSqlLanguageService.cs" />
    <Compile Include="../../src/GhostShell.Infrastructure/CalciteSqlLanguageSession.cs" Link="CalciteSqlLanguageSession.cs" />
    <Compile Include="../../src/GhostShell.Infrastructure/SqlLanguageWorkerProtocol.cs" Link="SqlLanguageWorkerProtocol.cs" />
    <Compile Include="../../src/GhostShell.Infrastructure/UnavailableSqlLanguageSession.cs" Link="UnavailableSqlLanguageSession.cs" />
  </ItemGroup>

</Project>
