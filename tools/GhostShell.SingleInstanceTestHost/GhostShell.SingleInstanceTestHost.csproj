<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\..\src\GhostShell.Desktop\GhostShell.Desktop.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</GhostShellWindowsBuild>
    <GhostShellWindowsBuild Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</GhostShellWindowsBuild>
    <NuGetLockFilePath Condition="'$(GhostShellWindowsBuild)' == 'true' and '$(RuntimeIdentifier)' == ''">packages.windows.lock.json</NuGetLockFilePath>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(GhostShellWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(GhostShellWindowsBuild)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting Condition="'$(GhostShellWindowsBuild)' == 'true'">true</EnableWindowsTargeting>
    <AssemblyName>GhostShell.SingleInstanceTestHost</AssemblyName>
  </PropertyGroup>

</Project>
