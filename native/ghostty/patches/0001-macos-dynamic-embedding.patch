+    /// Return canonical terminal state needed by an embedding automation
+    /// client. This is read under the same renderer-state lock as read_text.
+    export fn ghostty_surface_screen_state(surface: *Surface) SurfaceScreenState {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const terminal_state = core_surface.renderer_state.terminal;
+        const screen = terminal_state.screens.active;
+        return .{
+            .columns = @intCast(screen.pages.cols),
+            .rows = @intCast(screen.pages.rows),
+            .cursor_column = @intCast(screen.cursor.x),
+            .cursor_row = @intCast(screen.cursor.y),
+            .alternate_screen = @intFromBool(terminal_state.screens.active_key == .alternate),
+            .bracketed_paste = @intFromBool(terminal_state.modes.get(.bracketed_paste)),
+        };
+    }
