<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaConverters="using:Avalonia.Controls.Converters"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:converters="using:GhostShell.App.Converters"
    xmlns:icons="using:FluentIcons.Avalonia">
  <Styles.Resources>
    <avaloniaConverters:ToBrushConverter x:Key="ColorBrushConverter" />
    <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
    <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
    <converters:OnOffConverter x:Key="OnOffConverter" />
    <converters:CornerRadiusConverter x:Key="CornerRadiusConverter" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource ShellBaseFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource ShellUiFontFamily}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>

  <!-- Push buttons stand on the control surface, which each platform profile
       raises to its own taste: macOS lifts controls well above the surface with a
       translucent hairline, while the product profile keeps them nearly flush. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ShellControlSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource ShellButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
    <!-- A label centers in its button, as the host draws push buttons; a
         MinWidth wider than the content must not leave the label leaning
         into a corner. Row-like buttons opt back out with Stretch. -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellControlHoverBrush}" />
  </Style>

  <!--
    Avalonia draws a hard high-contrast rectangle outside the control by default.
    It ignores the control's shape and reads as damage on dark chrome, so the
    shell suppresses it and expresses focus as an accent ring on the control
    itself, which still satisfies visible-focus requirements.
  -->
  <Style Selector="Button, ToggleButton, CheckBox, RadioButton, ComboBox, TextBox, NumericUpDown, ListBoxItem, TabItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.IconButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.IconButton:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.48" />
  </Style>

  <!-- An icon button is a fixed square whose whole content is one glyph, so it
       centres both ways. Inheriting the shell's stretch alignment left each glyph
       resting wherever its own metrics put it, which reads as buttons that are
       not aligned with each other. -->
  <Style Selector="Button.IconButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.IconButton > icons|SymbolIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.IconButton.Large">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>

  <!-- File actions live inside one macOS-style toolbar capsule. Their disabled
       state must remain quiet; the Fluent template otherwise paints a separate
       rounded lozenge behind every unavailable action. -->
  <Style Selector="Border.FileToolbarGroup">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button.IconButton.FileToolbarAction">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.IconButton.FileToolbarAction /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.IconButton.FileToolbarAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.IconButton.FileToolbarAction:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.IconButton.FileToolbarAction.InsetToggle.active /template/ ContentPresenter">
    <Setter Property="Margin" Value="{DynamicResource ShellInsetXs}" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <!-- Title-bar navigation keeps keyboard focus visible without drawing a heavy
       control ring beside the native traffic lights. -->
  <Style Selector="Button.IconButton.ChromeNavigation:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.IconButton.ChromeNavigation:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.SavedConnectionShortcutSurface">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button.SavedConnectionShortcutPrimary">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{controls:Inset Horizontal=Sm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.SavedConnectionShortcutMenu">
    <Setter Property="Width" Value="31" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.SavedConnectionShortcutPrimary:pointerover /template/ ContentPresenter, Button.SavedConnectionShortcutMenu:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Flyouts, menu flyouts, and ComboBox popups are the same transient surface.
       Keeping that surface here prevents each selector from inventing its own
       background, radius, and item density. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Padding" Value="{DynamicResource ShellInsetXs}" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="FlyoutPresenter.SavedConnectionMenu">
    <Setter Property="MinWidth" Value="190" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
    <Setter Property="Padding" Value="{controls:Inset Horizontal=Md, Vertical=Sm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.FlyoutMenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="{DynamicResource ShellInsetSm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button.FlyoutMenuItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.PrimaryButton">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{DynamicResource ShellButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button.SecondaryButton">
    <Setter Property="Background" Value="{DynamicResource ShellControlSurfaceBrush}" />
    <Setter Property="Padding" Value="{DynamicResource ShellButtonPadding}" />
  </Style>

  <Style Selector="Button.SecondaryButton.painting">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="Button.SecondaryButton.active">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!--
    Destructive icon actions stay quiet at rest — a row of outlined red boxes
    reads as an error state — and take their danger tint on hover or focus.
  -->
  <!--
    Tone, on the icon button. This was a class of its own called DangerButton, a
    fixed 32x30 box with no padding — an icon button wearing a text button's name.
    Ten of its eleven uses were icons, and the eleventh was a labelled button whose
    text the fixed width cut off. Shape and tone are separate axes: a destructive
    action that carries a label is a DestructiveButton, and one that carries a
    glyph is this.
  -->
  <Style Selector="Button.IconButton.Danger">
    <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
  </Style>

  <Style Selector="Button.IconButton.Danger > icons|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
  </Style>

  <Style Selector="Button.IconButton.Danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellDangerSoftBrush}" />
  </Style>

  <Style Selector="Button.IconButton.Danger:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellDangerBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--
    A destructive action is an ordinary push button whose label carries the
    danger — the host convention — rather than a red-outlined box that reads as
    an error state before anything has gone wrong. Hover states the consequence
    by filling with the danger tone.
  -->
  <Style Selector="Button.DestructiveButton">
    <Setter Property="Background" Value="{DynamicResource ShellControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellControlBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellDangerBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{DynamicResource ShellButtonPadding}" />
  </Style>

  <Style Selector="Button.DestructiveButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellDangerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ShellDangerForegroundBrush}" />
  </Style>

  <!--
    A text button is a button without chrome, not a button of another size. It kept
    a literal inset and no minimum height, so it sat a few pixels short of every
    control beside it and no row of actions ever lined up.
  -->
  <Style Selector="Button.TextButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource ShellButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize10}" />
  </Style>

  <Style Selector="Button.TextButton.Accent">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!--
    A search field fills the width it is given. Stretching only its content left
    the button itself sized to its placeholder, so the field stopped short of the
    panel it belongs to.
  -->
  <Style Selector="Button.SearchButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="{controls:Inset Horizontal=Md}" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="{controls:Inset Horizontal=Xs}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <!-- Rows fill the list so trailing badges and shortcuts stay right-aligned. -->
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
  </Style>

  <!--
    A list whose rows already carry colour of their own — a workspace tile, a
    tab's kind — cannot also be selected in accent: the two colours fight and
    the row reads as an alert. These rows are selected by lifting the surface
    instead, which is what a list of things you are choosing between looks like
    when the things are not themselves neutral.
  -->
  <Style Selector="ListBox.NeutralSelection > ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="ListBox.NeutralSelection > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="ListBox.NeutralSelection > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Button.NavButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="AutomationProperties.ItemStatus" Value="" />
  </Style>

  <Style Selector="Button.NavButton.active">
    <Setter Property="Background" Value="{DynamicResource ShellSidebarSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="AutomationProperties.ItemStatus" Value="Current page" />
  </Style>

  <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSidebarSelectionBrush}" />
  </Style>

  <Style Selector="Button.NavButton.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSidebarSelectionBrush}" />
  </Style>

  <Style Selector="Button.NavButton.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- The current route's icon carries the accent, as in the reference nav. -->
  <Style Selector="Button.NavButton.active icons|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- Chooser tiles sit on overlay surfaces and read as sunken cards, the
       same fill the workspace panels use — not as raised light controls. -->
  <Style Selector="Button.ChooserButton">
    <Setter Property="MinHeight" Value="116" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
  </Style>

  <Style Selector="Button.ChooserButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.ChooserButton.LauncherChooser">
    <Setter Property="MinHeight" Value="124" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="Button.ChooserButton.PanelChooser">
    <Setter Property="MinHeight" Value="110" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="Border.LayoutSlotBadge.orange">
    <Setter Property="Background" Value="#FF8400" />
  </Style>

  <Style Selector="Border.LayoutSlotBadge.blue">
    <Setter Property="Background" Value="#3B82F6" />
  </Style>

  <Style Selector="Border.LayoutSlotBadge.green">
    <Setter Property="Background" Value="#22C55E" />
  </Style>

  <Style Selector="Border.LayoutSlotBadge.pink">
    <Setter Property="Background" Value="#EC4899" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
  </Style>

  <!-- A ComboBox is macOS's popup *button*: it wears the control chrome, not a
       text field's inset well. Text entry keeps the darker inset. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ShellControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellControlBorderBrush}" />
  </Style>

  <!--
    Single-line inputs centre their text; without this the value sits against the
    top edge whenever the control is taller than its line height. These stay
    separate one-type selectors because a grouped selector resolves to
    TemplatedControl, which does not declare VerticalContentAlignment.
  -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox[AcceptsReturn=True]">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- The number field is one rounded surface. Its inner TextBox must not draw
       its own field chrome: a second rounded well inside the control leaves the
       stepper zone reading as a separate square block that pokes past the
       control's corner radius. -->
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="NumericUpDown /template/ TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- The focus halo belongs to the whole field, not to the inner text box. -->
  <Style Selector="NumericUpDown /template/ TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>

  <!-- The steppers are quiet glyphs inside the field, as the host draws them —
       not a pair of boxed push buttons whose square fills poke past the field's
       rounded corner. -->
  <Style Selector="ButtonSpinner /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="{DynamicResource ShellHairlineInset}" />
  </Style>

  <Style Selector="ButtonSpinner /template/ RepeatButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellInnerCornerRadius}" />
  </Style>

  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- The focused field carries the platform's accent halo, as macOS draws its
       focus ring. The shadow sits on the template border that owns the field's
       shape, so the halo follows the corner radius. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource ShellFocusRingShadow}" />
  </Style>

  <!--
    ComboBox sizes to its widest item by default, which leaves settings grids with
    ragged control widths that shift as the selection changes. Filling the cell
    keeps each column aligned; compact cases opt out with an explicit width.
  -->
  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <!--
      Option lists bind straight to enum values, so the default text is the
      identifier. A ComboBox that needs richer items sets its own ItemTemplate,
      which takes precedence over this one.
    -->
    <Setter Property="ItemTemplate">
      <DataTemplate>
        <TextBlock
            Text="{Binding Converter={StaticResource EnumDisplayConverter}}"
            TextTrimming="CharacterEllipsis" />
      </DataTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource ShellInsetXs}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="ComboBox:dropdownopen /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource ShellControlMinHeight}" />
    <Setter Property="Padding" Value="{controls:Inset Horizontal=Md, Vertical=Sm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>

  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <!-- Text beside an inner control needs a small optical inset: a control's
       stroke carries more visual weight than a bare glyph at the same x origin. -->
  <Style Selector="StackPanel.CardText">
    <Setter Property="Margin" Value="{controls:Inset Horizontal=Xs}" />
  </Style>

  <Style Selector="StackPanel.CardText TextBlock">
    <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight12}" />
  </Style>

  <!--
    The two label ranks, both sentence case in the host's own register. The old
    letterspaced-uppercase treatment made every settings page read like a rack
    of terminal status lines: hierarchy comes from size, weight, and tone —
    never from shouting.
  -->
  <Style Selector="TextBlock.SectionHeading">
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight11}" />
  </Style>

  <Style Selector="TextBlock.Eyebrow">
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize10}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    <Setter Property="LineHeight" Value="{DynamicResource ShellLineHeight10}" />
  </Style>

  <Style Selector="TextBlock.Eyebrow.Accent">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- An eyebrow that labels a region rather than a single value. Small caps
       tracked apart read as a heading at a size where sentence case reads as
       body text; the text itself is written capitalised so a screen reader is
       not spelling out letters. -->
  <Style Selector="TextBlock.Eyebrow.Caps">
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize9}" />
  </Style>

  <Style Selector="Border.TopChrome">
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    Route navigation is a contained surface, not a dividing wall. Keeping the
    geometry here makes Workspace, Home, Settings, and side-docked tabs read as
    one shell even though their contents differ.
  -->
  <Style Selector="Border.FloatingSidebar">
    <Setter Property="Margin" Value="{DynamicResource ShellInsetSm}" />
    <Setter Property="Background" Value="{DynamicResource ShellSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellSidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellSidebarCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Native title bars already leave space below their centred controls. -->
  <Style Selector="Border.FloatingSidebar.routeSidebar">
    <Setter Property="Margin" Value="{controls:Inset Horizontal=Sm, Bottom=Sm}" />
  </Style>

  <!-- The route's content panel: the same floating surface as the sidebar next
       to it, minus the left margin the sidebar's right margin already provides. -->
  <Style Selector="Border.FloatingSidebar.routeContent">
    <Setter Property="Margin" Value="{controls:Inset Right=Sm, Bottom=Sm}" />
  </Style>

  <!-- The workspace canvas already contributes the gutter on the facing edge.
       The top matches the canvas gutter, so the rails and the panels start on
       the same line rather than the rails riding a step higher. -->
  <Style Selector="Border.FloatingSidebar.workspaceLeft">
    <Setter Property="Margin" Value="{controls:Inset Left=Sm, Top=Sm, Bottom=Sm}" />
  </Style>

  <Style Selector="Border.FloatingSidebar.workspaceRight">
    <Setter Property="Margin" Value="{controls:Inset Right=Sm, Top=Sm, Bottom=Sm}" />
  </Style>

  <Style Selector="Button.RuntimeHomeTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <Style Selector="Button.RuntimeHomeTab.active">
    <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>

  <!--
    A runtime tab. The one you are in wears the accent, whole — a tint or an
    edge marker was not enough to find at a glance in a full strip, which is
    what "hard to tell what is active" meant. The accent is the open
    workspace's own, so the strip says which workspace you are in as well as
    which tab, without spending a word on either.
  -->
  <Style Selector="Button.RuntimeTabActivator">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Button.RuntimeTabActivator:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.RuntimeTabActivator.active">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
  </Style>

  <!-- The stock hover wash would take the accent back off the active tab, and
       hovering the tab you are already in should change nothing. -->
  <Style Selector="Button.RuntimeTabActivator.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- The reorder handle and the close button are the tab's siblings rather
       than its content, so they take the tab's own text colour from here. -->
  <Style Selector="Grid.RuntimeTabDropTarget">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <Style Selector="Grid.RuntimeTabDropTarget.active">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
  </Style>

  <!-- A button sets its own foreground, so inheriting it is not enough. -->
  <Style Selector="Grid.RuntimeTabDropTarget.active Button.IconButton">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
  </Style>

  <!--
    Launcher cards use the design's raised surface and 16px shape. The platform
    card radius stays reserved for window chrome and settings surfaces.
  -->

  <!--
    The card body is the primary target, so the whole surface activates. Secondary
    actions sit above it and reveal on hover or keyboard focus, which keeps the
    resting card as uncluttered as the design.
  -->
  <Style Selector="Button.CardSurface">
    <Setter Property="Padding" Value="{DynamicResource ShellCardPadding}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!--
    The card border owns the card's fill, so every Button visual state keeps its
    own presenter transparent. Without this the theme's disabled and rest
    backgrounds paint a lighter rectangle inside the card.
  -->
  <Style Selector="Button.CardSurface /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="Button.CardSurface:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.CardSurface:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.CardSurface:disabled">
    <Setter Property="Opacity" Value="0.62" />
  </Style>

  <!--
    A launch card reveals its actions on hover or focus. This is the one card
    behaviour the surface component does not model, because it is a statement
    about the content rather than about the surface.

    The ancestor is qualified by class, not left as the bare card. A descendant
    selector is re-matched up the tree whenever anything it could match changes
    state, so leaving it as every SurfaceCard put a tree walk behind every pointer
    move over any of the 195 of them — which is what made hovering lag.
  -->
  <Style Selector="controls|SurfaceCard.LaunchCard:pointerover StackPanel.CardActions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|SurfaceCard.LaunchCard:focus-within StackPanel.CardActions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="StackPanel.CardActions">
    <Setter Property="IsVisible" Value="False" />
  </Style>



  <!-- Neutral kind/protocol badge: SSH, Local, Docker, WSL. -->


  <!-- Free-form connection tag. -->


  <!-- Connection liveness/availability indicator. -->
  <Style Selector="Border.StatusDot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <Style Selector="Border.StatusDot.available">
    <Setter Property="Background" Value="{DynamicResource ShellSuccessBrush}" />
  </Style>


  <!--
    A single setting on the raised surface. Settings pages group these under a
    section heading rather than stacking every control in one long card, which is
    how the reference composes its preference screens.
  -->

  <!--
    A preset tile that is itself the choice: the preview is the control, not a
    decoration sitting above a separate drop-down. The default radio bullet is
    replaced by the card's own selected border, as in the reference.
  -->
  <Style Selector="RadioButton.PresetCard">
    <Setter Property="Width" Value="212" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            Name="PresetRoot"
            Background="{DynamicResource ShellSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellCardCornerRadius}"
            Padding="{TemplateBinding Padding}">
          <ContentPresenter
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.PresetCard:pointerover /template/ Border#PresetRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <Style Selector="RadioButton.PresetCard:checked /template/ Border#PresetRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="RadioButton.PresetCard:focus-visible /template/ Border#PresetRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- The name turns accent on the selected tile, and its check appears. -->
  <Style Selector="RadioButton.PresetCard TextBlock.PresetName">
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="RadioButton.PresetCard:checked TextBlock.PresetName">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="RadioButton.PresetCard icons|SymbolIcon.PresetCheck">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="RadioButton.PresetCard:checked icons|SymbolIcon.PresetCheck">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- The picker presents itself as the swatch it edits. -->
  <!-- A workspace accent preset: the colour is the whole control, so it is a
       circle with no text and its selected state is a ring rather than a fill,
       which would be invisible against the colour itself. -->
  <Style Selector="Button.AccentSwatch">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.AccentSwatch:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
  </Style>
  <Style Selector="Button.AccentSwatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellTextBrush}" />
  </Style>

  <!-- One tile in the workspace icon grid. -->
  <Style Selector="Button.IconChoice">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>
  <Style Selector="Button.IconChoice:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.IconChoice.selected">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <!-- A centred empty state. A StackPanel is only as wide as its widest child, so
       a long wrapped sentence sets the width and every shorter child — heading,
       icon, action — left-aligns against it unless it is centred too. -->

  <!-- The switch is the state. Avalonia's default On/Off labels duplicate the
       status text these rows already carry, and Fluent's geometry — hollow off
       track, undersized knob — is not the host's. This is the macOS switch: a
       38 × 22 filled track whose white knob slides between its 2 DIP insets,
       accent when on, control-surface gray when off, focus halo on keyboard
       focus. Toggling is ToggleButton behavior, so the template stays purely
       presentational. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            Name="SwitchTrack"
            Width="38"
            Height="22"
            Padding="{DynamicResource ShellHairlineInset}"
            Background="{DynamicResource ShellControlSurfaceBrush}"
            CornerRadius="{DynamicResource ShellPillCornerRadius}">
          <Panel>
            <!-- The control demands its knob-slide parts, but it positions them
                 only on state transitions, which leaves the initial render
                 wrong. The parts stay as inert stubs; the visible knob is
                 placed by the :checked styles, so every render is correct. -->
            <Panel Name="PART_SwitchKnob" Width="0" Height="0" IsVisible="False">
              <Panel Name="PART_MovingKnobs" />
            </Panel>
            <Ellipse
                Name="SwitchKnob"
                Width="18"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Fill="White" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource ShellControlHoverBrush}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnob">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="ToggleSwitch:focus-visible /template/ Border#SwitchTrack">
    <Setter Property="BoxShadow" Value="{DynamicResource ShellFocusRingShadow}" />
  </Style>

  <Style Selector="ToggleSwitch:disabled /template/ Border#SwitchTrack">
    <Setter Property="Opacity" Value="0.48" />
  </Style>

  <!-- Expanders sit inside cards that already carry a surface and a border, so
       the Fluent default's own filled, bordered chrome reads as a second card
       nested in the first. The header keeps its affordance; the box goes. -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- The header toggle and the content host are named differently across
       Avalonia's themes, so both are matched by type rather than by part name. -->
  <Style Selector="Expander /template/ ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton:checked">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- A colour well, as the host draws one: the colour fills the whole control
       inside a hairline frame, and pressing it opens the picker. The stock
       template splits the control into a half-width preview beside a gray
       drop-down zone, which reads as two unrelated controls. -->
  <Style Selector="ColorPicker.Swatch">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <!-- The stock theme's 64 DIP minimum would beat the width above and leave
         an invisible dead zone beside the well. -->
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="Content">
      <Template>
        <Border
            Margin="{DynamicResource ShellHairlineInset}"
            Background="{Binding $parent[ColorPicker].Color, Converter={StaticResource ColorBrushConverter}}"
            CornerRadius="{DynamicResource ShellInnerCornerRadius}" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="ColorPicker.Swatch /template/ DropDownButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ShellControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The same picker cut as a circle, for the end of a row of round presets:
       a rounded rectangle there reads as a different kind of control rather
       than as one more colour to choose. -->
  <Style Selector="ColorPicker.Swatch.Round">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Content">
      <Template>
        <Border
            Margin="{DynamicResource ShellHairlineInset}"
            Background="{Binding $parent[ColorPicker].Color, Converter={StaticResource ColorBrushConverter}}"
            CornerRadius="{DynamicResource ShellPillCornerRadius}" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="ColorPicker.Swatch.Round /template/ DropDownButton">
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="ColorPicker.Swatch /template/ DropDownButton /template/ PathIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Colour swatch shown beside the hex value it renders. -->
  <Style Selector="Border.Swatch">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.Swatch.Ansi">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellInnerCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!--
    Segmented picker: one visible group of mutually exclusive options, used where
    the reference shows a inline choice rather than a drop-down.
  -->
  <Style Selector="Border.Segmented">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
    <Setter Property="Padding" Value="3" />
    <!-- The track owns the shape, so a segment can never paint outside it. -->
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!--
    An explicit template rather than the theme's ToggleButton visuals: the
    segments have to tile the track exactly, and a themed button brings its own
    padding, border, and corner geometry that overflows a 3px inset track.
  -->
  <Style Selector="ToggleButton.Segment">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize11}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            Name="SegmentRoot"
            Background="Transparent"
            CornerRadius="{DynamicResource ShellControlCornerRadius}"
            Padding="{TemplateBinding Padding}">
          <ContentPresenter
              Content="{TemplateBinding Content}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.Segment:pointerover /template/ Border#SegmentRoot">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="ToggleButton.Segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.Segment:checked /template/ Border#SegmentRoot">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.Segment:focus-visible /template/ Border#SegmentRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Sliders track the accent so a value reads at a glance. -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Slider /template/ Track#PART_Track RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="Slider /template/ Track#PART_Track RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>




  <!--
    "Nothing here yet" is not a notice. Empty states stay on the neutral surface
    so the accent tint keeps meaning "read this", and a page of empty sections
    does not look like a page of warnings.
  -->





  <!-- The card owns the rounded shape, so its content is clipped to it. Without
       this the header and the terminal square off the corners the border draws
       round. -->


  <!-- Square, because the card clips it. A literal radius here also disagreed
       with the card's own once the corner-radius setting could change it. -->
  <Style Selector="Border.PanelHeader">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- The agent panel is a panel like any other: it shares the workspaces-panel
       surface so cards and messages float on it. -->
  <Style Selector="Border.AgentPanel">
    <Setter Property="Background" Value="{DynamicResource ShellSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellSidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellCardCornerRadius}" />
  </Style>

  <Style Selector="Border.IconTile">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Border.IconTile.Neutral">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <!--
    List rows are separated by a leading rule so a list never draws a divider
    against its container's own rounded bottom edge.
  -->
  <Style Selector="Button.ListRow">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.ListRow:nth-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.ChooserIconTile">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Border.ScreenPreviewPanel">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Border.ScreenPreviewPanel.primary">
    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--
    A keycap sits beside text, so it sizes to its own content. Without this it
    stretches to the line height of whatever it is next to and a one-character
    label renders as a tall lozenge.
  -->
  <Style Selector="Border.Keycap">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellControlCornerRadius}" />
  </Style>

  <Style Selector="Border.Keycap TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource ShellFontSize9}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <!--
    A chip is a setting that reads as status: it names the value in place and only
    becomes a control when it is pressed. The agent panel's footer uses them for the
    model and the run scope, which belong beside the conversation rather than in a
    labelled form above it, where they competed with the panel's own heading.
  -->
  <Style Selector="Button.Chip, ComboBox.Chip">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontSize" Value="{DynamicResource ShellPillFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
  </Style>

  <Style Selector="Button.Chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
  </Style>






</Styles>
