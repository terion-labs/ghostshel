<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GhostShell.Application\GhostShell.Application.csproj" />
    <ProjectReference Include="..\GhostShell.Core\GhostShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.1" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Inpc" Version="12.0.0.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhostShell.Docking\GhostShell.Docking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GhostShell.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <GhostShellTerminalFontDirectory>$(MSBuildThisFileDirectory)../../native/artifacts/common/fonts/JetBrainsMono</GhostShellTerminalFontDirectory>
  </PropertyGroup>

  <ItemGroup>
    <GhostShellTerminalFontFile Include="$(GhostShellTerminalFontDirectory)/JetBrainsMono-Regular.ttf" />
    <GhostShellTerminalFontFile Include="$(GhostShellTerminalFontDirectory)/JetBrainsMono-Bold.ttf" />
    <GhostShellTerminalFontFile Include="$(GhostShellTerminalFontDirectory)/JetBrainsMono-Italic.ttf" />
    <GhostShellTerminalFontFile Include="$(GhostShellTerminalFontDirectory)/JetBrainsMono-BoldItalic.ttf" />
    <GhostShellTerminalFontLicenseFile Include="$(GhostShellTerminalFontDirectory)/OFL.txt" />
    <AvaloniaResource
        Include="@(GhostShellTerminalFontFile)"
        Link="Assets/Fonts/JetBrainsMono/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target
      Name="ValidateGhostShellTerminalFonts"
      BeforeTargets="PrepareForBuild"
      Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
        Condition="!Exists('%(GhostShellTerminalFontFile.Identity)')"
        Text="The bundled terminal font '%(GhostShellTerminalFontFile.Filename)%(GhostShellTerminalFontFile.Extension)' is missing. Run scripts/build-terminal-font-assets.sh before building GhostShell.App." />
    <Error
        Condition="!Exists('%(GhostShellTerminalFontLicenseFile.Identity)')"
        Text="The bundled terminal font license is missing. Run scripts/build-terminal-font-assets.sh before building GhostShell.App." />
  </Target>

</Project>
