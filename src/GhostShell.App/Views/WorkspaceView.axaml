<UserControl
    x:Class="GhostShell.App.Views.WorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="using:Dock.Avalonia.Controls"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:views="using:GhostShell.App.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <Grid RowDefinitions="Auto,34,*,Auto,26">
    <Border
        Classes="TopChrome"
        MinHeight="{Binding $parent[Window].TitleBarChromeHeight}"
        PointerPressed="OnTitleBarPointerPressed"
        WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Margin="{Binding $parent[Window].WindowTitleBarContentMargin}" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <components:RuntimeTabStripView
            x:Name="RuntimeTabStrip"
            Tabs="{Binding RuntimeWorkspace.Tabs}"
            Orientation="Horizontal"
            ShowHomeTab="True"
            ShowHistoryTab="True"
            RecentSessions="{Binding RecentSessions}"
            IsHomeActive="False"
            IsVisible="{Binding IsTabStripVisibleOnTop}"
            WindowDecorationProperties.ElementRole="User"
            AutomationProperties.Name="Open runtime tabs"
            AddTabRequested="OnShowNewItemClick"
            HomeRequested="OnShowLauncherClick"
            RecentSessionRequested="OnOpenRecentSessionClick"
            ActivateRequested="OnActivateTabClick"
            CloseRequested="OnCloseRuntimeTabClick"
            TabDragEnter="OnRuntimeTabDragEnter"
            TabDragLeave="OnRuntimeTabDragLeave"
            TabDragOver="OnRuntimeTabDragOver"
            TabDrop="OnRuntimeTabDrop"
            ReorderPointerCaptureLost="OnRuntimeTabDragPointerCaptureLost"
            ReorderPointerMoved="OnRuntimeTabDragPointerMoved"
            ReorderPointerPressed="OnRuntimeTabDragPointerPressed"
            ReorderPointerReleased="OnRuntimeTabDragPointerReleased" />
        <StackPanel
            x:Name="WorkspaceTitleBarActions"
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="{DynamicResource ShellSpaceXs}"
            WindowDecorationProperties.ElementRole="User">
          <!--
            Where before what. The plus asks which edge the panel goes against, and
            the panel itself then asks what to open — rather than a modal asking
            what to open and the layout deciding where it lands.
          -->
          <Button Classes="IconButton" ToolTip.Tip="Add panel" AutomationProperties.Name="Add panel">
            <icons:SymbolIcon Symbol="Add" FontSize="15" />
            <Button.Flyout>
              <MenuFlyout Placement="Bottom">
                <MenuItem Click="OnAddPanelLeftClick" Header="Add to the left" />
                <MenuItem Click="OnAddPanelRightClick" Header="Add to the right" />
                <MenuItem Click="OnAddPanelTopClick" Header="Add above" />
                <MenuItem Click="OnAddPanelBottomClick" Header="Add below" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="IconButton" Click="OnToggleAgentClick" ToolTip.Tip="Toggle agent panel" AutomationProperties.Name="Toggle AI agent panel"><icons:SymbolIcon Symbol="Bot" FontSize="15" /></Button>
          <Button Classes="IconButton" Click="OnShowSettingsClick" ToolTip.Tip="Settings" AutomationProperties.Name="Open settings"><icons:SymbolIcon Symbol="Settings" FontSize="15" /></Button>
          <Button Classes="IconButton" Click="OnLockShellClick" ToolTip.Tip="Lock GhostSHELL" AutomationProperties.Name="Lock GhostSHELL" IsVisible="{Binding ApplicationSecurityEditor.IsProtectionEnabled}"><icons:SymbolIcon Symbol="LockClosed" FontSize="15" /></Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- No fill of its own: this band is part of the base surface, and painting
         it opaque would have punched a solid stripe through the backdrop. -->
    <Border Grid.Row="1">
      <Grid ColumnDefinitions="*,Auto" Margin="{controls:Inset Horizontal=Sm}" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <!-- Centred, not stretched: a pill left to fill the row's full height has
             its rounded corners meet the row edges, which reads as corners cut
             off rather than as a pill. -->
        <ScrollViewer
            ClipToBounds="False"
            VerticalAlignment="Center"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
          <!-- The scroll viewport clips antialiased strokes even when the child
               opts out of clipping. Keep the pills inside the viewport with real
               internal clearance instead of trying to move each pill afterward. -->
          <Border
              x:Name="SavedConnectionStripViewport"
              ClipToBounds="False"
              Padding="{DynamicResource ShellSavedConnectionStripPadding}">
            <ItemsControl ClipToBounds="False" ItemsSource="{Binding SavedConnectionShortcuts}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <components:SavedConnectionShortcutView LaunchRequested="OnSavedConnectionLaunchRequested" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </ScrollViewer>
        <Button Grid.Column="1" Classes="TextButton" Click="OnShowCommandPaletteClick" Content="{Binding CommandPaletteAction}" />
      </Grid>
    </Border>

    <Border
        Grid.Row="3"
        Height="30"
        Background="Transparent"
        BorderBrush="{DynamicResource ShellBorderBrush}"
        BorderThickness="0,1,0,0"
        IsVisible="{Binding IsTabStripVisibleOnBottom}">
      <components:RuntimeTabStripView
          x:Name="RuntimeTabStripBottom"
          Margin="{controls:Inset Horizontal=Md}"
          Tabs="{Binding RuntimeWorkspace.Tabs}"
          Orientation="Horizontal"
          AutomationProperties.Name="Open runtime tabs"
          AddTabRequested="OnShowNewItemClick"
          ActivateRequested="OnActivateTabClick"
            CloseRequested="OnCloseRuntimeTabClick"
            TabDragEnter="OnRuntimeTabDragEnter"
            TabDragLeave="OnRuntimeTabDragLeave"
            TabDragOver="OnRuntimeTabDragOver"
            TabDrop="OnRuntimeTabDrop"
            ReorderPointerCaptureLost="OnRuntimeTabDragPointerCaptureLost"
            ReorderPointerMoved="OnRuntimeTabDragPointerMoved"
            ReorderPointerPressed="OnRuntimeTabDragPointerPressed"
            ReorderPointerReleased="OnRuntimeTabDragPointerReleased" />
    </Border>

    <DockPanel Grid.Row="2" LastChildFill="True">
      <!-- A tile opens sideways out of the rail when it offers to close its
           workspace, so this one sidebar does not clip its content and draws
           above the canvas it opens over. Widening the rail instead would move
           every panel beside it on a hover. -->
      <Border
          Width="{DynamicResource ShellRailWidth}"
          ZIndex="1"
          ClipToBounds="False"
          Classes="FloatingSidebar"
          controls:Concentric.IsEnabled="True"
          Classes.workspaceLeft="{Binding IsWorkspacePanelOnLeft}"
          Classes.workspaceRight="{Binding IsWorkspacePanelOnRight}"
          DockPanel.Dock="{Binding WorkspacePanelDock}"
          IsVisible="{Binding ShowWorkspacesPanel}">
        <!-- The add button belongs under the last workspace, not pinned to the
             far end of the rail: with two workspaces it was stranded most of a
             screen below them, reading as an unrelated control. -->
        <!-- The rail is measured from this inset — a tile plus it on either
             side, plus the border — so the same gap can go all the way round
             instead of being squeezed sideways to fit a width written down
             elsewhere. -->
        <StackPanel ClipToBounds="False" Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceSm}">
          <ItemsControl ClipToBounds="False" ItemsSource="{Binding Workspaces}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel ClipToBounds="False" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- Center, not the Stretch default: a fixed-width child of a
                     vertical StackPanel is start-aligned, which pushed every
                     tile against the rail's left edge. -->
                <controls:WorkspaceRailTile
                    Margin="{controls:Inset Bottom=Sm}"
                    HorizontalAlignment="Center"
                    Accent="{Binding Accent}"
                    Icon="{Binding IconSymbol}"
                    IsRunning="{Binding IsOpen}"
                    IsCurrent="{Binding IsInFront}"
                    HasAttention="{Binding HasAttention}"
                    CanClose="{Binding CanClose}"
                    ExpandsLeft="{Binding $parent[ItemsControl].DataContext.IsWorkspacePanelOnRight}"
                    OpenRequested="OnOpenWorkspaceClick"
                    CloseRequested="OnCloseWorkspaceClick"
                    ToolTip.Tip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- A ghost tile, not a push button: the rail's add affordance sits
               beside filled workspace tiles and must read as an empty slot. -->
          <Button
              Width="{DynamicResource ShellTileSizeMd}"
              Height="{DynamicResource ShellTileSizeMd}"
              MinWidth="{DynamicResource ShellTileSizeMd}"
              MinHeight="{DynamicResource ShellTileSizeMd}"
              HorizontalAlignment="Center"
              Padding="0"
              Background="Transparent"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              Foreground="{DynamicResource ShellMutedBrush}"
              Click="OnShowNewItemClick"
              ToolTip.Tip="New tab"
              AutomationProperties.Name="Create a new tab">
            <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Add" FontSize="14" />
          </Button>
        </StackPanel>
      </Border>

      <Border
          Width="190"
          Classes="FloatingSidebar"
          controls:Concentric.IsEnabled="True"
          Padding="{controls:Inset Horizontal=Xs, Vertical=Sm}"
          DockPanel.Dock="{Binding TabStripDock}"
          IsVisible="{Binding IsTabStripVisibleOnSide}">
        <components:RuntimeTabStripView
            x:Name="RuntimeTabStripSide"
            Tabs="{Binding RuntimeWorkspace.Tabs}"
            Orientation="Vertical"
            AutomationProperties.Name="Open runtime tabs"
            AddTabRequested="OnShowNewItemClick"
            ActivateRequested="OnActivateTabClick"
            CloseRequested="OnCloseRuntimeTabClick"
            TabDragEnter="OnRuntimeTabDragEnter"
            TabDragLeave="OnRuntimeTabDragLeave"
            TabDragOver="OnRuntimeTabDragOver"
            TabDrop="OnRuntimeTabDrop"
            ReorderPointerCaptureLost="OnRuntimeTabDragPointerCaptureLost"
            ReorderPointerMoved="OnRuntimeTabDragPointerMoved"
            ReorderPointerPressed="OnRuntimeTabDragPointerPressed"
            ReorderPointerReleased="OnRuntimeTabDragPointerReleased" />
      </Border>

      <views:AgentWorkspaceView
          x:Name="AgentWorkspaceSurface"
          DockPanel.Dock="Right"
          Width="352"
          Margin="{controls:Inset Right=Sm, Top=Sm, Bottom=Sm}"
          AgentQuestionResponseKeyDownRequested="OnAgentQuestionResponseKeyDown"
          ApproveAgentActionRequested="OnApproveAgentActionClick"
          CancelAgentActionRequested="OnCancelAgentActionClick"
          CancelAgentChatRequested="OnCancelAgentChatClick"
          ClearAgentChatRequested="OnClearAgentChatClick"
          DeclineAgentQuestionRequested="OnDeclineAgentQuestionClick"
          DenyAgentActionRequested="OnDenyAgentActionClick"
          DisableAgentYoloRequested="OnDisableAgentYoloClick"
          EnableAgentCapabilityAskRequested="OnEnableAgentCapabilityAskClick"
          EnableAgentYoloRequested="OnEnableAgentYoloClick"
          IsVisible="{Binding IsAgentPanelVisible}"
          KeepAgentCapabilityOffRequested="OnKeepAgentCapabilityOffClick"
          LoadOlderAgentAuditRequested="OnLoadOlderAgentAuditClick"
          RefreshAgentAuditRequested="OnRefreshAgentAuditClick"
          SendAgentChatRequested="OnSendAgentChatClick"
          ShowAgentSettingsRequested="OnShowAgentSettingsClick"
          SubmitAgentQuestionRequested="OnSubmitAgentQuestionClick" />

      <!-- The canvas gutter matches the splitter step, so a panel's distance to
           the rail, to the agent panel, and to its neighbour panel all read as
           the same gap. -->
      <Grid
          Margin="{controls:Inset Sm}"
          IsVisible="{Binding IsWorkspaceCanvasVisible}">
        <!-- One canvas per open workspace, and switching shows a different
             one rather than rebuilding the only one.

             A dock control does not swap layouts in place: measured across a
             switch it holds the outgoing tree through the next layout pass,
             drops to bare chrome after the frame, and builds the incoming one
             later still — and that bare state is a visible blink. It also will
             not build a layout while it is not the canvas being shown, so
             there is no preparing one off to the side either. Each workspace
             keeps its own, built once while it is in front and kept
             afterwards, so coming back to it is a change of which one is
             visible and nothing else. -->
        <ItemsControl ItemsSource="{Binding OpenWorkspaces}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Panel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
        <dock:DockControl
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="{Binding IsCanvasShown}"
            ZIndex="{Binding CanvasDepth}"
            Layout="{Binding ActiveTab.DockLayout}"
            Factory="{Binding ActiveTab.DockFactory}"
            IsDockingEnabled="{Binding $parent[ItemsControl].DataContext.IsLayoutDesignerVisible, Converter={x:Static BoolConverters.Not}}"
            Loaded="OnRuntimeDockControlLoaded"
            InitializeFactory="True"
            InitializeLayout="False">
          <dock:DockControl.Styles>
            <!-- Keep the drag ghost compact. Dock's stock preview can render a
                 second full document surface, which is misleading for the
                 one-panel-per-leaf workspace model. -->
            <Style Selector="dock|DragPreviewControl">
              <Setter Property="Template">
                <ControlTemplate>
                  <Border
                      MinWidth="132"
                      Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
                      Background="{DynamicResource ShellSurfaceElevatedBrush}"
                      BorderBrush="{DynamicResource ShellAccentBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource ShellControlCornerRadius}"
                      BoxShadow="{DynamicResource ShellOverlayShadow}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Text="{Binding Title}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Classes="Muted"
                          FontSize="{DynamicResource ShellFontSize9}"
                          Text="{TemplateBinding Status}" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>
          </dock:DockControl.Styles>
        </dock:DockControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding !HasRuntimeWorkspace}">
          <TextBlock Classes="Muted" Text="Open a workspace from the launcher." />
          <Button Classes="PrimaryButton" Click="OnShowLauncherClick" Content="Open launcher" />
        </StackPanel>
      </Grid>
    </DockPanel>

    <!-- The status band is the base surface, so it paints nothing and lets the
         window's own fill through rather than laying a second coat over it. -->
    <Border Grid.Row="4" Background="Transparent" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}" Margin="{controls:Inset Horizontal=Sm}">
        <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding RuntimeWorkspace.ActiveTab.Source}" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding WorkspaceStatus}" />
        <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize9}"
            Text="{Binding TabReorderStatus}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding TabReorderStatus, StringFormat={}Tab order status · {0}}" />
        <Button
            x:Name="FileTransferManagerButton"
            Grid.Column="3"
            VerticalAlignment="Center"
            Padding="{controls:Inset Horizontal=Xs}"
            MinHeight="20"
            Classes="TextButton"
            Click="OnToggleFileTransferManagerClick"
            IsVisible="{Binding HasFileTransfers}"
            AutomationProperties.Name="Open transfer manager">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
            <icons:SymbolIcon
                VerticalAlignment="Center"
                Symbol="ArrowSort"
                FontSize="10"
                Foreground="{DynamicResource ShellAccentBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource ShellFontSize9}"
                FontWeight="Medium"
                Text="{Binding FileTransferStatusText}"
                AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- This is deliberately an in-window overlay, not a Flyout. Platform
         popups own a separate surface and can extend beyond custom window
         chrome; transfer progress must remain bounded by the workspace. -->
    <controls:SurfaceCard
        x:Name="FileTransferManager"
        Grid.Row="2"
        ZIndex="100"
        Width="440"
        MaxHeight="400"
        Margin="{controls:Inset Right=Sm, Bottom=Sm}"
        Padding="{controls:Inset Md}"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Elevation="Overlay"
        ClipsContent="True"
        IsVisible="False"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="File transfer manager">
      <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <StackPanel MinWidth="0" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="File transfers" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="Transfers stream through this computer between file providers."
                TextWrapping="Wrap" />
          </StackPanel>
          <controls:StatusChip
              Grid.Column="1"
              VerticalAlignment="Center"
              Content="{Binding FileTransferStatusText}" />
          <Button
              x:Name="FileTransferManagerCloseButton"
              Grid.Column="2"
              Classes="IconButton"
              Click="OnToggleFileTransferManagerClick"
              ToolTip.Tip="Close transfer manager"
              AutomationProperties.Name="Close transfer manager">
            <icons:SymbolIcon Symbol="Dismiss" FontSize="11" />
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" MaxHeight="310" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding FileTransfers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                    Padding="{controls:Inset Vertical=Sm}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="0,0,0,1">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel MinWidth="0" Spacing="{DynamicResource ShellSpaceXs}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock FontSize="{DynamicResource ShellFontSize9}" FontWeight="SemiBold" Text="{Binding Operation}" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Stage}" />
                      </StackPanel>
                      <TextBlock FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                        <icons:SymbolIcon Symbol="ArrowRight" FontSize="9" Foreground="{DynamicResource ShellMutedBrush}" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                      <controls:StatusChip Content="{Binding State}" />
                      <Button Classes="IconButton" Click="OnCancelFileTransferClick" IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel transfer" AutomationProperties.Name="Cancel file transfer"><icons:SymbolIcon Symbol="Dismiss" FontSize="11" /></Button>
                      <Button Classes="IconButton" Click="OnRetryFileTransferClick" IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry transfer" AutomationProperties.Name="Retry file transfer"><icons:SymbolIcon Symbol="ArrowClockwise" FontSize="11" /></Button>
                    </StackPanel>
                    <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Height="2"
                        Margin="{controls:Inset Top=Sm}"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding ProgressPercent}"
                        IsIndeterminate="{Binding !HasKnownProgress}"
                        IsVisible="{Binding IsActive}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="{controls:Inset Top=Xs}"
                        Foreground="{DynamicResource ShellDangerBrush}"
                        FontSize="{DynamicResource ShellFontSize9}"
                        Text="{Binding Error}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasError}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </controls:SurfaceCard>
  </Grid>
</UserControl>
