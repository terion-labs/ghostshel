<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.UnavailableRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <Border
      Classes="PanelCard"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,*">
      <Border Classes="PanelHeader">
        <Grid ColumnDefinitions="*,Auto" Margin="11,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="Eyebrow" Text="{Binding KindLabel}" />
            <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding IsZoomed}" Text="ZOOMED" />
          </StackPanel>
          <Button
              Grid.Column="1"
              Classes="IconButton"
              Click="OnCloseClick"
              ToolTip.Tip="Close panel"
              AutomationProperties.Name="Close panel">
            <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" MaxWidth="460" Margin="34" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <icons:SymbolIcon Symbol="Warning" FontSize="28" Foreground="#D79B57" />
        <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="Adapter unavailable" TextAlignment="Center" />
        <TextBlock Classes="Muted" Text="{Binding CapabilityMessage}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
