<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.BrowserRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <!--
    Navigation is the browser's own header content; the card, the title, the drag
    handle, and split/split/close come from the panel component. They used to be
    declared here too, and two of the three were unreachable: the split buttons
    carried no Grid.Column, so they rendered on top of the status dot.
  -->
  <controls:PanelChrome
      CloseLabel="Close browser panel"
      CloseRequested="OnCloseClick"
      IsActive="{Binding IsActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding Title}">
    <controls:PanelChrome.Status>
      <Ellipse
          Width="7"
          Height="7"
          Fill="{Binding StatusBrush, ElementName=RuntimeBrowser}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.HeaderContent>
      <Grid
          ColumnDefinitions="Auto,Auto,*,Auto"
          ColumnSpacing="{DynamicResource ShellSpaceXs}">
        <Button
            AutomationProperties.Name="Go back"
            Classes="IconButton"
            Click="OnBackClick"
            IsEnabled="{Binding CanGoBack, ElementName=RuntimeBrowser}"
            ToolTip.Tip="Back">
          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowLeft" />
        </Button>
        <Button
            Grid.Column="1"
            AutomationProperties.Name="Go forward"
            Classes="IconButton"
            Click="OnForwardClick"
            IsEnabled="{Binding CanGoForward, ElementName=RuntimeBrowser}"
            ToolTip.Tip="Forward">
          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowRight" />
        </Button>
        <TextBox
            x:Name="AddressBox"
            Grid.Column="2"
            VerticalAlignment="Center"
            AutomationProperties.Name="Browser address"
            FontSize="{DynamicResource ShellFontSize10}"
            GotFocus="OnAddressGotFocus"
            IsEnabled="{Binding IsLive, ElementName=RuntimeBrowser}"
            KeyDown="OnAddressKeyDown"
            LostFocus="OnAddressLostFocus"
            PlaceholderText="about:blank"
            Text="{Binding AddressText, ElementName=RuntimeBrowser, Mode=TwoWay}" />
        <Button
            Grid.Column="3"
            AutomationProperties.Name="Reload page"
            Classes="IconButton"
            Click="OnReloadClick"
            IsEnabled="{Binding IsLive, ElementName=RuntimeBrowser}"
            IsVisible="{Binding !IsLoading, ElementName=RuntimeBrowser}"
            ToolTip.Tip="Reload">
          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="ArrowClockwise" />
        </Button>
        <Button
            Grid.Column="3"
            AutomationProperties.Name="Stop loading page"
            Classes="IconButton"
            Click="OnStopClick"
            IsVisible="{Binding IsLoading, ElementName=RuntimeBrowser}"
            ToolTip.Tip="Stop loading">
          <icons:SymbolIcon FontSize="{DynamicResource ShellFontSize13}" Symbol="Dismiss" />
        </Button>
      </Grid>
    </controls:PanelChrome.HeaderContent>

    <controls:PanelChrome.Actions>
      <TextBlock
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="Browser session status"
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding StatusText, ElementName=RuntimeBrowser}"
          TextTrimming="CharacterEllipsis" />
    </controls:PanelChrome.Actions>

    <Grid>
      <controls:BrowserPresentationHost
          x:Name="RuntimeBrowser"
          Margin="1"
          BrowserStateChanged="OnBrowserStateChanged"
          ClientId="{Binding ClientId}"
          RendererView="{Binding RendererView}"
          SessionClient="{Binding SessionClient}"
          SessionRequest="{Binding SessionRequest}" />
      <!--
        What the panel is, for the moment it cannot show what it holds. A native
        view is composited above everything the shell draws, so while the dock
        needs its placement targets seen the page steps aside — and an empty
        rectangle mid-drag reads as a panel that has broken rather than one that
        is being moved.
      -->
      <Border
          Margin="1"
          Padding="{controls:Inset Xl}"
          Background="{DynamicResource ShellBackgroundBrush}"
          IsHitTestVisible="False"
          IsVisible="{Binding IsSurfaceSuspended, ElementName=RuntimeBrowser}">
        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon
              FontSize="24"
              Foreground="{DynamicResource ShellMutedBrush}"
              Symbol="Globe" />
          <TextBlock
              FontSize="{DynamicResource ShellFontSize11}"
              FontWeight="SemiBold"
              Text="{Binding Title}"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding AddressText, ElementName=RuntimeBrowser}"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border
          Margin="1"
          Padding="{controls:Inset Xl}"
          Background="{DynamicResource ShellBackgroundBrush}"
          IsHitTestVisible="False"
          IsVisible="{Binding ShowFallback, ElementName=RuntimeBrowser}">
        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon
              FontSize="24"
              Foreground="{DynamicResource ShellMutedBrush}"
              Symbol="Globe" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize11}"
              Text="{Binding StatusMessage, ElementName=RuntimeBrowser}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </controls:PanelChrome>
</UserControl>
