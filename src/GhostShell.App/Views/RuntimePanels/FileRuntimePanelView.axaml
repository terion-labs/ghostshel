<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.FileRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <controls:SurfaceCard Tone="Sunken" ClipsContent="True" Padding="0"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,46,34,*,25">
      <Border Classes="PanelHeader">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" Margin="{controls:Inset Horizontal=Md}">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ShellSuccessBrush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
            <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="Eyebrow" Text="{Binding KindLabel}" />
            <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding IsZoomed}" Text="ZOOMED" />
          </StackPanel>
          <StackPanel
              Grid.Column="2"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceXs}">
            <Button
                AutomationProperties.Name="Split this panel left and right"
                Classes="IconButton"
                Click="OnSplitLeftRightClick"
                ToolTip.Tip="Split left/right">
              <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
            </Button>
            <Button
                AutomationProperties.Name="Split this panel top and bottom"
                Classes="IconButton"
                Click="OnSplitTopBottomClick"
                ToolTip.Tip="Split top/bottom">
              <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
            </Button>
            <Button Classes="IconButton" Click="OnCloseClick" ToolTip.Tip="Close File Viewer" AutomationProperties.Name="Close File Viewer panel">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="150,Auto,Auto,2*,150,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
          <ComboBox
              ItemsSource="{Binding Profiles}"
              SelectedItem="{Binding SelectedProfile, Mode=OneWay}"
              IsEnabled="{Binding CanSelectProfile}"
              SelectionChanged="OnProfileSelectionChanged"
              AutomationProperties.Name="File provider profile">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Classes="IconButton Large" Click="OnNavigateUpClick" IsEnabled="{Binding CanNavigateUp}" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder">
            <icons:SymbolIcon Symbol="ArrowUp" FontSize="14" />
          </Button>
          <Button Grid.Column="2" Classes="IconButton Large" Click="OnRefreshClick" ToolTip.Tip="Refresh location" AutomationProperties.Name="Refresh files">
            <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
          </Button>
          <TextBox Grid.Column="3" Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding LocationText}" IsEnabled="{Binding CanEditLocation}" KeyDown="OnLocationKeyDown" AutomationProperties.Name="Editable file location" />
          <TextBox Grid.Column="4" Text="{Binding Filter}" PlaceholderText="Filter items" AutomationProperties.Name="Filter file items" />
          <CheckBox Grid.Column="5" VerticalAlignment="Center" IsChecked="{Binding ShowHidden}" Content="Hidden" />
          <Button Grid.Column="6" Classes="SecondaryButton" Click="OnTransferClick" IsEnabled="{Binding CanTransfer}" Content="Transfer" />
          <Button Grid.Column="7" Classes="SecondaryButton" Click="OnCreateFolderClick" IsEnabled="{Binding CanCreateFolder}" Content="New folder" />
          <Button Grid.Column="8" Classes="IconButton Large" Click="OnRenameClick" IsEnabled="{Binding CanRename}" ToolTip.Tip="Rename selected item" AutomationProperties.Name="Rename selected file item">
            <icons:SymbolIcon Symbol="Edit" FontSize="14" />
          </Button>
          <Button Grid.Column="9" Classes="IconButton Danger" Click="OnDeleteClick" IsEnabled="{Binding CanDelete}" ToolTip.Tip="Delete selected item" AutomationProperties.Name="Delete selected file item">
            <icons:SymbolIcon Symbol="Delete" FontSize="13" />
          </Button>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="Auto,105,120,95,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
          <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="SORT" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SortField}" AutomationProperties.Name="File sort field" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SortDirection}" AutomationProperties.Name="File sort direction" />
          <ComboBox Grid.Column="3" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" AutomationProperties.Name="File view mode" />
          <Button Grid.Column="5" Classes="TextButton" Click="OnOpenExternallyClick" Content="Open" IsEnabled="{Binding CanOpenExternally}" ToolTip.Tip="Open a local Home file with its default application" />
          <Button Grid.Column="6" Classes="TextButton Accent" Click="OnUploadClick" Content="Upload…" IsEnabled="{Binding CanUpload}" ToolTip.Tip="Upload a file from Home to this location" />
          <Button Grid.Column="7" Classes="TextButton Accent" Click="OnDownloadClick" Content="Download…" IsEnabled="{Binding CanDownload}" ToolTip.Tip="Copy the selected file to Home" />
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="3*,2*">
        <Grid>
          <Grid RowDefinitions="Auto,*">
            <Grid Height="28" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,90,140" ColumnSpacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding IsDetailsView}">
              <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="NAME" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Eyebrow" Text="SIZE" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="MODIFIED" />
            </Grid>
            <ListBox
                Grid.Row="1"
                Margin="{controls:Inset Xs}"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsDetailsView}"
                AutomationProperties.Name="Files and folders">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="32" Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="Auto,*,90,140" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Folder" FontSize="13" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Code" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Modified}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Margin="{controls:Inset Xs}"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsListView}"
                AutomationProperties.Name="Files and folders, compact list">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="34" Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Folder" FontSize="13" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Code" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Margin="{controls:Inset Sm}"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsGridView}"
                AutomationProperties.Name="Files and folders, grid">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <controls:SurfaceCard Padding="0" Width="142" Height="88" Margin="{controls:Inset Xs}">
                    <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                      <icons:SymbolIcon Symbol="Folder" FontSize="20" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                      <icons:SymbolIcon Symbol="Code" FontSize="20" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                      <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                    </StackPanel>
                  </controls:SurfaceCard>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border
              Background="{DynamicResource ShellBackgroundBrush}"
              IsVisible="{Binding ShowLoadingState}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="File Viewer loading">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
              <ProgressBar Width="180" IsIndeterminate="True" />
              <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" />
              <TextBlock Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Lg}" Padding="{controls:Inset Lg}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowErrorState}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding ContentPresentation.AccessibleName}">
            <StackPanel MaxWidth="420" Spacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon HorizontalAlignment="Center" Symbol="ErrorCircle" FontSize="24" Foreground="{DynamicResource ShellDangerBrush}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" TextAlignment="Center" />
              <TextBlock Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Center" Classes="SecondaryButton" Command="{Binding RetryCommand}" Content="Retry location" IsVisible="{Binding CanRetryContentState}" AutomationProperties.Name="Retry File Viewer location" />
            </StackPanel>
          </controls:SurfaceCard>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowEmptyLocationState}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File Viewer empty location">
            <icons:SymbolIcon Symbol="Folder" FontSize="25" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" />
            <TextBlock Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowSearchNoResultsState}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File Viewer search has no results">
            <icons:SymbolIcon Symbol="Search" FontSize="25" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" />
            <TextBlock MaxWidth="360" Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock MaxWidth="360" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Md}" Padding="{controls:Inset Md}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsVisible="{Binding HasOperationIssue}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="File Viewer operation status">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon Symbol="ErrorCircle" FontSize="15" Foreground="{DynamicResource ShellDangerBrush}" />
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding OperationIssue.Title}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding OperationIssue.Message}" TextWrapping="Wrap" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding OperationIssue.SuggestedAction}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="IconButton" Click="OnDismissOperationIssueClick" AutomationProperties.Name="Dismiss File Viewer operation status"><icons:SymbolIcon Symbol="Dismiss" FontSize="11" /></Button>
            </Grid>
          </controls:SurfaceCard>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
          <Grid RowDefinitions="36,Auto,*">
            <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PreviewTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Eyebrow" Text="BOUNDED PREVIEW" />
            </Grid>
            <controls:SurfaceCard Padding="0" Grid.Row="1" Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}" IsVisible="{Binding HasSelectedMetadata}">
              <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="KIND" /><TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Kind}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="SIZE" /><TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Size}" /></StackPanel>
                <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="MODIFIED" /><TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Modified}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="VERSION" /><TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SelectedMetadata.Version}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SelectedMetadata.Source}" />
              </Grid>
            </controls:SurfaceCard>
            <Grid Grid.Row="2">
              <ScrollViewer Margin="{controls:Inset Md}" IsVisible="{Binding HasTextPreview}">
                <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding PreviewText}" TextWrapping="NoWrap" />
              </ScrollViewer>
              <ScrollViewer Margin="{controls:Inset Md}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasImagePreview}">
                <Image MaxWidth="900" MaxHeight="900" Stretch="Uniform" Source="{Binding PreviewImage}" />
              </ScrollViewer>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding IsPreviewLoading}">
                <ProgressBar Width="140" IsIndeterminate="True" />
                <TextBlock Classes="Muted" Text="Reading preview…" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowPreviewPlaceholder}">
                <icons:SymbolIcon Symbol="Info" FontSize="22" Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock Classes="Muted" Text="Select a file to preview it." />
              </StackPanel>
              <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Md}" Padding="{controls:Inset Md}" VerticalAlignment="Bottom" IsVisible="{Binding HasMetadataIssue}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File metadata status">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding MetadataIssue.Title}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding MetadataIssue.Message}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="4" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBlock VerticalAlignment="Center" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File Viewer status" />
          <Button Grid.Column="1" Padding="{controls:Inset Horizontal=Sm}" MinHeight="20" Classes="TextButton Accent" Click="OnLoadMoreClick" IsVisible="{Binding HasMore}" Content="Load more" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
