<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.FileRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <UserControl.Styles>
    <Style Selector="ListBoxItem.transferDropTarget /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <controls:SurfaceCard Tone="Panel" ClipsContent="True" Padding="0"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,Auto,*">
      <Border Classes="PanelHeader">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" Margin="{controls:Inset Horizontal=Md}">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ShellSuccessBrush}" />
          <components:PanelConnectionSelectorView
              Grid.Column="1"
              IsEnabled="{Binding CanSelectProfile}"
              Options="{Binding $parent[Window].DataContext.FileConnectionOptions}"
              SelectedLabel="{Binding ConnectionDisplayName}"
              ConnectionSelected="OnConnectionSelected"
              NewConnectionRequested="OnNewConnectionRequested" />
          <controls:PanelDockHandle
              Grid.Column="2"
              DataContext="{Binding $parent[dock:DockableControl].DataContext}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
              <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Context.Title}" />
              <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding Context.IsZoomed}" Text="Zoomed" />
            </StackPanel>
          </controls:PanelDockHandle>
          <StackPanel
              Grid.Column="3"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceXs}">
            <Button
                AutomationProperties.Name="Split this panel left and right"
                Classes="IconButton"
                Click="OnSplitLeftRightClick"
                ToolTip.Tip="Split left/right">
              <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
            </Button>
            <Button
                AutomationProperties.Name="Split this panel top and bottom"
                Classes="IconButton"
                Click="OnSplitTopBottomClick"
                ToolTip.Tip="Split top/bottom">
              <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
            </Button>
            <Button Classes="IconButton" Click="OnCloseClick" ToolTip.Tip="Close File Viewer" AutomationProperties.Name="Close File Viewer panel">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border
          Grid.Row="1"
          Padding="{controls:Inset Left=Sm, Top=Xs, Right=Sm, Bottom=Sm}"
          Background="{DynamicResource ShellSurfaceBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto,180" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Border
              Classes="FileToolbarGroup">
            <StackPanel Orientation="Horizontal">
              <Button Classes="IconButton FileToolbarAction" Click="OnNavigateUpClick" IsEnabled="{Binding CanNavigateUp}" ToolTip.Tip="Parent folder" AutomationProperties.Name="Parent folder">
                <icons:SymbolIcon Symbol="ArrowUp" FontSize="14" />
              </Button>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button Classes="IconButton FileToolbarAction" Click="OnRefreshClick" ToolTip.Tip="Refresh location" AutomationProperties.Name="Refresh files">
                <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
              </Button>
            </StackPanel>
          </Border>
          <Grid
              Grid.Column="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceXs}">
            <TextBox
                FontSize="{DynamicResource ShellFontSize10}"
                FontWeight="SemiBold"
                Background="Transparent"
                BorderThickness="0"
                Text="{Binding LocationText}"
                IsEnabled="{Binding CanEditLocation}"
                KeyDown="OnLocationKeyDown"
                AutomationProperties.Name="Editable file location" />
            <components:CountPill
                Grid.Column="1"
                IsVisible="{Binding HasListingSummary}"
                Value="{Binding Status}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="File Viewer item count" />
            <Button
                Grid.Column="2"
                Padding="{controls:Inset Horizontal=Sm}"
                MinHeight="24"
                Classes="TextButton Accent"
                Click="OnLoadMoreClick"
                IsVisible="{Binding HasMore}"
                Content="More"
                ToolTip.Tip="Load more files"
                AutomationProperties.Name="Load more files" />
          </Grid>
          <Border
              Grid.Column="2"
              Classes="FileToolbarGroup">
            <StackPanel Orientation="Horizontal">
              <Button
                  Classes="IconButton FileToolbarAction"
                  ToolTip.Tip="Sort and view options"
                  AutomationProperties.Name="Open file sort and view options">
                <icons:SymbolIcon Symbol="Grid" FontSize="14" />
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Width="250" Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock Classes="Eyebrow" Text="View options" />
                      <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock VerticalAlignment="Center" Classes="Muted" Text="Sort by" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SortField}" AutomationProperties.Name="File sort field" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Classes="Muted" Text="Order" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SortDirection}" AutomationProperties.Name="File sort direction" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Classes="Muted" Text="Layout" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" AutomationProperties.Name="File view mode" />
                      </Grid>
                      <CheckBox IsChecked="{Binding ShowHidden}" Content="Show hidden files" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button
                  Classes="IconButton FileToolbarAction InsetToggle"
                  Classes.active="{Binding IsPreviewVisible}"
                  Click="OnTogglePreviewClick"
                  ToolTip.Tip="Show or hide preview"
                  AutomationProperties.Name="Toggle file preview"
                  AutomationProperties.ItemStatus="{Binding PreviewVisibilityStatus}">
                <icons:SymbolIcon Symbol="PanelRight" FontSize="14" />
              </Button>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button Classes="IconButton FileToolbarAction" Click="OnUploadClick" IsEnabled="{Binding CanUpload}" IsVisible="{Binding CanUpload}" ToolTip.Tip="Upload a file from Home" AutomationProperties.Name="Upload file">
                <icons:SymbolIcon Symbol="ArrowUpload" FontSize="14" />
              </Button>
              <Button Classes="IconButton FileToolbarAction" Click="OnDownloadClick" IsEnabled="{Binding CanDownload}" ToolTip.Tip="Download selected file to Home" AutomationProperties.Name="Download selected file">
                <icons:SymbolIcon Symbol="DocumentArrowDown" FontSize="14" />
              </Button>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button Classes="IconButton FileToolbarAction" Click="OnCreateFolderClick" IsEnabled="{Binding CanCreateFolder}" ToolTip.Tip="New folder" AutomationProperties.Name="Create folder">
                <icons:SymbolIcon Symbol="FolderAdd" FontSize="14" />
              </Button>
              <Button Classes="IconButton FileToolbarAction Danger" Click="OnDeleteClick" IsEnabled="{Binding CanDelete}" ToolTip.Tip="Delete selected item" AutomationProperties.Name="Delete selected file item">
                <icons:SymbolIcon Symbol="Delete" FontSize="13" />
              </Button>
              <Border Width="1" Margin="{DynamicResource ShellToolbarSeparatorMargin}" Background="{DynamicResource ShellBorderBrush}" />
              <Button Classes="IconButton FileToolbarAction" ToolTip.Tip="More file actions" AutomationProperties.Name="Open more file actions">
                <icons:SymbolIcon Symbol="MoreVertical" FontSize="14" />
                <Button.Flyout>
                  <MenuFlyout Placement="Bottom">
                    <MenuItem Click="OnOpenExternallyClick" IsEnabled="{Binding CanOpenExternally}" Header="Open selected file">
                      <MenuItem.Icon><icons:SymbolIcon Symbol="OpenFolder" FontSize="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="OnTransferClick" IsEnabled="{Binding CanTransfer}" Header="Transfer selected item">
                      <MenuItem.Icon><icons:SymbolIcon Symbol="ArrowSwap" FontSize="14" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Click="OnRenameClick" IsEnabled="{Binding CanRename}" Header="Rename selected item">
                      <MenuItem.Icon><icons:SymbolIcon Symbol="Edit" FontSize="14" /></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Border>
          <TextBox Grid.Column="3" Text="{Binding Filter}" PlaceholderText="Search files" AutomationProperties.Name="Filter file items" />
        </Grid>
      </Border>

      <Grid x:Name="FileContentGrid" Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="2*" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid Background="{DynamicResource ShellSurfaceBrush}">
          <Grid RowDefinitions="Auto,*">
            <Border
                Height="29"
                Background="{DynamicResource ShellBackgroundBrush}"
                IsVisible="{Binding IsDetailsView}">
              <Grid Margin="{controls:Inset Horizontal=Md}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding FileNameColumnWidth, Mode=TwoWay}" MinWidth="140" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="{Binding FileSizeColumnWidth, Mode=TwoWay}" MinWidth="72" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="{Binding FileModifiedColumnWidth, Mode=TwoWay}" MinWidth="112" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="Name" />
                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource ShellBorderBrush}" IsHitTestVisible="False" />
                <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="Resize file name and size columns" />
                <TextBlock Grid.Column="2" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Eyebrow" Text="Size" />
                <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{DynamicResource ShellBorderBrush}" IsHitTestVisible="False" />
                <GridSplitter
                    Grid.Column="3"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    AutomationProperties.Name="Resize file size and modified columns" />
                <TextBlock Grid.Column="4" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Eyebrow" Text="Modified" />
              </Grid>
            </Border>
            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsDetailsView}"
                AutomationProperties.Name="Files and folders">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="CornerRadius" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="30" Margin="{controls:Inset Horizontal=Md}">
                    <!-- Same minimums as the header row: when width runs out, a
                         minimum only one of the two grids honors makes the
                         header stop shrinking while the rows keep collapsing,
                         and the columns visibly part ways. -->
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileNameColumnWidth}" MinWidth="140" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileSizeColumnWidth}" MinWidth="72" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="{Binding $parent[UserControl].DataContext.FileModifiedColumnWidth}" MinWidth="112" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon VerticalAlignment="Center" Symbol="Folder" FontSize="13" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                      <icons:SymbolIcon VerticalAlignment="Center" Symbol="Code" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </Grid>
                    <TextBlock Grid.Column="2" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                    <TextBlock Grid.Column="4" Margin="{controls:Inset Horizontal=Sm}" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Modified}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsListView}"
                AutomationProperties.Name="Files and folders, compact list">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="CornerRadius" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource ShellSurfaceHoverBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="30" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Folder" FontSize="13" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="Code" FontSize="13" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ListBox
                Grid.Row="1"
                Margin="{controls:Inset Sm}"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Multiple"
                SelectionChanged="OnEntrySelectionChanged"
                DoubleTapped="OnEntryDoubleTapped"
                IsVisible="{Binding IsGridView}"
                AutomationProperties.Name="Files and folders, grid">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <controls:SurfaceCard Padding="0" Width="142" Height="88" Margin="{controls:Inset Xs}">
                    <StackPanel Margin="{controls:Inset Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                      <icons:SymbolIcon Symbol="Folder" FontSize="20" Foreground="{DynamicResource ShellWarningBrush}" IsVisible="{Binding IsDirectory}" />
                      <icons:SymbolIcon Symbol="Code" FontSize="20" Foreground="{DynamicResource ShellMutedBrush}" IsVisible="{Binding !IsDirectory}" />
                      <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Size}" />
                    </StackPanel>
                  </controls:SurfaceCard>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border
              Background="{DynamicResource ShellBackgroundBrush}"
              IsVisible="{Binding ShowLoadingState}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="File Viewer loading">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
              <ProgressBar Width="180" IsIndeterminate="True" />
              <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" />
              <TextBlock Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Lg}" Padding="{controls:Inset Lg}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowErrorState}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding ContentPresentation.AccessibleName}">
            <StackPanel MaxWidth="420" Spacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon HorizontalAlignment="Center" Symbol="ErrorCircle" FontSize="24" Foreground="{DynamicResource ShellDangerBrush}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" TextAlignment="Center" />
              <TextBlock Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Center" Classes="SecondaryButton" Command="{Binding RetryCommand}" Content="Retry location" IsVisible="{Binding CanRetryContentState}" AutomationProperties.Name="Retry File Viewer location" />
            </StackPanel>
          </controls:SurfaceCard>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowEmptyLocationState}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File Viewer empty location">
            <icons:SymbolIcon HorizontalAlignment="Center" Symbol="Folder" FontSize="25" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" TextAlignment="Center" />
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowSearchNoResultsState}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File Viewer search has no results">
            <icons:SymbolIcon HorizontalAlignment="Center" Symbol="Search" FontSize="25" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ContentPresentation.Title}" TextAlignment="Center" />
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" Text="{Binding ContentPresentation.Message}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock MaxWidth="360" HorizontalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ContentPresentation.SuggestedAction}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Md}" Padding="{controls:Inset Md}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsVisible="{Binding HasOperationIssue}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="File Viewer operation status">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon Symbol="ErrorCircle" FontSize="15" Foreground="{DynamicResource ShellDangerBrush}" />
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding OperationIssue.Title}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding OperationIssue.Message}" TextWrapping="Wrap" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding OperationIssue.SuggestedAction}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="IconButton" Click="OnDismissOperationIssueClick" AutomationProperties.Name="Dismiss File Viewer operation status"><icons:SymbolIcon Symbol="Dismiss" FontSize="11" /></Button>
            </Grid>
          </controls:SurfaceCard>
          <ProgressBar
              Height="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              IsIndeterminate="True"
              IsVisible="{Binding ShowNavigationProgress}" />
        </Grid>

        <Border
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            Background="{DynamicResource ShellBorderBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsPreviewVisible}" />
        <GridSplitter
            x:Name="PreviewSplitter"
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            IsVisible="{Binding IsPreviewVisible}"
            AutomationProperties.Name="Resize file preview" />

        <Border
            Grid.Column="2"
            Background="{DynamicResource ShellSurfaceBrush}"
            IsVisible="{Binding IsPreviewVisible}">
          <Grid RowDefinitions="29,Auto,*">
            <Border Background="{DynamicResource ShellBackgroundBrush}">
              <Grid Margin="{controls:Inset Horizontal=Md}">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PreviewTitle}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
            <controls:SurfaceCard Padding="0" Grid.Row="1" Margin="{controls:Inset Horizontal=Sm, Bottom=Sm}" IsVisible="{Binding HasSelectedMetadata}">
              <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Kind" /><TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Kind}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Size" /><TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Size}" /></StackPanel>
                <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Modified" /><TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedMetadata.Modified}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Version" /><TextBlock FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SelectedMetadata.Version}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SelectedMetadata.Source}" />
              </Grid>
            </controls:SurfaceCard>
            <Grid Grid.Row="2">
              <ScrollViewer Margin="{controls:Inset Md}" IsVisible="{Binding HasTextPreview}">
                <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding PreviewText}" TextWrapping="NoWrap" />
              </ScrollViewer>
              <ScrollViewer Margin="{controls:Inset Md}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasImagePreview}">
                <Image MaxWidth="900" MaxHeight="900" Stretch="Uniform" Source="{Binding PreviewImage}" />
              </ScrollViewer>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding IsPreviewLoading}">
                <ProgressBar Width="140" IsIndeterminate="True" />
                <TextBlock Classes="Muted" Text="Reading preview…" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowPreviewPlaceholder}">
                <icons:SymbolIcon Symbol="Info" FontSize="22" Foreground="{DynamicResource ShellMutedBrush}" />
                <TextBlock Classes="Muted" Text="Select a file to preview it." />
              </StackPanel>
              <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Md}" Padding="{controls:Inset Md}" VerticalAlignment="Bottom" IsVisible="{Binding HasMetadataIssue}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="File metadata status">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding MetadataIssue.Title}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding MetadataIssue.Message}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border
          Grid.Row="1"
          Grid.RowSpan="2"
          Background="Transparent"
          IsVisible="{Binding ShowNavigationProgress}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="File Viewer loading folder" />
      <Rectangle
          x:Name="TransferDropOutline"
          Grid.RowSpan="3"
          Margin="2"
          IsHitTestVisible="False"
          IsVisible="False"
          RadiusX="{DynamicResource ShellCardRadius}"
          RadiusY="{DynamicResource ShellCardRadius}"
          Stroke="{DynamicResource ShellAccentBrush}"
          StrokeDashArray="4,3"
          StrokeThickness="2"
          AutomationProperties.Name="File transfer drop target" />
    </Grid>
  </controls:SurfaceCard>
</UserControl>
