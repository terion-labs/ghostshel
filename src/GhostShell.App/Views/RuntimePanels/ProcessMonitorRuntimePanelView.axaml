<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.ProcessMonitorRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Process monitor panel">
  <controls:SurfaceCard Tone="Sunken" ClipsContent="True" Padding="0"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,46,28,*,25">
      <Border Classes="PanelHeader">
        <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
          <components:PanelConnectionSelectorView
              Grid.Column="1"
              Options="{Binding $parent[Window].DataContext.PanelConnectionOptions}"
              SelectedLabel="{Binding ConnectionDisplayName}"
              ConnectionSelected="OnConnectionSelected"
              NewConnectionRequested="OnNewConnectionRequested" />
          <controls:PanelDockHandle
              Grid.Column="2"
              DataContext="{Binding $parent[dock:DockableControl].DataContext}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
              <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Context.Title}" />
              <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding Context.IsZoomed}" Text="Zoomed" />
            </StackPanel>
          </controls:PanelDockHandle>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding StatusText}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Process monitor state" />
            <Button
                Classes="IconButton"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh processes"
                AutomationProperties.Name="Refresh processes">
              <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="12" />
            </Button>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{DynamicResource ShellSpaceXs}">
              <Button
                  AutomationProperties.Name="Split this panel left and right"
                  Classes="IconButton"
                  Click="OnSplitLeftRightClick"
                  ToolTip.Tip="Split left/right">
                <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
              </Button>
              <Button
                  AutomationProperties.Name="Split this panel top and bottom"
                  Classes="IconButton"
                  Click="OnSplitTopBottomClick"
                  ToolTip.Tip="Split top/bottom">
                <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
              </Button>
              <Button
                  Classes="IconButton"
                  Click="OnCloseClick"
                  ToolTip.Tip="Close Process Monitor"
                  AutomationProperties.Name="Close Process Monitor panel">
                <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="*,190,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter by process name or PID" AutomationProperties.Name="Filter processes" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Process sort order" />
          <Button Grid.Column="2" Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Refresh" AutomationProperties.Name="Refresh process list" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Height="28" Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="70,*,90,110,145" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="PID" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Eyebrow" Text="Name" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="CPU" />
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="Eyebrow" Text="Memory" />
          <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="Eyebrow" Text="Started" />
        </Grid>
      </Border>

      <Grid Grid.Row="3">
        <ListBox
            Margin="{controls:Inset Xs}"
            ItemsSource="{Binding Processes}"
            SelectedItem="{Binding SelectedProcess}"
            IsVisible="{Binding ShowContent}"
            AutomationProperties.Name="Bounded process list">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                  MinHeight="34"
                  Margin="{controls:Inset Horizontal=Sm}"
                  ColumnDefinitions="70,*,90,110,145"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}"
                  AutomationProperties.Name="{Binding AccessibleSummary}">
                <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ProcessId}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
                  <TextBlock FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding IsGhostShell}" Text="GhostSHELL" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Cpu}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Memory}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Started}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowLoading}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Process monitor loading">
          <ProgressBar Width="180" IsIndeterminate="True" />
          <TextBlock FontWeight="SemiBold" Text="Waiting for first sample…" />
          <TextBlock MaxWidth="430" Classes="Muted" TextAlignment="Center" Text="Process names and resource counters are bounded. Command lines, users, environments, and open files are excluded." TextWrapping="Wrap" />
        </StackPanel>

        <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Lg}" Padding="{controls:Inset Lg}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowTerminalError}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Process monitor unavailable">
          <StackPanel MaxWidth="430" Spacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon HorizontalAlignment="Center" Symbol="ErrorCircle" FontSize="24" Foreground="{DynamicResource ShellDangerBrush}" />
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding IssueTitle}" />
            <TextBlock Classes="Muted" Text="{Binding IssueMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry process capture" />
          </StackPanel>
        </controls:SurfaceCard>

        <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Md}" Padding="{controls:Inset Md}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" IsVisible="{Binding ShowInlineIssue}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Process refresh status">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon Symbol="Warning" FontSize="15" Foreground="{DynamicResource ShellWarningBrush}" />
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding IssueTitle}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding IssueMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry process list" />
          </Grid>
        </controls:SurfaceCard>
      </Grid>

      <Border Grid.Row="4" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ShowingText}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding CapturedAtText}" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
