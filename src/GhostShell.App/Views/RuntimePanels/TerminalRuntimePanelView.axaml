<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.TerminalRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:components="using:GhostShell.App.Views.Components"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <controls:PanelChrome
      CloseRequested="OnCloseClick"
      IsActive="{Binding IsActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="Terminal">
    <controls:PanelChrome.Status>
      <Ellipse
          Width="7"
          Height="7"
          Fill="{Binding StatusBrush, ElementName=RuntimeTerminal}" />
    </controls:PanelChrome.Status>

    <controls:PanelChrome.Leading>
      <components:PanelConnectionSelectorView
          Options="{Binding $parent[Window].DataContext.PanelConnectionOptions}"
          SelectedLabel="{Binding ConnectionDisplayName}"
          ConnectionSelected="OnConnectionSelected"
          NewConnectionRequested="OnNewConnectionRequested" />
    </controls:PanelChrome.Leading>

    <controls:PanelChrome.Actions>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
        <!-- The panel that actually asked. The tab and the rail aggregate
             it, so this is where the trail ends. -->
        <controls:SignalDot
            IsVisible="{Binding HasAttention}"
            ToolTip.Tip="This panel asked for attention" />
        <TextBlock
            VerticalAlignment="Center"
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize9}"
            Text="{Binding StatusText, ElementName=RuntimeTerminal}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Terminal session status" />
      </StackPanel>
    </controls:PanelChrome.Actions>

    <Grid>
        <controls:TerminalPresentationHost
            x:Name="RuntimeTerminal"
            Margin="1"
            ClientId="{Binding ClientId}"
            SessionClient="{Binding SessionClient}"
            StartupCommandDispatchState="{Binding StartupCommandDispatchState}"
            StartupCommandDispatcher="{Binding StartupCommandDispatcher}"
            SessionRequest="{Binding SessionRequest}"
            RenderProfile="{Binding RenderProfile}"
            BackgroundOpacity="{DynamicResource ShellSurfaceOpacity}"
            SessionSnapshotChanged="OnSessionSnapshotChanged"
            SessionInitializationFailed="OnSessionInitializationFailed" />
        <Border
            Margin="1"
            Padding="{controls:Inset Xl}"
            Background="{DynamicResource ShellBackgroundBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding ShowFallback, ElementName=RuntimeTerminal}">
          <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon Symbol="WindowConsole" FontSize="24" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize11}"
                Text="{Binding StatusMessage, ElementName=RuntimeTerminal}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            Margin="{controls:Inset Md}"
            Padding="{controls:Inset Horizontal=Md, Vertical=Sm}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            MaxWidth="420"
            Background="#E6291D18"
            BorderBrush="{DynamicResource ShellWarningBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellControlCornerRadius}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Startup command delivery status"
            IsHitTestVisible="False"
            IsVisible="{Binding HasStartupCommandError}">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock
                
                FontSize="{DynamicResource ShellFontSize10}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource ShellWarningBrush}"
                Text="{Binding StartupCommandErrorTitle}" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding StartupCommandErrorDetail}"
                TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            Margin="{controls:Inset Md}"
            Padding="{controls:Inset Sm}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#E6291D18"
            BorderBrush="{DynamicResource ShellWarningBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ShellControlCornerRadius}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsCopyMode}">
          <TextBlock
              
              FontSize="{DynamicResource ShellFontSize9}"
              Foreground="{DynamicResource ShellWarningBrush}"
              Text="COPY MODE · scroll/select with the pointer · copy normally · Esc exits" />
        </Border>
        <Border
            Margin="1"
            Padding="{controls:Inset Xl}"
            Background="{DynamicResource ShellBackgroundBrush}"
            IsVisible="{Binding HasConnectionOverlay}">
          <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon Symbol="WindowConsole" FontSize="25" Foreground="{DynamicResource ShellWarningBrush}" />
            <TextBlock
                FontSize="{DynamicResource ShellFontSize15}"
                FontWeight="SemiBold"
                Text="{Binding ConnectionStatus}"
                TextAlignment="Center" />
            <TextBlock
                Classes="Muted"
                Text="{Binding ConnectionDetail}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding RecoveryLabel}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <controls:SurfaceCard Padding="0" IsVisible="{Binding HasHostKeyReview}">
              <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" TextAlignment="Center" />
                <TextBlock FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HostKeyReview.Presented.Algorithm}" TextAlignment="Center" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding TrustedHostKeyFingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="SecondaryButton" Click="OnTrustHostKeyClick" Content="{Binding TrustHostKeyLabel}" IsVisible="{Binding CanTrustHostKey}" />
              </StackPanel>
            </controls:SurfaceCard>
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ReconnectStatus}" IsVisible="{Binding IsReconnecting}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
              <Button
                  Classes="SecondaryButton"
                  Click="OnRetryConnectionClick"
                  Content="Retry connection"
                  IsVisible="{Binding CanRetry}" />
              <Button
                  Classes="TextButton"
                  Click="OnCancelReconnectClick"
                  Content="Cancel reconnect"
                  IsVisible="{Binding CanCancelReconnect}" />
            </StackPanel>
          </StackPanel>
        </Border>
    </Grid>
  </controls:PanelChrome>
</UserControl>
