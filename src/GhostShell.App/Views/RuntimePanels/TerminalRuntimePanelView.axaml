<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.TerminalRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <Border
      Classes="PanelCard"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,*">
      <Border Grid.Row="0" Classes="PanelHeader">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="11,0">
          <Ellipse
              Width="7"
              Height="7"
              VerticalAlignment="Center"
              Fill="{Binding StatusBrush, ElementName=RuntimeTerminal}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Title}" />
            <TextBlock Classes="Eyebrow" Text="{Binding KindLabel}" />
            <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding IsZoomed}" Text="ZOOMED" />
            <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding IsCopyMode}" Text="COPY MODE" />
            <TextBlock
                Classes="Eyebrow Accent"
                IsVisible="{Binding HasWarning}"
                Text="WARNING"
                ToolTip.Tip="{Binding WarningMessage}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock
                VerticalAlignment="Center"
                Classes="Monospace Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding StatusText, ElementName=RuntimeTerminal}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Terminal session status" />
            <Button
                Classes="IconButton"
                Click="OnCloseClick"
                ToolTip.Tip="Close panel"
                AutomationProperties.Name="Close panel">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <controls:TerminalPresentationHost
            x:Name="RuntimeTerminal"
            Margin="1"
            ClientId="{Binding ClientId}"
            SessionClient="{Binding SessionClient}"
            StartupCommandDispatchState="{Binding StartupCommandDispatchState}"
            StartupCommandDispatcher="{Binding StartupCommandDispatcher}"
            SessionRequest="{Binding SessionRequest}"
            ApplicationKeyPressed="OnApplicationKeyPressed"
            SessionSnapshotChanged="OnSessionSnapshotChanged"
            SessionInitializationFailed="OnSessionInitializationFailed" />
        <Border
            Margin="1"
            Padding="24"
            Background="#0D0D0E"
            IsHitTestVisible="False"
            IsVisible="{Binding ShowFallback, ElementName=RuntimeTerminal}">
          <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <icons:SymbolIcon Symbol="WindowConsole" FontSize="24" Foreground="#7B7B82" />
            <TextBlock
                Classes="Monospace Muted"
                FontSize="{DynamicResource ShellFontSize11}"
                Text="{Binding StatusMessage, ElementName=RuntimeTerminal}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            Margin="12"
            Padding="12,9"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            MaxWidth="420"
            Background="#E6291D18"
            BorderBrush="#9B5B36"
            BorderThickness="1"
            CornerRadius="8"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Startup command delivery status"
            IsHitTestVisible="False"
            IsVisible="{Binding HasStartupCommandError}">
          <StackPanel Spacing="3">
            <TextBlock
                Classes="Monospace"
                FontSize="{DynamicResource ShellFontSize10}"
                FontWeight="SemiBold"
                Foreground="#FFB06A"
                Text="{Binding StartupCommandErrorTitle}" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding StartupCommandErrorDetail}"
                TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border
            Margin="12"
            Padding="10,7"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#E6291D18"
            BorderBrush="#9B5B36"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            IsVisible="{Binding IsCopyMode}">
          <TextBlock
              Classes="Monospace"
              FontSize="{DynamicResource ShellFontSize9}"
              Foreground="#FFB06A"
              Text="COPY MODE · scroll/select with the pointer · copy normally · Esc exits" />
        </Border>
        <Border
            Margin="1"
            Padding="24"
            Background="#0D0D0E"
            IsVisible="{Binding HasConnectionOverlay}">
          <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
            <icons:SymbolIcon Symbol="WindowConsole" FontSize="25" Foreground="#D79B57" />
            <TextBlock
                FontSize="{DynamicResource ShellFontSize15}"
                FontWeight="SemiBold"
                Text="{Binding ConnectionStatus}"
                TextAlignment="Center" />
            <TextBlock
                Classes="Muted"
                Text="{Binding ConnectionDetail}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="Muted Monospace"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="{Binding RecoveryLabel}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Border Classes="SettingsCard" IsVisible="{Binding HasHostKeyReview}">
              <StackPanel Margin="12" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" TextAlignment="Center" />
                <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HostKeyReview.Presented.Algorithm}" TextAlignment="Center" />
                <TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding TrustedHostKeyFingerprint}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="SecondaryButton" Click="OnTrustHostKeyClick" Content="{Binding TrustHostKeyLabel}" IsVisible="{Binding CanTrustHostKey}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ReconnectStatus}" IsVisible="{Binding IsReconnecting}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Button
                  Classes="SecondaryButton"
                  Click="OnRetryConnectionClick"
                  Content="Retry connection"
                  IsVisible="{Binding CanRetry}" />
              <Button
                  Classes="TextButton"
                  Click="OnCancelReconnectClick"
                  Content="Cancel reconnect"
                  IsVisible="{Binding CanCancelReconnect}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
