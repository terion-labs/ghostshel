<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.DatabaseRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Database panel">
  <UserControl.Styles>
    <Style Selector="Border.ResultRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.ResultRow.even">
      <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
    </Style>
    <Style Selector="Border.ResultRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellControlHoverBrush}" />
    </Style>
    <Style Selector="Border.ResultRow.selected">
      <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <controls:SurfaceCard Tone="Sunken" ClipsContent="True" Padding="0"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,Auto,*,25">
      <Border Classes="PanelHeader">
        <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Border VerticalAlignment="Center" Classes="StatusDot" Classes.available="{Binding IsConnected}" />
          <components:PanelConnectionSelectorView
              Grid.Column="1"
              Options="{Binding $parent[Window].DataContext.PanelConnectionOptions}"
              SelectedLabel="{Binding ConnectionDisplayName}"
              ConnectionSelected="OnConnectionSelected"
              NewConnectionRequested="OnNewConnectionRequested" />
          <controls:PanelDockHandle
              Grid.Column="2"
              DataContext="{Binding $parent[dock:DockableControl].DataContext}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
              <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Context.Title}" />
              <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding Context.IsZoomed}" Text="Zoomed" />
            </StackPanel>
          </controls:PanelDockHandle>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding StatusText}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Database state" />
            <Button
                AutomationProperties.Name="Split this panel left and right"
                Classes="IconButton"
                Click="OnSplitLeftRightClick"
                ToolTip.Tip="Split left/right">
              <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
            </Button>
            <Button
                AutomationProperties.Name="Split this panel top and bottom"
                Classes="IconButton"
                Click="OnSplitTopBottomClick"
                ToolTip.Tip="Split top/bottom">
              <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
            </Button>
            <Button
                Classes="IconButton"
                Click="OnCloseClick"
                ToolTip.Tip="Close database viewer"
                AutomationProperties.Name="Close database panel">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <ComboBox
              MinWidth="128"
              VerticalAlignment="Center"
              ItemsSource="{Binding DriverOptions}"
              SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
              AutomationProperties.Name="Database driver">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox
              Grid.Column="1"
              VerticalAlignment="Center"
              Text="{Binding ConnectionString, Mode=TwoWay}"
              PlaceholderText="{Binding SelectedDriver.ConnectionStringHint}"
              KeyDown="OnConnectionStringKeyDown"
              AutomationProperties.Name="Database connection string" />
          <Button
              Grid.Column="2"
              MinWidth="86"
              VerticalAlignment="Center"
              Classes="SecondaryButton"
              Command="{Binding ConnectCommand}"
              Content="Connect"
              AutomationProperties.Name="Connect to the database" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="196,*">
        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" Classes="SectionHeading" Text="Objects" />
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Tables}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                        Classes="ListRow"
                        Click="OnTableClick"
                        AutomationProperties.Name="{Binding Name, StringFormat=Preview rows from {0}}">
                      <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Xs}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding KindLabel}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
          <Grid Margin="{controls:Inset Sm}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBox
                MinHeight="64"
                MaxHeight="140"
                AcceptsReturn="True"
                Text="{Binding QueryText, Mode=TwoWay}"
                TextWrapping="NoWrap"
                PlaceholderText="SELECT …"
                KeyDown="OnQueryKeyDown"
                AutomationProperties.Name="SQL statement" />
            <Button
                Grid.Column="1"
                MinWidth="70"
                VerticalAlignment="Top"
                Classes="PrimaryButton"
                Command="{Binding RunQueryCommand}"
                Content="Run"
                ToolTip.Tip="Run the statement (Cmd+Enter)"
                AutomationProperties.Name="Run the SQL statement" />
          </Grid>

          <controls:SurfaceCard Grid.Row="1" Tone="Notice" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" Padding="{controls:Inset Sm}" IsVisible="{Binding HasError}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Database error">
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Foreground="{DynamicResource ShellDangerBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </controls:SurfaceCard>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="{Binding HasResults}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Width="40" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="#" TextAlignment="Right" />
                    <ItemsControl ItemsSource="{Binding ResultColumns}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Width="164" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}">
                            <TextBlock FontSize="{DynamicResource ShellFontSize10}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DataTypeName}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ResultRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border
                            Classes="ResultRow"
                            Classes.even="{Binding IsEven}"
                            Classes.selected="{Binding IsSelected}"
                            PointerPressed="OnResultRowPressed">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Width="40" Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Number}" TextAlignment="Right" />
                            <ItemsControl ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock
                                      Width="164"
                                      Margin="{controls:Inset Horizontal=Sm, Vertical=Xs}"
                                      Classes.Muted="{Binding IsNull}"
                                      FontSize="{DynamicResource ShellFontSize10}"
                                      Text="{Binding Text}"
                                      TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </ScrollViewer>

            <!-- The TablePlus-style field inspector: every column of the selected
                 row readable in full, no matter how narrow the grid cells are. -->
            <Border Grid.Column="1" Width="236" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding HasSelectedRow}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="{controls:Inset Sm}" ItemsSource="{Binding SelectedRowFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="{controls:Inset Bottom=Sm}" Spacing="{DynamicResource ShellSpaceXs}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                          <TextBlock FontSize="{DynamicResource ShellFontSize10}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DataTypeName}" />
                        </Grid>
                        <TextBlock
                            Classes.Muted="{Binding IsNull}"
                            FontSize="{DynamicResource ShellFontSize10}"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>

          <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowEmptyHint}">
            <icons:SymbolIcon HorizontalAlignment="Center" Symbol="Database" FontSize="24" Foreground="{DynamicResource ShellMutedBrush}" />
            <TextBlock Classes="Muted" Text="Connect, then run a statement or pick an object to preview its rows." TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
          </StackPanel>
        </Grid>
      </Grid>

      <Border Grid.Row="3" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ResultSummary}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SelectedDriver.DisplayName}" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
