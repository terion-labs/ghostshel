<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.PanelPlaceholderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    AutomationProperties.Name="New panel"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <!--
    An empty cell is a panel like any other: it wears the same chrome, and it can
    be split and closed from the same place. It used to offer only Close, which
    made it the one panel whose header answered a different set of questions.
  -->
  <controls:PanelChrome
      CloseLabel="Close new panel"
      CloseRequested="OnCloseClick"
      IsActive="{Binding IsActive}"
      IsZoomed="{Binding IsZoomed}"
      SplitRequested="OnSplitRequested"
      Title="{Binding KindLabel}">
      <ScrollViewer
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <components:LauncherView
            Margin="{controls:Inset Xl}"
            DataContext="{Binding $parent[Window].DataContext}"
            ShowCloseAction="False"
            AddConnectionRequested="OnAddConnectionClick"
            NewBrowserRequested="OnChooseBrowserClick"
            NewDatabaseRequested="OnChooseDatabaseClick"
            NewFileViewerRequested="OnChooseFileViewerClick"
            NewLocalTerminalRequested="OnChooseTerminalClick"
            NewProcessMonitorRequested="OnChooseProcessMonitorClick"
            NewStatisticsRequested="OnChooseStatisticsClick"
            ConnectionLaunchRequested="OnConnectionLaunchRequested"
            DeleteConnectionRequested="OnDeleteConnectionRequested"
            EditConnectionRequested="OnEditConnectionRequested"
            FinishOnboardingRequested="OnFinishOnboardingClick"
            HistorySearchKeyDownRequested="OnHistorySearchKeyDown"
            RetryOnboardingRequested="OnRetryOnboardingClick"
            OpenScreenRequested="OnOpenScreenClick"
            ShowCommandPaletteRequested="OnShowCommandPaletteClick"
            ShowLayoutDesignerRequested="OnShowLayoutDesignerClick" />
      </ScrollViewer>
  </controls:PanelChrome>
</UserControl>
