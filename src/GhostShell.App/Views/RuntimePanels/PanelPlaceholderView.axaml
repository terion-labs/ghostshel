<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.PanelPlaceholderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:icons="using:FluentIcons.Avalonia"
    AutomationProperties.Name="New panel"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}">
  <controls:SurfaceCard Tone="Sunken" ClipsContent="True" Padding="0" Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="40,*">
      <Border Grid.Row="0" Classes="PanelHeader">
        <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="Auto,*,Auto">
          <controls:PanelDockHandle DataContext="{Binding $parent[dock:DockableControl].DataContext}">
            <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding Context.KindLabel}" />
          </controls:PanelDockHandle>
          <Button
              Grid.Column="2"
              AutomationProperties.Name="Close new panel"
              Classes="IconButton"
              Click="OnCloseClick"
              ToolTip.Tip="Close panel">
            <icons:SymbolIcon FontSize="12" Symbol="Dismiss" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <components:NewItemChooserView
            Margin="{controls:Inset Xl}"
            DataContext="{Binding $parent[Window].DataContext}"
            ShowCloseAction="False"
            ShowWorkspaces="False"
            AddConnectionRequested="OnAddConnectionClick"
            NewBrowserRequested="OnChooseBrowserClick"
            NewDatabaseRequested="OnChooseDatabaseClick"
            NewFileViewerRequested="OnChooseFileViewerClick"
            NewLocalTerminalRequested="OnChooseTerminalClick"
            NewProcessMonitorRequested="OnChooseProcessMonitorClick"
            NewStatisticsRequested="OnChooseStatisticsClick"
            OpenConnectionRequested="OnOpenConnectionClick"
            OpenScreenRequested="OnOpenScreenClick"
            ShowCommandPaletteRequested="OnShowCommandPaletteClick"
            ShowLayoutDesignerRequested="OnShowLayoutDesignerClick" />
      </ScrollViewer>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
