<UserControl
    x:Class="GhostShell.App.Views.RuntimePanels.StatisticsRuntimePanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    Classes="RuntimePanelFocusTarget"
    Focusable="True"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    IsVisible="{Binding IsVisibleInLayout}"
    AutomationProperties.Name="Statistics panel">
  <controls:SurfaceCard Tone="Panel" ClipsContent="True" Padding="0"
      Classes.active="{Binding IsActive}">
    <Grid RowDefinitions="36,*,25">
      <Border Classes="PanelHeader">
        <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
          <components:PanelConnectionSelectorView
              Grid.Column="1"
              Options="{Binding $parent[Window].DataContext.PanelConnectionOptions}"
              SelectedLabel="{Binding ConnectionDisplayName}"
              ConnectionSelected="OnConnectionSelected"
              NewConnectionRequested="OnNewConnectionRequested" />
          <controls:PanelDockHandle
              Grid.Column="2"
              DataContext="{Binding $parent[dock:DockableControl].DataContext}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
              <TextBlock FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="{Binding Context.Title}" />
              <TextBlock Classes="Eyebrow Accent" IsVisible="{Binding Context.IsZoomed}" Text="Zoomed" />
            </StackPanel>
          </controls:PanelDockHandle>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" VerticalAlignment="Center">
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding StatusText}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Statistics state" />
            <Button
                Classes="IconButton"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh statistics"
                AutomationProperties.Name="Refresh statistics">
              <icons:SymbolIcon Symbol="ArrowClockwise" FontSize="12" />
            </Button>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{DynamicResource ShellSpaceXs}">
              <Button
                  AutomationProperties.Name="Split this panel left and right"
                  Classes="IconButton"
                  Click="OnSplitLeftRightClick"
                  ToolTip.Tip="Split left/right">
                <icons:SymbolIcon FontSize="12" Symbol="SplitVertical" />
              </Button>
              <Button
                  AutomationProperties.Name="Split this panel top and bottom"
                  Classes="IconButton"
                  Click="OnSplitTopBottomClick"
                  ToolTip.Tip="Split top/bottom">
                <icons:SymbolIcon FontSize="12" Symbol="SplitHorizontal" />
              </Button>
              <Button
                  Classes="IconButton"
                  Click="OnCloseClick"
                  ToolTip.Tip="Close Statistics"
                  AutomationProperties.Name="Close Statistics panel">
                <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer Margin="{controls:Inset Lg}" IsVisible="{Binding ShowContent}">
          <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
              <controls:SurfaceCard Padding="0">
                <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="CPU usage" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding CpuText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Normalized across logical processors" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding CpuHistory}"
                      Maximum="100"
                      LineBrush="{DynamicResource ShellAccentBrush}"
                      AreaBrush="{DynamicResource ShellAccentSoftBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="CPU usage history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Now · 100% max" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="0" Grid.Column="1">
                <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" RowDefinitions="Auto,Auto,Auto,108,Auto">
                  <TextBlock Classes="Eyebrow" Text="Process memory" />
                  <TextBlock Grid.Row="1" FontSize="{DynamicResource ShellFontSize24}" FontWeight="SemiBold" Text="{Binding MemoryText}" />
                  <TextBlock Grid.Row="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Combined RSS from accessible processes" TextWrapping="Wrap" />
                  <controls:TimeSeriesChart
                      Grid.Row="3"
                      Margin="{controls:Inset Top=Md}"
                      Values="{Binding MemoryHistory}"
                      LineBrush="{DynamicResource ShellSuccessBrush}"
                      AreaBrush="{DynamicResource ShellSuccessSoftBrush}"
                      GridBrush="{DynamicResource ShellBorderBrush}"
                      AutomationProperties.Name="Process memory history over the last two minutes" />
                  <Grid Grid.Row="4" Margin="{controls:Inset Top=Xs}" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Last 2 min" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Now · auto scale" />
                  </Grid>
                </Grid>
              </controls:SurfaceCard>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="Eyebrow" Text="Running processes" />
                  <TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="{Binding ProcessCountText}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ProcessDetailText}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="0" Grid.Column="1">
                <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock Classes="Eyebrow" Text="Host uptime" />
                  <TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="{Binding UptimeText}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ProcessorCountText, StringFormat={}{0} logical processors}" TextWrapping="Wrap" />
                </StackPanel>
              </controls:SurfaceCard>
            </Grid>

            <controls:SurfaceCard Tone="Notice" Padding="{controls:Inset Md}" IsVisible="{Binding HasIssue}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Statistics refresh status">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource ShellWarningBrush}" />
                <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding IssueTitle}" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding IssueMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry statistics capture" />
              </Grid>
            </controls:SurfaceCard>
          </StackPanel>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding ShowLoading}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Statistics loading">
          <ProgressBar Width="180" IsIndeterminate="True" />
          <TextBlock FontWeight="SemiBold" Text="Waiting for first sample…" />
          <TextBlock MaxWidth="420" Classes="Muted" TextAlignment="Center" Text="The session host is collecting a bounded POSIX process snapshot; commands and terminal content remain excluded." TextWrapping="Wrap" />
        </StackPanel>

        <controls:SurfaceCard Tone="Notice" Margin="{controls:Inset Lg}" Padding="{controls:Inset Lg}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowTerminalError}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Statistics unavailable">
          <StackPanel MaxWidth="430" Spacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon HorizontalAlignment="Center" Symbol="ErrorCircle" FontSize="24" Foreground="{DynamicResource ShellDangerBrush}" />
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding IssueTitle}" />
            <TextBlock Classes="Muted" Text="{Binding IssueMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Classes="SecondaryButton" Command="{Binding RefreshCommand}" Content="Retry" AutomationProperties.Name="Retry statistics capture" />
          </StackPanel>
        </controls:SurfaceCard>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="{controls:Inset Horizontal=Sm}" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="POSIX process counters · no environment or terminal content" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding CapturedAtText}" />
        </Grid>
      </Border>
    </Grid>
  </controls:SurfaceCard>
</UserControl>
