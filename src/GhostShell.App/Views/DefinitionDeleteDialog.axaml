<Window
    x:Class="GhostShell.App.Views.DefinitionDeleteDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm delete"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock Classes="Muted" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="NoticeCard">
      <TextBlock
          Margin="12"
          Classes="Muted"
          Text="{Binding Notice}"
          TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel delete" />
      <Button MinWidth="100" Classes="DestructiveButton" Click="OnConfirmClick" Content="{Binding ConfirmLabel}" AutomationProperties.Name="Confirm delete" />
    </StackPanel>
  </Grid>
</Window>
