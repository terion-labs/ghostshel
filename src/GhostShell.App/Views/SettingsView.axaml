<UserControl
    x:Class="GhostShell.App.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:settingsPages="using:GhostShell.App.Views.SettingsPages"
    xmlns:views="using:GhostShell.App.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <Grid RowDefinitions="Auto,*">
      <Border
          Classes="TopChrome"
          MinHeight="{Binding $parent[Window].TitleBarChromeHeight}"
          PointerPressed="OnTitleBarPointerPressed"
          WindowDecorationProperties.ElementRole="TitleBar">
        <Grid>
          <Button
              x:Name="SettingsBackButton"
              Margin="{Binding $parent[Window].WindowTitleBarContentMargin}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Classes="IconButton ChromeNavigation"
              Click="OnSettingsBackClick"
              ToolTip.Tip="Back"
              WindowDecorationProperties.ElementRole="User"
              AutomationProperties.Name="Leave settings">
            <icons:SymbolIcon Symbol="ArrowLeft" FontSize="15" />
          </Button>
          <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon Symbol="Settings" FontSize="13" />
            <TextBlock FontSize="{DynamicResource ShellFontSize12}" FontWeight="SemiBold" Text="Settings" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="244,*">
        <Border Classes="FloatingSidebar" Classes.routeSidebar="True">
          <Grid RowDefinitions="Auto,*">
            <Button
                Margin="{controls:Inset Md}"
                HorizontalAlignment="Stretch"
                Classes="SearchButton"
                Click="OnShowCommandPaletteClick"
                AutomationProperties.Name="Search commands and settings">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="14" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize12}"
                    Text="Search settings"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding CommandPaletteShortcut}" />
              </Grid>
            </Button>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="{controls:Inset Horizontal=Md, Bottom=Lg}" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock Margin="{controls:Inset Left=Sm, Top=Xs, Bottom=Sm}" Classes="SectionHeading" Text="Preferences" />
                <components:ShellNavigationItem
                    AutomationName="Appearance settings"
                    Click="OnAppearanceSettingsClick"
                    Icon="Color"
                    IsActive="{Binding IsAppearanceSettingsVisible}"
                    Label="Appearance" />
                <components:ShellNavigationItem
                    AutomationName="Workspace and saved screen settings"
                    Click="OnWorkspaceSettingsClick"
                    Icon="Window"
                    IsActive="{Binding IsWorkspaceSettingsVisible}"
                    Label="Workspaces &amp; screens" />
                <components:ShellNavigationItem
                    AutomationName="Keybinding settings"
                    Click="OnKeybindingSettingsClick"
                    Icon="Keyboard"
                    IsActive="{Binding IsKeybindingSettingsVisible}"
                    Label="Keybindings" />
                <components:ShellNavigationItem
                    AutomationName="File and transfer settings"
                    Click="OnFilesSettingsClick"
                    Icon="Folder"
                    IsActive="{Binding IsFilesSettingsVisible}"
                    Label="Files &amp; transfers" />
                <components:ShellNavigationItem
                    AutomationName="Terminal settings"
                    Click="OnTerminalSettingsClick"
                    Icon="WindowConsole"
                    IsActive="{Binding IsTerminalSettingsVisible}"
                    Label="Terminal" />
                <components:ShellNavigationItem
                    AutomationName="Quick Terminal settings"
                    Click="OnQuickTerminalSettingsClick"
                    Icon="WindowConsole"
                    IsActive="{Binding IsQuickTerminalSettingsVisible}"
                    Label="Quick Terminal" />
                <components:ShellNavigationItem
                    AutomationName="Secret settings"
                    Click="OnSecretsSettingsClick"
                    Icon="Key"
                    IsActive="{Binding IsSecretsSettingsVisible}"
                    Label="Security &amp; secrets" />
                <components:ShellNavigationItem
                    AutomationName="Data and diagnostic settings"
                    Click="OnDiagnosticsSettingsClick"
                    Icon="DocumentBulletList"
                    IsActive="{Binding IsDiagnosticsSettingsVisible}"
                    Label="Data &amp; diagnostics" />
                <components:ShellNavigationItem
                    AutomationName="AI provider settings"
                    Click="OnAgentSettingsClick"
                    Icon="Bot"
                    IsActive="{Binding IsAgentSettingsVisible}"
                    Label="AI providers" />
                <components:ShellNavigationItem
                    AutomationName="MCP server settings"
                    Click="OnMcpSettingsClick"
                    Icon="Code"
                    IsActive="{Binding IsMcpSettingsVisible}"
                    Label="MCP servers" />
                <components:ShellNavigationItem
                    AutomationName="About GhostSHELL"
                    Click="OnAboutSettingsClick"
                    Icon="BookInformation"
                    IsActive="{Binding IsAboutSettingsVisible}"
                    Label="About" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
          <Grid Margin="{controls:Inset Horizontal=Xxl, Top=Xl, Bottom=Xxl}">
            <settingsPages:AppearanceSettingsPageView
                x:Name="AppearanceSettingsPage"
                IsVisible="{Binding IsAppearanceSettingsVisible}"
                AppearanceChanged="OnAppearanceChangedRequested"
                PickColorRequested="OnPickColorRequested"
                SelectTerminalPaletteRequested="OnSelectTerminalPaletteClick" />

            <StackPanel Spacing="{DynamicResource ShellSpaceXl}" IsVisible="{Binding IsWorkspaceSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto">
                <components:SettingsPageHeader
                    Heading="Workspaces &amp; saved screens"
                    Description="Edit persistent launch definitions. Runtime terminal instances remain independent." />
                <Button Grid.Column="1" Classes="PrimaryButton" Click="OnShowNewItemClick" Content="New definition" />
              </Grid>
              <controls:SurfaceCard Padding="0">
                <Grid
                    Margin="{controls:Inset Horizontal=Lg, Vertical=Md}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{DynamicResource ShellSpaceLg}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontWeight="SemiBold" Text="Restore sessions on start" />
                    <TextBlock
                        Classes="Muted"
                        Text="Reopen the tabs, panels, connections, and locations from the previous session."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Restore sessions on start"
                      IsChecked="{Binding RestoreSessionsOnStart, Mode=OneWay}"
                      IsCheckedChanged="OnRestoreSessionsOnStartChanged"
                      IsEnabled="{Binding CanChangeRestoreSessionsOnStart}" />
                </Grid>
              </controls:SurfaceCard>
              <controls:SurfaceCard Tone="Notice" Padding="0"
                  x:Name="SavedScreenDeleteUndoNotice"
                  IsVisible="{Binding SavedScreenDeleteUndo.HasPending}"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="{Binding SavedScreenDeleteUndo.Status}"
                  AutomationProperties.HelpText="Undo restores the exact saved definition that was deleted. Running screen instances are not changed.">
                <Grid Margin="{controls:Inset Md}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <TextBlock
                      VerticalAlignment="Center"
                      Text="{Binding SavedScreenDeleteUndo.Status}"
                      TextWrapping="Wrap" />
                  <Button
                      x:Name="UndoDeletedSavedScreenButton"
                      Grid.Column="1"
                      Classes="SecondaryButton"
                      Click="OnUndoDeletedSavedScreenClick"
                      Content="Undo"
                      IsEnabled="{Binding SavedScreenDeleteUndo.CanUndo}"
                      AutomationProperties.Name="Undo deleted saved screen"
                      AutomationProperties.HelpText="Restore the exact saved screen definition that was just deleted." />
                  <Button
                      Grid.Column="2"
                      Classes="TextButton"
                      Click="OnDismissSavedScreenDeleteUndoClick"
                      Content="Dismiss"
                      IsEnabled="{Binding SavedScreenDeleteUndo.CanUndo}"
                      AutomationProperties.Name="Dismiss saved screen delete notice" />
                </Grid>
              </controls:SurfaceCard>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="SectionHeading" Text="Workspaces" /><Button Grid.Column="1" Classes="TextButton Accent" Click="OnCreateWorkspaceClick" Content="New workspace" /></Grid>
                <ItemsControl ItemsSource="{Binding Workspaces}">
                  <ItemsControl.ItemTemplate><DataTemplate><controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}"><Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}"><Border Width="32" Height="32" Background="{Binding Accent}" CornerRadius="{DynamicResource ShellControlCornerRadius}"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="15" /></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Description}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><Button Classes="SecondaryButton" Click="OnEditWorkspaceClick" Content="Edit" /><Button Classes="IconButton Danger" Click="OnDeleteWorkspaceClick" IsVisible="{Binding CanDelete}" AutomationProperties.Name="Delete workspace"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel></Grid></controls:SurfaceCard></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="SectionHeading" Text="Saved screens" />
                <ItemsControl ItemsSource="{Binding Screens}">
                  <ItemsControl.ItemTemplate><DataTemplate><controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}"><Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}"><Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="14" /></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Description}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Layout, StringFormat={}Layout: {0}}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}"><Button Classes="SecondaryButton" Click="OnEditScreenClick" Content="Edit" /><Button Classes="IconButton Danger" Click="OnDeleteScreenClick" AutomationProperties.Name="Delete saved screen"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel></Grid></controls:SurfaceCard></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="SectionHeading" Text="Layouts" /><Button Grid.Column="1" Classes="TextButton Accent" Click="OnShowLayoutDesignerClick" Content="Open layout designer" /></Grid>
                <ItemsControl ItemsSource="{Binding Layouts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                        <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                          <Border Width="72" Height="44" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellInnerCornerRadius}" ClipToBounds="True">
                            <ItemsControl Margin="{DynamicResource ShellPreviewTileInset}" ItemsSource="{Binding PreviewPanels}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ScreenLayoutPreviewPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="{DynamicResource ShellHairlineInset}" Classes="ScreenPreviewPanel" Classes.primary="{Binding IsPrimary}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding GridSummary}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding SlotCount, StringFormat={}{0} slots}" />
                          <Button Grid.Column="3" VerticalAlignment="Center" Classes="SecondaryButton" Click="OnEditLayoutClick" Content="Edit" />
                        </Grid>
                      </controls:SurfaceCard>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="SectionHeading" Text="Definition portability" />
                <controls:SurfaceCard Padding="0">
                  <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ShellSpaceSm}" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Move your GhostShell setup" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Export or import connections, screens, layouts, profiles, themes, and keymaps as a strict JSON bundle." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                      <Button Classes="SecondaryButton" Click="OnExportDefinitionsClick" Content="Export…" AutomationProperties.Name="Export definitions" />
                      <Button Classes="PrimaryButton" Click="OnImportDefinitionsClick" Content="Import…" AutomationProperties.Name="Import definitions" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding DefinitionBundleStatus}" TextWrapping="Wrap" />
                  </Grid>
                </controls:SurfaceCard>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsKeybindingSettingsVisible}">
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <components:SettingsPageHeader
                    Heading="Keybindings"
                    Description="Record, unbind, reset, and validate application or terminal shortcuts. Blocking conflicts cannot be saved." />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ActiveApplicationKeymapName, StringFormat={}Active application profile · {0}}" />
              </StackPanel>

              <Grid ColumnDefinitions="*,320" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <ComboBox
                      Width="320"
                      ItemsSource="{Binding KeybindingProfiles}"
                      SelectedItem="{Binding SelectedKeybindingProfile, Mode=OneWay}"
                      SelectionChanged="OnKeybindingProfileSelectionChanged"
                      AutomationProperties.Name="Keybinding profile">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding LayerLabel}" />
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Classes="SecondaryButton" Click="OnCloneKeybindingPresetClick" Content="Clone preset" IsEnabled="{Binding CanCloneSelectedKeybindingProfile}" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Text="{Binding KeybindingEditorSession.Query}"
                    PlaceholderText="Search commands or shortcuts"
                    AutomationProperties.Name="Search keybindings" />
              </Grid>

              <controls:SurfaceCard Padding="0">
                <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock FontWeight="SemiBold" Text="{Binding KeybindingEditorSession.Name}" />
                      <Border Classes="Keycap"><TextBlock Text="{Binding SelectedKeybindingProfile.StateLabel}" /></Border>
                    </StackPanel>
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding KeybindingEditorSession.StateSummary}" />
                  </StackPanel>
                  <controls:StatusChip Grid.Column="1" Content="{Binding KeybindingEditorSession.ConflictCount, StringFormat={}{0} conflicts}" />
                  <controls:StatusChip Grid.Column="2" Content="{Binding KeybindingEditorSession.WarningCount, StringFormat={}{0} warnings}" />
                </Grid>
              </controls:SurfaceCard>

              <controls:SurfaceCard Padding="0" IsVisible="{Binding KeybindingEditorSession.IsApplicationLayer}">
                <Grid
                    Margin="{controls:Inset Lg}"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="{DynamicResource ShellSpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                    <StackPanel Classes="CardText" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Application prefix" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding KeybindingEditorSession.PrefixShortcut}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource ShellSpaceSm}"
                        IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}">
                      <TextBlock VerticalAlignment="Center" Text="Repeatable" />
                      <ToggleSwitch
                          x:Name="KeybindingPrefixRepeatable"
                          IsChecked="{Binding KeybindingEditorSession.PrefixRepeatable}"
                          IsCheckedChanged="OnKeybindingPrefixOptionsChanged"
                          AutomationProperties.Name="Repeatable prefix" />
                    </StackPanel>
                  </Grid>

                  <Grid
                      Grid.Row="1"
                      ColumnDefinitions="180,360,*,Auto"
                      ColumnSpacing="{DynamicResource ShellSpaceMd}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock Classes="Eyebrow" Text="Timeout (ms)" />
                      <NumericUpDown
                          x:Name="KeybindingPrefixTimeout"
                          Minimum="50"
                          Maximum="10000"
                          Increment="50"
                          Value="{Binding KeybindingEditorSession.PrefixTimeoutMilliseconds}"
                          IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}"
                          ValueChanged="OnKeybindingPrefixOptionsChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock Classes="Eyebrow" Text="On unknown sequence" />
                      <ComboBox
                          x:Name="KeybindingPrefixFailure"
                          ItemsSource="{Binding KeybindingEditorSession.FailedSequenceBehaviors}"
                          SelectedItem="{Binding KeybindingEditorSession.PrefixFailedBehavior}"
                          SelectionChanged="OnKeybindingPrefixOptionsChanged"
                          IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource ShellSpaceSm}">
                      <Button Classes="SecondaryButton" Click="OnRecordKeybindingPrefixClick" Content="Record prefix" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                      <Button Classes="TextButton" Click="OnClearKeybindingPrefixClick" Content="Clear" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </controls:SurfaceCard>

              <controls:SurfaceCard Padding="0">
                <Grid RowDefinitions="34,*">
                  <Grid ColumnDefinitions="130,*,190,130,90,220" Margin="{controls:Inset Horizontal=Md}" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <TextBlock Classes="Eyebrow" VerticalAlignment="Center" Text="Category" />
                    <TextBlock Grid.Column="1" Classes="Eyebrow" VerticalAlignment="Center" Text="Command" />
                    <TextBlock Grid.Column="2" Classes="Eyebrow" VerticalAlignment="Center" Text="Shortcut" />
                    <TextBlock Grid.Column="3" Classes="Eyebrow" VerticalAlignment="Center" Text="Context" />
                    <TextBlock Grid.Column="4" Classes="Eyebrow" VerticalAlignment="Center" Text="Status" />
                    <TextBlock Grid.Column="5" Classes="Eyebrow" VerticalAlignment="Center" Text="Actions" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding KeybindingEditorSession.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding IssueSummary}">
                          <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="130,*,190,130,90,220" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Category}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Shortcut}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Contexts}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding Status}" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                              <Button Classes="SecondaryButton" Click="OnRecordKeybindingClick" Content="Record" IsEnabled="{Binding CanEdit}" />
                              <Button Classes="TextButton" Click="OnUnbindKeybindingClick" Content="Unbind" IsEnabled="{Binding CanUnbind}" />
                              <Button Classes="TextButton" Click="OnResetKeybindingClick" Content="Reset" IsEnabled="{Binding CanResetShortcut}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <controls:EmptyStatePanel Grid.Row="1" Margin="{controls:Inset Xl}" IsVisible="{Binding KeybindingEditorSession.HasNoResults}"
                      ShowsGlyph="False"
                      Heading="No matching keybindings"
                      Body="Change the search query or choose another profile." />
                </Grid>
              </controls:SurfaceCard>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Unknown commands are preserved so older builds never erase newer bindings." />
                <Button Grid.Column="1" Classes="SecondaryButton" Click="OnResetAllKeybindingsClick" Content="Reset profile" IsEnabled="{Binding KeybindingEditorSession.CanEditRows}" />
                <Button Grid.Column="2" Classes="PrimaryButton" Click="OnSaveKeybindingsClick" Content="Save keybindings" IsEnabled="{Binding KeybindingEditorSession.CanSave}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsFilesSettingsVisible}">
              <components:SettingsPageHeader
                  Heading="Files &amp; transfers"
                  Description="Provider capabilities stay explicit; queued copies and moves are bounded, cancellable, and conflict-aware." />
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="SectionHeading" Text="Configured providers" /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnAddFileProviderClick" Content="Add provider" /></Grid>
                <ItemsControl ItemsSource="{Binding FileProviderDefinitions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                        <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                          <Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="14" /></Border>
                          <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Eyebrow" Text="{Binding Kind}" /></StackPanel><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding StatusDetail}" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}"><controls:StatusChip Content="{Binding Status}" /><Button Classes="SecondaryButton" Click="OnEditFileProviderClick" Content="Edit" /><Button Classes="IconButton Danger" Click="OnDeleteFileProviderClick" AutomationProperties.Name="Delete file provider"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel>
                        </Grid>
                      </controls:SurfaceCard>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:SurfaceCard Tone="Notice" Padding="0"><TextBlock Margin="{controls:Inset Md}" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Home is always available as a built-in local provider. Saved profiles persist in SQLite; credentials remain in the OS vault." TextWrapping="Wrap" /></controls:SurfaceCard>
              </StackPanel>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="SectionHeading" Text="Remote previews" />
                <controls:SurfaceCard Padding="0">
                  <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                    <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Auto-load previews up to" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                          Text="Selecting a remote file downloads it for preview. Files up to this size are fetched the moment they are selected; larger ones show a download action instead, so scrolling a listing never spends bandwidth you didn't ask to spend. Local files are unaffected — nothing is downloaded for them." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
                      <NumericUpDown Minimum="1" Maximum="256" Increment="1" Width="130" FormatString="0"
                          Value="{Binding FilePreviewSettingsEditor.AutoLoadThresholdMegabytes}"
                          AutomationProperties.Name="Auto-load preview threshold in megabytes" />
                      <TextBlock VerticalAlignment="Center" Classes="Muted" Text="MB" />
                    </StackPanel>
                  </Grid>
                </controls:SurfaceCard>
                <controls:SurfaceCard Padding="0">
                  <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                    <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Keep downloaded previews between runs" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                          Text="On: downloaded files are kept on disk so re-opening one is instant, even after a restart. Off: nothing about your remote files persists — small previews live only in memory, larger ones go into an encrypted container whose key exists only inside the running app, and both are destroyed on exit. Even a copy left behind by a crash is unreadable noise, because the key dies with the process." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                        IsChecked="{Binding FilePreviewSettingsEditor.KeepPreviewsBetweenRuns}"
                        AutomationProperties.Name="Keep downloaded previews between runs" />
                  </Grid>
                </controls:SurfaceCard>
                <controls:SurfaceCard Padding="0">
                  <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                    <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Preview cache size limit" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                          Text="The most disk the preview cache may hold. When it fills, the copies you haven't looked at longest are removed first. This bounds the cache; it never fails a preview." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
                      <NumericUpDown Minimum="16" Maximum="16384" Increment="128" Width="130" FormatString="0"
                          Value="{Binding FilePreviewSettingsEditor.CacheBudgetMegabytes}"
                          AutomationProperties.Name="Preview cache size limit in megabytes" />
                      <TextBlock VerticalAlignment="Center" Classes="Muted" Text="MB" />
                    </StackPanel>
                  </Grid>
                </controls:SurfaceCard>
                <controls:SurfaceCard Tone="Notice" Padding="0">
                  <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon Symbol="Delete" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted"
                        Text="{Binding FilePreviewSettingsEditor.CacheUsageText}" TextWrapping="Wrap" />
                    <Button Grid.Column="2" VerticalAlignment="Center" Classes="SecondaryButton"
                        Command="{Binding FilePreviewSettingsEditor.ClearCacheCommand}"
                        Content="Clear now" AutomationProperties.Name="Clear preview cache" />
                  </Grid>
                </controls:SurfaceCard>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsTerminalSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                <components:SettingsPageHeader
                    Heading="Terminal"
                    Description="Tune the stored renderer profile. Existing sessions keep the snapshot they launched with." />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Classes="PrimaryButton" Click="OnSaveTerminalProfileClick" Content="Save profile" />
              </Grid>

              <!-- Cursor and scrollback -->
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Cursor &amp; buffer" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="How the caret is drawn and how much history each session keeps." />
                </StackPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                  <controls:SurfaceCard>
                    <controls:LabeledField
                        Label="Cursor shape">
                      <ComboBox ItemsSource="{Binding TerminalSettingsEditor.CursorStyles}" SelectedItem="{Binding TerminalSettingsEditor.CursorStyle}" AutomationProperties.Name="Cursor shape" />

                    </controls:LabeledField>
                  </controls:SurfaceCard>
                  <controls:SurfaceCard Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock FontSize="{DynamicResource ShellFontSize12}" FontWeight="SemiBold" Text="Blink cursor" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TerminalSettingsEditor.CursorBlink, Converter={StaticResource OnOffConverter}}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding TerminalSettingsEditor.CursorBlink}" AutomationProperties.Name="Blink cursor" />
                    </Grid>
                  </controls:SurfaceCard>
                  <controls:SurfaceCard Grid.Column="2">
                    <controls:LabeledField
                        Label="Scrollback lines">
                      <NumericUpDown Minimum="0" Maximum="10000000" Increment="1000" Value="{Binding TerminalSettingsEditor.ScrollbackLines}" AutomationProperties.Name="Scrollback lines" />

                    </controls:LabeledField>
                  </controls:SurfaceCard>
                </Grid>
              </StackPanel>

              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceLg}">
                  <TextBlock Classes="SectionHeading" Text="INPUT &amp; SAFETY" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Clipboard read" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ClipboardAccessOptions}" SelectedItem="{Binding TerminalSettingsEditor.ClipboardRead}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Clipboard write" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ClipboardAccessOptions}" SelectedItem="{Binding TerminalSettingsEditor.ClipboardWrite}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Paste safety" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.PasteSafetyOptions}" SelectedItem="{Binding TerminalSettingsEditor.PasteSafety}" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Terminal keymap" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.TerminalKeymaps}" SelectedItem="{Binding TerminalSettingsEditor.SelectedKeymap}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Open terminal links" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.LinkPolicies}" SelectedItem="{Binding TerminalSettingsEditor.LinkPolicy}" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="{controls:Inset Bottom=Xs}" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                      <TextBlock VerticalAlignment="Center" Text="Enable IME input" />
                      <ToggleSwitch IsChecked="{Binding TerminalSettingsEditor.ImeEnabled}" AutomationProperties.Name="Enable IME input" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </controls:SurfaceCard>

              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <TextBlock Classes="SectionHeading" Text="INTEGRATION &amp; COMPATIBILITY" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Shell integration" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ShellIntegrationModes}" SelectedItem="{Binding TerminalSettingsEditor.ShellIntegration}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Bell" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.BellModes}" SelectedItem="{Binding TerminalSettingsEditor.BellMode}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Compatibility" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.CompatibilityProfiles}" SelectedItem="{Binding TerminalSettingsEditor.Compatibility}" /></StackPanel>
                  </Grid>
                  <controls:SurfaceCard Tone="Notice" Padding="0"><TextBlock Margin="{controls:Inset Md}" Classes="Muted" Text="Connection startup settings live with each saved connection or saved-screen panel; this profile only controls terminal behavior and rendering." TextWrapping="Wrap" /></controls:SurfaceCard>
                  </StackPanel>
              </controls:SurfaceCard>
            </StackPanel>

            <settingsPages:QuickTerminalSettingsPageView
                x:Name="QuickTerminalSettingsPage"
                IsVisible="{Binding IsQuickTerminalSettingsVisible}"
                SaveRequested="OnQuickTerminalSettingsSaveRequested" />

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsSecretsSettingsVisible}">
              <components:SettingsPageHeader
                  Heading="Security &amp; secrets"
                  Description="Credential values live only in the operating-system vault. GhostSHELL stores opaque references in definitions." />
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="SectionHeading" Text="Application security" />
                <controls:SurfaceCard Padding="0">
                  <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock FontWeight="SemiBold" Text="Enable app encryption" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                            Text="Encrypts everything the app itself writes: the configuration database and the on-disk preview cache. The keys are random, live only in the OS keystore, and are deleted when this is turned off — the files are converted in place, both directions, the moment the switch moves. This protects data at rest: a stolen disk image, a synced backup, another local account. It is not a lock on the running app." />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                            Text="{Binding ApplicationSecurityEditor.EncryptionAvailability}" />
                        <TextBlock Foreground="{DynamicResource ShellWarningBrush}" FontSize="{DynamicResource ShellFontSize10}" TextWrapping="Wrap"
                            Text="{Binding ApplicationSecurityEditor.StatusDetail}"
                            IsVisible="{Binding ApplicationSecurityEditor.HasStatusDetail}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding ApplicationSecurityEditor.IsEncryptionEnabled}"
                          IsEnabled="{Binding ApplicationSecurityEditor.IsEncryptionSupported}"
                          AutomationProperties.Name="Enable app encryption" />
                    </Grid>
                  </StackPanel>
                </controls:SurfaceCard>
              </StackPanel>
              <controls:SurfaceCard Tone="Notice" Padding="0"><Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}"><icons:SymbolIcon Symbol="Shield" FontSize="16" Foreground="{DynamicResource ShellWarningBrush}" /><TextBlock Grid.Column="1" Classes="Muted" Text="{Binding SecretVaultStatus}" TextWrapping="Wrap" /></Grid></controls:SurfaceCard>
              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <TextBlock Classes="SectionHeading" Text="New connection credential" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Connection" /><ComboBox x:Name="SecretConnectionPicker" ItemsSource="{Binding Connections}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Kind" /><ComboBox x:Name="SecretKindPicker" ItemsSource="{Binding SecretKinds}" SelectedIndex="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Label" /><TextBox x:Name="SecretLabelInput" PlaceholderText="Production password" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Value" /><TextBox x:Name="SecretValueInput" PasswordChar="●" PlaceholderText="Never displayed again" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="The connection editor uses the resulting opaque reference." /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateConnectionSecretClick" Content="Store credential" /></Grid>
                </StackPanel>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <TextBlock Classes="SectionHeading" Text="New file-provider credential" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="File provider" /><ComboBox x:Name="SecretFileProviderPicker" ItemsSource="{Binding FileProviderDefinitions}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Kind" /><ComboBox x:Name="FileProviderSecretKindPicker" ItemsSource="{Binding SecretKinds}" SelectedIndex="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Label" /><TextBox x:Name="FileProviderSecretLabelInput" PlaceholderText="Production provider credential" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Value" /><TextBox x:Name="FileProviderSecretValueInput" PasswordChar="●" PlaceholderText="Never displayed again" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Save the provider first, store its scoped credential here, then select the opaque reference while editing." TextWrapping="Wrap" /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateFileProviderSecretClick" Content="Store credential" /></Grid>
                </StackPanel>
              </controls:SurfaceCard>
              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="SectionHeading" Text="Stored metadata" />
                <ItemsControl ItemsSource="{Binding Secrets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                        <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,220,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                          <Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Key" FontSize="14" /></Border>
                          <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}"><TextBlock FontWeight="SemiBold" Text="{Binding Label}" /><TextBlock Classes="Eyebrow" Text="{Binding Kind}" /></StackPanel>
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Scope}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Dependencies}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LastUsed, StringFormat={}Last used: {0}}" />
                          </StackPanel>
                          <TextBox Grid.Column="2" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize9}" IsReadOnly="True" Text="{Binding Reference.Value}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                            <Button Classes="SecondaryButton" Click="OnEditSecretClick" Content="Manage" />
                            <Button Classes="IconButton Danger" Click="OnDeleteSecretClick" ToolTip.Tip="Delete credential" AutomationProperties.Name="Delete credential"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button>
                          </StackPanel>
                        </Grid>
                      </controls:SurfaceCard>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoSecrets}">
                  <controls:EmptyStatePanel Margin="{controls:Inset Lg}"
                      Glyph="Key"
                      Heading="No stored credentials"
                      Body="Credentials you store above appear here as opaque references." />
                </controls:SurfaceCard>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsAgentSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <components:SettingsPageHeader
                    Heading="AI providers"
                    Description="Native Anthropic and OpenAI-compatible adapters. Credentials resolve from the OS vault only for a bounded request." />
                <Button Grid.Column="1" VerticalAlignment="Center" Classes="PrimaryButton" Click="OnAddAiProviderClick" Content="Add provider" AutomationProperties.Name="Add AI provider" />
              </Grid>

              <ItemsControl ItemsSource="{Binding AiProviderDefinitions}" IsVisible="{Binding HasAiProviders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                        <Border Width="36" Height="36" Classes="IconTile">
                          <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Bot" FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="Eyebrow" Text="{Binding Kind}" />
                          </StackPanel>
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DefaultModel, StringFormat={}Default model: {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}">
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                            <TextBlock Classes="Eyebrow" Text="{Binding Order, StringFormat={}Order {0}}" />
                          </StackPanel>
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="SecondaryButton" Click="OnEditAiProviderClick" Content="Edit" />
                        <Button Grid.Column="4" Classes="IconButton Danger" Click="OnDeleteAiProviderClick" ToolTip.Tip="Delete AI provider" AutomationProperties.Name="Delete AI provider">
                          <icons:SymbolIcon Symbol="Delete" FontSize="13" />
                        </Button>
                      </Grid>
                    </controls:SurfaceCard>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoAiProviders}">
                <controls:EmptyStatePanel Margin="{controls:Inset Xl}"
                    Glyph="Bot"
                    Heading="No provider configured"
                    Body="Add a provider to enable the governed agent. Every run stays bound to its selected live panel scope and all panel actions pass through the capability broker.">
                  <Button HorizontalAlignment="Center" Classes="SecondaryButton" Click="OnAddAiProviderClick" Content="Add first provider" />
                </controls:EmptyStatePanel>
              </controls:SurfaceCard>

              <!-- The credential slot belongs to a saved profile, so with no
                   profile there is nothing to fill: the card stays visible to
                   explain the order, and its controls stay inert rather than
                   inviting a keystroke that cannot go anywhere. -->
              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}" IsEnabled="{Binding HasAiProviders}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="SectionHeading" Text="Store profile credential" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Save the profile first. Its opaque credential slot is fixed in the definition; this action fills that exact profile-scoped slot in the OS vault." TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Provider" />
                      <ComboBox x:Name="AiProviderSecretProfilePicker" ItemsSource="{Binding AiProviderDefinitions}" SelectedIndex="0">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Label" />
                      <TextBox x:Name="AiProviderSecretLabelInput" PlaceholderText="Provider API key" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <TextBox x:Name="AiProviderSecretValueInput" PasswordChar="●" PlaceholderText="API key · never displayed again" />
                    <Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateAiProviderSecretClick" Content="Store credential" />
                  </Grid>
                </StackPanel>
              </controls:SurfaceCard>

              <controls:SurfaceCard Tone="Notice" Padding="0">
                <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon Symbol="Shield" FontSize="17" Foreground="{DynamicResource ShellAccentBrush}" />
                  <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Provider output currently becomes text or inert tool proposals only. It has no terminal, process, filesystem, browser, or session-host authority." TextWrapping="Wrap" />
                </Grid>
              </controls:SurfaceCard>
            </StackPanel>

            <StackPanel x:Name="McpSettingsSection" Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsMcpSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <components:SettingsPageHeader
                    Heading="MCP servers"
                    Description="Native .NET stdio integrations for governed agent runs. Each server is a direct local process; no agent is installed on connected remote machines." />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="PrimaryButton"
                    Click="OnAddMcpServerClick"
                    Content="Add server"
                    AutomationProperties.Name="Add MCP server" />
              </Grid>

              <ItemsControl ItemsSource="{Binding McpServerDefinitions}" IsVisible="{Binding HasMcpServers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <controls:SurfaceCard Padding="0"
                        Margin="{controls:Inset Bottom=Sm}"
                        AutomationProperties.Name="{Binding Name, StringFormat={}MCP server {0}}">
                      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                        <Border Width="36" Height="36" Classes="IconTile">
                          <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Code" FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock
                              Classes="Muted"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding Executable}"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding Executable}" />
                          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ArgumentSummary}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding EnvironmentBindingSummary}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding EnabledToolSummary}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}">
                          <TextBlock
                              FontWeight="SemiBold"
                              Text="{Binding Status}"
                              AutomationProperties.LiveSetting="Polite"
                              AutomationProperties.Name="{Binding Status, StringFormat={}MCP server status · {0}}" />
                          <TextBlock
                              Classes="Muted"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding StatusDetail}"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Classes="SecondaryButton"
                            Click="OnTestMcpServerClick"
                            Content="{Binding TestActionLabel}"
                            IsEnabled="{Binding CanTest}"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Test MCP server {0}}" />
                        <Button
                            Grid.Column="4"
                            Classes="SecondaryButton"
                            Click="OnEditMcpServerClick"
                            Content="Edit"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Edit MCP server {0}}" />
                        <Button
                            Grid.Column="5"
                            Classes="IconButton Danger"
                            Click="OnDeleteMcpServerClick"
                            ToolTip.Tip="Delete MCP server"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Delete MCP server {0}}">
                          <icons:SymbolIcon Symbol="Delete" FontSize="13" />
                        </Button>
                      </Grid>
                    </controls:SurfaceCard>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoMcpServers}">
                <controls:EmptyStatePanel Margin="{controls:Inset Xl}"
                    Glyph="Code"
                    Heading="No MCP server configured"
                    Body="Add a trusted stdio server, map only the vault references it needs, and enable an exact tool allowlist. The agent cannot discover or call anything outside that saved boundary.">
                  <Button Classes="SecondaryButton" Click="OnAddMcpServerClick" Content="Add first server" AutomationProperties.Name="Add first MCP server" />
                </controls:EmptyStatePanel>
              </controls:SurfaceCard>

              <controls:SurfaceCard Padding="0">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock Classes="SectionHeading" Text="Store environment credential" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize10}"
                        Text="Save the server and its environment binding first. This fills that exact opaque SecretRef in the operating-system vault; the value is never displayed again."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Environment binding" />
                      <ComboBox
                          x:Name="McpEnvironmentSecretTargetPicker"
                          ItemsSource="{Binding McpEnvironmentSecretTargets}"
                          SelectedIndex="0"
                          AutomationProperties.Name="MCP environment binding">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Kind" />
                      <ComboBox
                          x:Name="McpServerSecretKindPicker"
                          ItemsSource="{Binding SecretKinds}"
                          SelectedIndex="0"
                          AutomationProperties.Name="MCP environment credential kind" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Label" />
                      <TextBox
                          x:Name="McpServerSecretLabelInput"
                          PlaceholderText="Server token"
                          AutomationProperties.Name="MCP environment credential label" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Value" />
                      <TextBox
                          x:Name="McpServerSecretValueInput"
                          PasswordChar="●"
                          PlaceholderText="Never displayed again"
                          AutomationProperties.Name="MCP environment credential value" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize10}"
                        Text="Only a selected profile-scoped binding can receive this value."
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Classes="PrimaryButton"
                        Click="OnCreateMcpServerSecretClick"
                        Content="Store credential"
                        IsEnabled="{Binding HasMcpEnvironmentSecretTargets}"
                        AutomationProperties.Name="Store MCP environment credential" />
                  </Grid>
                </StackPanel>
              </controls:SurfaceCard>

              <controls:SurfaceCard Tone="Notice" Padding="0">
                <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon Symbol="Shield" FontSize="17" Foreground="{DynamicResource ShellAccentBrush}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize10}"
                      Text="Settings shows saved configuration and the last bounded test result, not live MCP process state. Governed runs initialize eligible servers only when needed, and each MCP tool call requires explicit human approval."
                      TextWrapping="Wrap" />
                </Grid>
              </controls:SurfaceCard>
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsDiagnosticsSettingsVisible}">
              <components:SettingsPageHeader
                  Heading="Data &amp; diagnostics"
                  Description="Export bounded support information without terminal content, commands, credentials, or environment values." />
              <controls:SurfaceCard Padding="0">
                <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontWeight="SemiBold" Text="Getting started &amp; local privacy" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Review local shell and credential prerequisites, import durable definitions, or change bounded session-history retention." TextWrapping="Wrap" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HistoryRetentionStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Current session history privacy" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                    <Button Classes="SecondaryButton" Click="OnReviewOnboardingClick" Content="Review setup" AutomationProperties.Name="Review getting started setup" />
                    <Button Classes="SecondaryButton" Click="OnReviewHistoryPrivacyClick" Content="History privacy" AutomationProperties.Name="Open session history privacy controls" />
                  </StackPanel>
                </Grid>
              </controls:SurfaceCard>
              <views:LocalArtifactControlView x:Name="LocalArtifactControlView" />
              <views:RecoveryDataControlView x:Name="RecoveryDataControlView" />
              <views:DiagnosticsExportView x:Name="DiagnosticsExportView" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource ShellSpaceLg}" IsVisible="{Binding IsAboutSettingsVisible}">
              <components:SettingsPageHeader
                  Heading="About GhostSHELL"
                  Description="The native .NET agent can operate governed terminal, browser, and File Viewer panels. Actions stay scoped to exact live targets; risky mutations require explicit one-time approval." />

              <controls:SurfaceCard Padding="0">
                <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}" ColumnSpacing="{DynamicResource ShellSpaceXl}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Version" /><TextBlock FontWeight="SemiBold" Text="{Binding ApplicationVersion}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Platform" /><TextBlock Text="{Binding PlatformDescription}" /></StackPanel>
                  <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Runtime" /><TextBlock Text="{Binding RuntimeDescription}" /></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Agent runtime" /><TextBlock Text="{Binding AgentRuntimeDescription}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Target architecture: native .NET in process, without an external JavaScript runtime." TextWrapping="Wrap" /></StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Eyebrow" Text="Updates" /><TextBlock Text="{Binding UpdateStatus}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Install newer builds through the same channel that provided this copy." TextWrapping="Wrap" /></StackPanel>
                </Grid>
              </controls:SurfaceCard>

              <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="SectionHeading" Text="Open-source components" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Key runtime components are shown here; the bundled notice records the current managed inventory and release-license work still open." TextWrapping="Wrap" /></StackPanel>
                  <Button Grid.Column="1" Classes="SecondaryButton" Click="OnOpenThirdPartyNoticesClick" Content="Open bundled notices" AutomationProperties.Name="Open bundled third-party notices" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ProductComponents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                        <Grid Margin="{controls:Inset Md}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}" RowSpacing="{DynamicResource ShellSpaceSm}">
                          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Purpose}" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" VerticalAlignment="Top" Classes="Eyebrow" Text="Bundled" />
                          <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Margin="{controls:Inset Right=Lg}" Text="{Binding Version}" TextWrapping="Wrap" />
                            <TextBlock Classes="Muted" Text="{Binding License}" TextWrapping="Wrap" />
                          </WrapPanel>
                        </Grid>
                      </controls:SurfaceCard>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoProductComponents}">
                  <controls:EmptyStatePanel Margin="{controls:Inset Xl}"
                      ShowsGlyph="False"
                      Heading="No component inventory in this build"
                      Body="The bundled notices remain available and record the licences shipped with this copy." />
                </controls:SurfaceCard>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

</UserControl>
