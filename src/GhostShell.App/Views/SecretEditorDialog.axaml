<Window
    x:Class="GhostShell.App.Views.SecretEditorDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Width="560"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Manage credential">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="TopChrome">
      <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="Manage credential" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Values stay in the operating-system vault and are never displayed." />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceLg}">
      <controls:SurfaceCard Tone="Notice" Padding="0" x:Name="ValidationCard" IsVisible="False">
        <TextBlock x:Name="ValidationMessage" Margin="{controls:Inset Md}" Foreground="{DynamicResource ShellDangerBrush}" TextWrapping="Wrap" />
      </controls:SurfaceCard>
      <controls:SurfaceCard Tone="Notice" Padding="0">
        <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="OPAQUE REFERENCE" />
          <TextBox Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" IsReadOnly="True" Text="{Binding Secret.Reference.Value}" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Secret.Dependencies}" TextWrapping="Wrap" />
        </StackPanel>
      </controls:SurfaceCard>

      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="Label" />
        <TextBox Text="{Binding Label}" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Relabeling changes metadata only; dependent definitions keep the same opaque reference." />
      </StackPanel>

      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="Replacement value" />
        <TextBox PasswordChar="●" Text="{Binding ReplacementValue}" PlaceholderText="Enter a new value to rotate" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Rotation replaces the stored value in place, so dependencies do not need editing." />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button Grid.Column="1" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" />
        <Button Grid.Column="2" Classes="SecondaryButton" Click="OnRelabelClick" Content="Save label" />
        <Button Grid.Column="3" Classes="PrimaryButton" Click="OnRotateClick" Content="Rotate value" />
      </Grid>
    </Border>
  </Grid>
</Window>
