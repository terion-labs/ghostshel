<Window
    x:Class="GhostShell.App.Views.SavedScreenEditorDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="{Binding EditorTitle}"
    Width="900"
    Height="820"
    MinWidth="720"
    MinHeight="640"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="62,*,68">
    <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding EditorTitle}" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Choose a layout, then configure the panel assigned to each slot." />
      </StackPanel>
      <controls:StatusChip
          Grid.Column="1"
          VerticalAlignment="Center"
          Content="{Binding DirtyStatus}"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding DirtyStatus, StringFormat=Saved screen editor status: {0}}" />
      <Button Grid.Column="2" Classes="IconButton" Click="OnCancelClick" Content="×" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Close saved screen editor" />
    </Grid>

    <ScrollViewer Grid.Row="1" IsEnabled="{Binding CanEdit}">
      <StackPanel Margin="{controls:Inset Horizontal=Lg, Top=Sm, Bottom=Xl}" Spacing="{DynamicResource ShellSpaceMd}">
        <TextBlock Classes="SectionHeading" Text="Details" />
        <controls:SurfaceCard Padding="0">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Name" />
              <TextBox Text="{Binding Name}" AutomationProperties.Name="Saved screen name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Description" />
              <TextBox Text="{Binding Description}" AutomationProperties.Name="Saved screen description" />
            </StackPanel>
          </Grid>
        </controls:SurfaceCard>

        <TextBlock Classes="SectionHeading" Text="Layout" />
        <controls:SurfaceCard Padding="0">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,260" ColumnSpacing="{DynamicResource ShellSpaceLg}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Saved layout" />
              <ComboBox
                  ItemsSource="{Binding LayoutOptions}"
                  SelectedItem="{Binding SelectedLayout}"
                  AutomationProperties.Name="Layout for saved screen">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="Eyebrow" Text="Live structure" />
              <TextBlock Classes="Muted" Text="{Binding LayoutSummary}" TextWrapping="Wrap" />
            </StackPanel>
            <Border
                Grid.Column="1"
                Height="108"
                Background="{DynamicResource ShellBackgroundBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ShellControlCornerRadius}"
                ClipToBounds="True">
              <ItemsControl Margin="{controls:Inset Xs}" ItemsSource="{Binding PreviewPanels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:ScreenLayoutPreviewPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                        Margin="{controls:Inset Xs}"
                        Classes="ScreenPreviewPanel"
                        Classes.primary="{Binding IsPrimary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Tone="Notice" Padding="0" IsVisible="{Binding HasMissingLayout}">
          <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Foreground="{DynamicResource ShellDangerBrush}" FontWeight="Bold" Text="!" />
            <TextBlock
                Grid.Column="1"
                Classes="Muted"
                Text="The previous layout is unavailable. Choose an available layout before saving."
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="The saved screen layout is unavailable" />
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Tone="Notice" Padding="0" IsVisible="{Binding HasMissingDefinitions}">
          <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Foreground="{DynamicResource ShellDangerBrush}" FontWeight="Bold" Text="!" />
            <TextBlock
                Grid.Column="1"
                Classes="Muted"
                Text="{Binding MissingDefinitionCount, StringFormat={}{0} panel definition(s) must be repaired before saving.}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding MissingDefinitionCount, StringFormat={}{0} saved screen panel definition(s) require repair}" />
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Tone="Notice" Padding="0" IsVisible="{Binding HasInvalidBrowserAddresses}">
          <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Foreground="{DynamicResource ShellDangerBrush}" FontWeight="Bold" Text="!" />
            <TextBlock
                Grid.Column="1"
                Classes="Muted"
                Text="{Binding InvalidBrowserAddressCount, StringFormat={}{0} browser startup address(es) must be a complete HTTP or HTTPS URL.}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="One or more browser panel startup addresses are invalid" />
          </Grid>
        </controls:SurfaceCard>

        <TextBlock Classes="SectionHeading" Text="Agent policy" />
        <controls:SurfaceCard Padding="0">
          <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" Text="Override the agent policy for this saved screen" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding #ScreenAgentPolicyOverrideSwitch.IsChecked, Converter={StaticResource OnOffConverter}}" />
              </StackPanel>
              <ToggleSwitch
                  x:Name="ScreenAgentPolicyOverrideSwitch"
                  Grid.Column="1"
                  IsChecked="{Binding AgentPolicy.IsEnabled, Mode=TwoWay}"
                  AutomationProperties.Name="Override the AI agent policy for this saved screen" />
            </Grid>
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="Off, Ask, and Auto are durable. YOLO can only be enabled for a confirmed live run."
                TextWrapping="Wrap" />
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="{DynamicResource ShellSpaceSm}"
                IsVisible="{Binding AgentPolicy.IsEnabled}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" Text="Provider profile" />
                <ComboBox
                    ItemsSource="{Binding AgentPolicy.ProviderOptions}"
                    SelectedItem="{Binding AgentPolicy.SelectedProvider, Mode=TwoWay}"
                    AutomationProperties.Name="Saved screen agent policy provider profile">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" Text="Policy model" />
                <TextBox
                    MaxLength="256"
                    Text="{Binding AgentPolicy.Model, Mode=TwoWay}"
                    AutomationProperties.Name="Saved screen agent policy model" />
              </StackPanel>
            </Grid>
            <TextBlock
                Foreground="{DynamicResource ShellDangerBrush}"
                FontSize="{DynamicResource ShellFontSize9}"
                IsVisible="{Binding !AgentPolicy.IsValid}"
                Text="Choose an available, enabled provider profile and enter a valid model identifier."
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="The saved screen agent policy provider profile or model is invalid" />
            <ItemsControl
                ItemsSource="{Binding AgentPolicy.Capabilities}"
                IsVisible="{Binding AgentPolicy.IsEnabled}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="{controls:Inset Vertical=Xs}" ColumnDefinitions="*,180" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding DisplayName}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding DisplayName, StringFormat={}Saved screen agent permission for {0}}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </controls:SurfaceCard>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="SectionHeading" Text="PANELS &amp; CONNECTIONS" />
          <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Panels.Count, StringFormat={}{0} slots}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Panels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:SurfaceCard Padding="0" Margin="{controls:Inset Bottom=Sm}">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <Grid ColumnDefinitions="Auto,*,220" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <Border Width="28" Height="28" Classes="IconTile">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="#" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock Classes="Eyebrow" Text="{Binding PanelLabel}" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Panel identity follows this layout slot." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Panel type" />
                      <ComboBox
                          ItemsSource="{Binding KindOptions}"
                          SelectedItem="{Binding SelectedKind}"
                          AutomationProperties.Name="{Binding PanelLabel, StringFormat=Panel type for {0}}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Panel title" />
                      <TextBox Text="{Binding Title}" AutomationProperties.Name="{Binding PanelLabel, StringFormat=Title for {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding SupportsConnection}">
                      <TextBlock FontWeight="SemiBold" Text="Connection" />
                      <ComboBox ItemsSource="{Binding ApplicableConnectionOptions}" SelectedItem="{Binding SelectedConnection}" AutomationProperties.Name="{Binding PanelLabel, StringFormat=Connection for {0}}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding IsFileViewer}">
                      <TextBlock FontWeight="SemiBold" Text="File provider" />
                      <ComboBox ItemsSource="{Binding FileProviderOptions}" SelectedItem="{Binding SelectedFileProvider}" AutomationProperties.Name="{Binding PanelLabel, StringFormat=File provider for {0}}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding SupportsLocation}">
                    <TextBlock FontWeight="SemiBold" Text="Startup location" />
                    <TextBox
                        
                        Text="{Binding StartupLocation}"
                        PlaceholderText="Working directory, URL, or provider path"
                        AutomationProperties.Name="{Binding PanelLabel, StringFormat=Startup location for {0}}" />
                    <TextBlock
                        Foreground="{DynamicResource ShellDangerBrush}"
                        FontSize="{DynamicResource ShellFontSize9}"
                        IsVisible="{Binding HasInvalidBrowserAddress}"
                        Text="Enter a complete HTTP or HTTPS URL, or leave this empty for about:blank."
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Assertive" />
                  </StackPanel>
                  <Grid
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="{DynamicResource ShellSpaceMd}"
                      IsVisible="{Binding IsTerminal}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="Startup commands" />
                      <TextBox
                          MinHeight="82"
                          AcceptsReturn="True"
                          
                          Text="{Binding StartupCommands}"
                          TextWrapping="NoWrap"
                          PlaceholderText="One command per line"
                          AutomationProperties.Name="{Binding PanelLabel, StringFormat=Startup commands for {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" MinWidth="260" Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontWeight="SemiBold" Text="On delivery failure" />
                      <ComboBox
                          MinWidth="260"
                          ItemsSource="{Binding DeliveryFailurePolicyOptions}"
                          SelectedItem="{Binding SelectedDeliveryFailurePolicy, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding PanelLabel, StringFormat=Startup command delivery failure policy for {0}}"
                          AutomationProperties.HelpText="Governs delivery or acknowledgement failures while the terminal is live, not a shell command's exit status.">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock
                          Classes="Muted"
                          FontSize="{DynamicResource ShellFontSize9}"
                          Text="This governs delivery or acknowledgement failures while the terminal is live, not a shell command's exit status."
                          TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </controls:SurfaceCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            x:Name="ValidationError"
            Foreground="{DynamicResource ShellDangerBrush}"
            IsVisible="False"
            TextWrapping="Wrap"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="Saved screen validation error" />

        <controls:SurfaceCard Tone="Notice" Padding="0" IsVisible="{Binding HasPersistenceError}">
          <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <TextBlock Foreground="{DynamicResource ShellDangerBrush}" FontWeight="Bold" Text="!" />
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Foreground="{DynamicResource ShellDangerBrush}" Text="{Binding PersistenceErrorLabel}" />
              <TextBlock
                  Classes="Muted"
                  Text="{Binding PersistenceError.Message}"
                  TextWrapping="Wrap"
                  AutomationProperties.LiveSetting="Assertive"
                  AutomationProperties.Name="{Binding PersistenceError.Message, StringFormat=Saved screen persistence error: {0}}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Your draft is still open. Resolve the issue and retry." />
            </StackPanel>
          </Grid>
        </controls:SurfaceCard>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Saving changes only future opens; running instances stay independent." />
        <Button
            Grid.Column="1"
            MinWidth="96"
            Classes="SecondaryButton"
            Click="OnDuplicateClick"
            Content="Duplicate"
            IsEnabled="{Binding CanSave}"
            IsVisible="{Binding CanDuplicate}"
            AutomationProperties.Name="Duplicate saved screen" />
        <Button Grid.Column="2" MinWidth="92" Click="OnCancelClick" Content="Cancel" IsCancel="True" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Cancel saved screen editing" />
        <Button
            Grid.Column="3"
            MinWidth="120"
            Classes="PrimaryButton"
            Click="OnSaveClick"
            Content="{Binding PrimaryActionLabel}"
            IsDefault="True"
            IsEnabled="{Binding CanSave}"
            AutomationProperties.Name="{Binding PrimaryActionLabel}" />
      </Grid>
    </Border>
  </Grid>
</Window>
