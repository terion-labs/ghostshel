<Window
    x:Class="GhostShell.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:panelViews="using:GhostShell.App.Views.RuntimePanels"
    xmlns:views="using:GhostShell.App.Views"
    xmlns:vm="using:GhostShell.App.ViewModels"
    Title="GhostSHELL"
    Width="1440"
    Height="900"
    MinWidth="1080"
    MinHeight="680"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="44"
    WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:TerminalRuntimePanelViewModel">
      <panelViews:TerminalRuntimePanelView
          ApplicationKeyPressed="OnTerminalApplicationKeyPressed"
          CancelReconnectRequested="OnCancelConnectionReconnectClick"
          CloseRequested="OnCloseRuntimePanelClick"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed"
          RetryConnectionRequested="OnRetryConnectionPanelClick"
          SessionInitializationFailed="OnTerminalSessionInitializationFailed"
          SessionSnapshotChanged="OnTerminalSessionSnapshotChanged"
          TrustHostKeyRequested="OnTrustConnectionHostKeyClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:BrowserRuntimePanelViewModel">
      <panelViews:BrowserRuntimePanelView
          AddressKeyDown="OnBrowserAddressKeyDown"
          BackRequested="OnBrowserBackClick"
          BrowserStateChanged="OnBrowserStateChanged"
          CloseRequested="OnCloseRuntimePanelClick"
          ForwardRequested="OnBrowserForwardClick"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed"
          ReloadRequested="OnBrowserReloadClick"
          StopRequested="OnBrowserStopClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:FileRuntimePanelViewModel">
      <panelViews:FileRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          CreateFolderRequested="OnFileCreateFolderClick"
          DeleteRequested="OnFileDeleteClick"
          DismissOperationIssueRequested="OnDismissFileOperationIssueClick"
          DownloadRequested="OnFileDownloadClick"
          EntryDoubleTapped="OnFileEntryDoubleTapped"
          EntrySelectionChanged="OnFileEntrySelectionChanged"
          GotFocus="OnRuntimePanelGotFocus"
          LoadMoreRequested="OnFileLoadMoreClick"
          LocationKeyDown="OnFileLocationKeyDown"
          NavigateUpRequested="OnFileNavigateUpClick"
          OpenExternallyRequested="OnFileOpenExternallyClick"
          PointerPressed="OnRuntimePanelPointerPressed"
          ProfileSelectionChanged="OnFileProfileSelectionChanged"
          RefreshRequested="OnFileRefreshClick"
          RenameRequested="OnFileRenameClick"
          TransferRequested="OnFileTransferClick"
          UploadRequested="OnFileUploadClick" />
    </DataTemplate>

    <DataTemplate DataType="vm:StatisticsRuntimePanelViewModel">
      <panelViews:StatisticsRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:ProcessMonitorRuntimePanelViewModel">
      <panelViews:ProcessMonitorRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>

    <DataTemplate DataType="vm:UnavailableRuntimePanelViewModel">
      <panelViews:UnavailableRuntimePanelView
          CloseRequested="OnCloseRuntimePanelClick"
          GotFocus="OnRuntimePanelGotFocus"
          PointerPressed="OnRuntimePanelPointerPressed" />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid Background="{DynamicResource ShellBackgroundBrush}">
    <!-- Launcher -->
    <views:LauncherView
        x:Name="LauncherRouteView"
        AddConnectionRequested="OnAddConnectionClick"
        CancelHistoryExportRequested="OnCancelHistoryExportClick"
        ClearRecentSessionsRequested="OnClearRecentSessionsClick"
        DeleteConnectionRequested="OnDeleteConnectionClick"
        EditConnectionRequested="OnEditConnectionClick"
        EditScreenRequested="OnEditScreenClick"
        ExportAllHistoryRequested="OnExportAllHistoryClick"
        ExportFilteredHistoryRequested="OnExportFilteredHistoryClick"
        FinishOnboardingRequested="OnFinishOnboardingClick"
        HistorySearchKeyDownRequested="OnHistorySearchKeyDown"
        ImportDefinitionsRequested="OnImportDefinitionsClick"
        IsVisible="{Binding IsLauncherVisible}"
        LauncherConnectionsRequested="OnLauncherConnectionsClick"
        LauncherHistoryRequested="OnLauncherHistoryClick"
        LauncherHomeRequested="OnLauncherHomeClick"
        LauncherScreensRequested="OnLauncherScreensClick"
        OpenConnectionRequested="OnOpenConnectionClick"
        OpenRecentSessionRequested="OnOpenRecentSessionClick"
        OpenScreenRequested="OnOpenScreenClick"
        OpenSelectedHistorySessionRequested="OnOpenSelectedHistorySessionClick"
        ResetRecentSessionHistoryRequested="OnResetRecentSessionHistoryClick"
        RetryOnboardingRequested="OnRetryOnboardingClick"
        RetryRecentSessionHistoryRequested="OnRetryRecentSessionHistoryClick"
        ReviewHistoryPrivacyRequested="OnReviewHistoryPrivacyClick"
        SaveHistoryRetentionRequested="OnSaveHistoryRetentionClick"
        ShowCommandPaletteRequested="OnShowCommandPaletteClick"
        ShowNewItemRequested="OnShowNewItemClick"
        ShowSettingsRequested="OnShowSettingsClick" />

    <!-- Runtime workspace -->
    <views:WorkspaceView
        x:Name="WorkspaceRouteView"
        ActivateTabRequested="OnActivateTabClick"
        AgentQuestionResponseKeyDownRequested="OnAgentQuestionResponseKeyDown"
        ApproveAgentActionRequested="OnApproveAgentActionClick"
        CancelAgentActionRequested="OnCancelAgentActionClick"
        CancelAgentChatRequested="OnCancelAgentChatClick"
        ClearAgentChatRequested="OnClearAgentChatClick"
        CloseRuntimeTabRequested="OnCloseRuntimeTabClick"
        DeclineAgentQuestionRequested="OnDeclineAgentQuestionClick"
        DenyAgentActionRequested="OnDenyAgentActionClick"
        DisableAgentYoloRequested="OnDisableAgentYoloClick"
        EnableAgentCapabilityAskRequested="OnEnableAgentCapabilityAskClick"
        EnableAgentYoloRequested="OnEnableAgentYoloClick"
        IsVisible="{Binding IsWorkspaceVisible}"
        KeepAgentCapabilityOffRequested="OnKeepAgentCapabilityOffClick"
        LoadOlderAgentAuditRequested="OnLoadOlderAgentAuditClick"
        OpenWorkspaceRequested="OnOpenWorkspaceClick"
        RefreshAgentAuditRequested="OnRefreshAgentAuditClick"
        RuntimeTabDragEnterRequested="OnRuntimeTabDragEnter"
        RuntimeTabDragLeaveRequested="OnRuntimeTabDragLeave"
        RuntimeTabDragOverRequested="OnRuntimeTabDragOver"
        RuntimeTabDragPointerCaptureLostRequested="OnRuntimeTabDragPointerCaptureLost"
        RuntimeTabDragPointerMovedRequested="OnRuntimeTabDragPointerMoved"
        RuntimeTabDragPointerPressedRequested="OnRuntimeTabDragPointerPressed"
        RuntimeTabDragPointerReleasedRequested="OnRuntimeTabDragPointerReleased"
        RuntimeTabDropRequested="OnRuntimeTabDrop"
        SendAgentChatRequested="OnSendAgentChatClick"
        ShowAgentSettingsRequested="OnShowAgentSettingsClick"
        ShowCommandPaletteRequested="OnShowCommandPaletteClick"
        ShowLauncherRequested="OnShowLauncherClick"
        ShowNewItemRequested="OnShowNewItemClick"
        ShowNewPanelRequested="OnShowNewPanelClick"
        ShowSettingsRequested="OnShowSettingsClick"
        SubmitAgentQuestionRequested="OnSubmitAgentQuestionClick"
        ToggleAgentRequested="OnToggleAgentClick" />

    <!-- Settings -->
    <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="56,*">
      <Border Classes="TopChrome">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding WindowTitleBarContentMargin}" ColumnSpacing="10">
          <Button x:Name="SettingsBackButton" Classes="IconButton Large" Click="OnSettingsBackClick" ToolTip.Tip="Back" AutomationProperties.Name="Leave settings"><icons:SymbolIcon Symbol="ArrowLeft" FontSize="16" /></Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Stored locally for this profile" />
          </StackPanel>
          <Button Grid.Column="2" Classes="TextButton" Click="OnShowCommandPaletteClick" Content="{Binding CommandPaletteSettingsAction}" />
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="236,*">
        <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,20" Spacing="6">
              <TextBlock Margin="10,0,0,8" Classes="SectionHeading" Text="PREFERENCES" />
              <Button Classes="NavButton" Classes.active="{Binding IsAppearanceSettingsVisible}" Click="OnAppearanceSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Color" FontSize="15" /><TextBlock Text="Appearance" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsWorkspaceSettingsVisible}" Click="OnWorkspaceSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Window" FontSize="15" /><TextBlock Text="Workspaces &amp; screens" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsKeybindingSettingsVisible}" Click="OnKeybindingSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Keyboard" FontSize="15" /><TextBlock Text="Keybindings" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsFilesSettingsVisible}" Click="OnFilesSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Folder" FontSize="15" /><TextBlock Text="Files &amp; transfers" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsTerminalSettingsVisible}" Click="OnTerminalSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="WindowConsole" FontSize="15" /><TextBlock Text="Terminal" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsQuickTerminalSettingsVisible}" Click="OnQuickTerminalSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="WindowConsole" FontSize="15" /><TextBlock Text="Quick Terminal" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsSecretsSettingsVisible}" Click="OnSecretsSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Key" FontSize="15" /><TextBlock Text="Secrets" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsDiagnosticsSettingsVisible}" Click="OnDiagnosticsSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="DocumentBulletList" FontSize="15" /><TextBlock Text="Data &amp; diagnostics" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsAgentSettingsVisible}" Click="OnAgentSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Bot" FontSize="15" /><TextBlock Text="AI providers" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsMcpSettingsVisible}" Click="OnMcpSettingsClick" AutomationProperties.Name="MCP server settings"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="Code" FontSize="15" /><TextBlock Text="MCP servers" /></StackPanel></Button>
              <Button Classes="NavButton" Classes.active="{Binding IsAboutSettingsVisible}" Click="OnAboutSettingsClick"><StackPanel Orientation="Horizontal" Spacing="10"><icons:SymbolIcon Symbol="BookInformation" FontSize="15" /><TextBlock Text="About" /></StackPanel></Button>
              <Border Height="1" Margin="4,12" Background="{DynamicResource ShellBorderBrush}" />
              <TextBlock Margin="10,0" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Headless mode and ACP will use these same definitions in a later milestone." TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Column="1">
          <Grid Margin="44,34,56,60">
            <StackPanel Spacing="22" IsVisible="{Binding IsAppearanceSettingsVisible}">
              <StackPanel Spacing="5">
                <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Appearance" />
                <TextBlock Classes="Muted" Text="Follow the host automatically or select an explicit cross-platform profile." />
              </StackPanel>
              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="16">
                  <Grid ColumnDefinitions="*,280" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                    <StackPanel Spacing="3"><TextBlock FontWeight="SemiBold" Text="Color mode" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Automatic updates when the host color scheme changes." /></StackPanel>
                    <ComboBox x:Name="AppearanceModePicker" Grid.Column="1"><ComboBoxItem Content="System" /><ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" /></ComboBox>
                    <StackPanel Grid.Row="1" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Platform profile" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Automatic selects the closest host-native treatment. Custom preserves imported profiles with the default metrics." TextWrapping="Wrap" /></StackPanel>
                    <ComboBox x:Name="PlatformProfilePicker" Grid.Row="1" Grid.Column="1" />
                    <StackPanel Grid.Row="2" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Accent" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Use the host accent when available, with bronze fallback." /></StackPanel>
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,96" ColumnSpacing="8"><ComboBox x:Name="AccentModePicker" SelectionChanged="OnAccentModeSelectionChanged"><ComboBoxItem Content="Follow host" /><ComboBoxItem Content="GhostSHELL bronze" /><ComboBoxItem Content="Custom" /></ComboBox><TextBox x:Name="CustomAccentText" Grid.Column="1" /></Grid>
                    <StackPanel Grid.Row="3" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Application text size" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Follow the host or enlarge every GhostSHELL window. Saved changes apply live." TextWrapping="Wrap" /></StackPanel>
                    <ComboBox x:Name="ApplicationTextScalePicker" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Application text size"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource ShellBorderBrush}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3"><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="CURRENT STORED PROFILE" /><TextBlock Classes="Monospace" Text="{Binding ThemeMode, StringFormat={}Mode: {0}}" /><TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ThemeProfile, StringFormat={}Platform: {0}}" /><TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ThemeTextScale, StringFormat={}Text size: {0}}" /><TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{DynamicResource ShellAppearanceStatus}" /><TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{DynamicResource ShellAccentStatus}" /></StackPanel>
                    <Button Grid.Column="1" Classes="PrimaryButton" Click="OnSaveAppearanceClick" Content="Save appearance" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="22" IsVisible="{Binding IsWorkspaceSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5"><TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Workspaces &amp; saved screens" /><TextBlock Classes="Muted" Text="Edit persistent launch definitions. Runtime terminal instances remain independent." /></StackPanel>
                <Button Grid.Column="1" Classes="PrimaryButton" Click="OnShowNewItemClick" Content="New definition" />
              </Grid>
              <Border
                  x:Name="SavedScreenDeleteUndoNotice"
                  Classes="NoticeCard"
                  IsVisible="{Binding SavedScreenDeleteUndo.HasPending}"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="{Binding SavedScreenDeleteUndo.Status}"
                  AutomationProperties.HelpText="Undo restores the exact saved definition that was deleted. Running screen instances are not changed.">
                <Grid Margin="14,11" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock
                      VerticalAlignment="Center"
                      Text="{Binding SavedScreenDeleteUndo.Status}"
                      TextWrapping="Wrap" />
                  <Button
                      x:Name="UndoDeletedSavedScreenButton"
                      Grid.Column="1"
                      Classes="SecondaryButton"
                      Click="OnUndoDeletedSavedScreenClick"
                      Content="Undo"
                      IsEnabled="{Binding SavedScreenDeleteUndo.CanUndo}"
                      AutomationProperties.Name="Undo deleted saved screen"
                      AutomationProperties.HelpText="Restore the exact saved screen definition that was just deleted." />
                  <Button
                      Grid.Column="2"
                      Classes="TextButton"
                      Click="OnDismissSavedScreenDeleteUndoClick"
                      Content="Dismiss"
                      IsEnabled="{Binding SavedScreenDeleteUndo.CanUndo}"
                      AutomationProperties.Name="Dismiss saved screen delete notice" />
                </Grid>
              </Border>
              <StackPanel Spacing="10">
                <TextBlock Classes="SectionHeading" Text="WORKSPACES" />
                <ItemsControl ItemsSource="{Binding Workspaces}">
                  <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Classes="SettingsCard"><Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Width="32" Height="32" Background="{Binding Accent}" CornerRadius="8"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="15" /></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Description}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Button Classes="SecondaryButton" Click="OnEditWorkspaceClick" Content="Edit" /><Button Classes="DangerButton" Click="OnDeleteWorkspaceClick" AutomationProperties.Name="Delete workspace"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="10">
                <TextBlock Classes="SectionHeading" Text="SAVED SCREENS" />
                <ItemsControl ItemsSource="{Binding Screens}">
                  <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Classes="SettingsCard"><Grid Margin="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="14" /></Border><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Description}" /><TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Layout, StringFormat={}Layout: {0}}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Button Classes="SecondaryButton" Click="OnEditScreenClick" Content="Edit" /><Button Classes="DangerButton" Click="OnDeleteScreenClick" AutomationProperties.Name="Delete saved screen"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="SectionHeading" Text="LAYOUTS" /><Button Grid.Column="1" Classes="TextButton Accent" Click="OnShowLayoutDesignerClick" Content="Open layout designer" /></Grid>
                <ItemsControl ItemsSource="{Binding Layouts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Classes="ListCard">
                        <Grid Margin="14,11" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Rows, StringFormat={}{0} rows}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding SlotCount, StringFormat={}{0} SLOTS}" />
                          <Button Grid.Column="2" Classes="SecondaryButton" Click="OnEditLayoutClick" Content="Edit" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="10">
                <TextBlock Classes="SectionHeading" Text="DEFINITION PORTABILITY" />
                <Border Classes="SettingsCard">
                  <Grid Margin="15,13" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="18">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Move your GhostShell setup" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Export or import connections, screens, layouts, profiles, themes, and keymaps as a strict JSON bundle." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Classes="SecondaryButton" Click="OnExportDefinitionsClick" Content="Export…" AutomationProperties.Name="Export definitions" />
                      <Button Classes="PrimaryButton" Click="OnImportDefinitionsClick" Content="Import…" AutomationProperties.Name="Import definitions" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding DefinitionBundleStatus}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsKeybindingSettingsVisible}">
              <StackPanel Spacing="5">
                <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Keybindings" />
                <TextBlock Classes="Muted" Text="Record, unbind, reset, and validate application or terminal shortcuts. Blocking conflicts cannot be saved." />
                <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ActiveApplicationKeymapName, StringFormat={}ACTIVE APPLICATION PROFILE · {0}}" />
              </StackPanel>

              <Grid ColumnDefinitions="280,Auto,*,240" ColumnSpacing="10">
                <ComboBox
                    ItemsSource="{Binding KeybindingProfiles}"
                    SelectedItem="{Binding SelectedKeybindingProfile, Mode=OneWay}"
                    SelectionChanged="OnKeybindingProfileSelectionChanged"
                    AutomationProperties.Name="Keybinding profile">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding LayerLabel}" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="SecondaryButton" Click="OnCloneKeybindingPresetClick" Content="Clone preset" IsEnabled="{Binding CanCloneSelectedKeybindingProfile}" />
                <TextBox Grid.Column="3" Text="{Binding KeybindingEditorSession.Query}" PlaceholderText="Search commands or shortcuts" AutomationProperties.Name="Search keybindings" />
              </Grid>

              <Border Classes="SettingsCard">
                <Grid Margin="15,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontWeight="SemiBold" Text="{Binding KeybindingEditorSession.Name}" />
                      <Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding SelectedKeybindingProfile.StateLabel}" /></Border>
                    </StackPanel>
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding KeybindingEditorSession.StateSummary}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="StatusPill"><TextBlock Text="{Binding KeybindingEditorSession.ConflictCount, StringFormat={}{0} conflicts}" /></Border>
                  <Border Grid.Column="2" Classes="StatusPill"><TextBlock Text="{Binding KeybindingEditorSession.WarningCount, StringFormat={}{0} warnings}" /></Border>
                </Grid>
              </Border>

              <Border Classes="SettingsCard" IsVisible="{Binding KeybindingEditorSession.IsApplicationLayer}">
                <Grid Margin="15,12" ColumnDefinitions="*,170,150,210,Auto,Auto" ColumnSpacing="10">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Application prefix" />
                    <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding KeybindingEditorSession.PrefixShortcut}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="Eyebrow" Text="TIMEOUT (MS)" />
                    <NumericUpDown x:Name="KeybindingPrefixTimeout" Minimum="50" Maximum="10000" Increment="50" Value="{Binding KeybindingEditorSession.PrefixTimeoutMilliseconds}" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" ValueChanged="OnKeybindingPrefixOptionsChanged" />
                  </StackPanel>
                  <CheckBox x:Name="KeybindingPrefixRepeatable" Grid.Column="2" VerticalAlignment="Center" Content="Repeatable" IsChecked="{Binding KeybindingEditorSession.PrefixRepeatable}" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" Click="OnKeybindingPrefixOptionsChanged" />
                  <ComboBox x:Name="KeybindingPrefixFailure" Grid.Column="3" ItemsSource="{Binding KeybindingEditorSession.FailedSequenceBehaviors}" SelectedItem="{Binding KeybindingEditorSession.PrefixFailedBehavior}" SelectionChanged="OnKeybindingPrefixOptionsChanged" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                  <Button Grid.Column="4" Classes="SecondaryButton" Click="OnRecordKeybindingPrefixClick" Content="Record prefix" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                  <Button Grid.Column="5" Classes="TextButton" Click="OnClearKeybindingPrefixClick" Content="Clear" IsEnabled="{Binding KeybindingEditorSession.CanEditPrefix}" />
                </Grid>
              </Border>

              <Border Classes="SettingsCard">
                <Grid RowDefinitions="34,*">
                  <Grid ColumnDefinitions="130,*,190,130,90,220" Margin="14,0" ColumnSpacing="10">
                    <TextBlock Classes="Eyebrow" VerticalAlignment="Center" Text="CATEGORY" />
                    <TextBlock Grid.Column="1" Classes="Eyebrow" VerticalAlignment="Center" Text="COMMAND" />
                    <TextBlock Grid.Column="2" Classes="Eyebrow" VerticalAlignment="Center" Text="SHORTCUT" />
                    <TextBlock Grid.Column="3" Classes="Eyebrow" VerticalAlignment="Center" Text="CONTEXT" />
                    <TextBlock Grid.Column="4" Classes="Eyebrow" VerticalAlignment="Center" Text="STATUS" />
                    <TextBlock Grid.Column="5" Classes="Eyebrow" VerticalAlignment="Center" Text="ACTIONS" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding KeybindingEditorSession.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0" ToolTip.Tip="{Binding IssueSummary}">
                          <Grid Margin="14,8" ColumnDefinitions="130,*,190,130,90,220" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Category}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Shortcut}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Contexts}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding Status}" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5">
                              <Button Classes="SecondaryButton" Click="OnRecordKeybindingClick" Content="Record" IsEnabled="{Binding CanEdit}" />
                              <Button Classes="TextButton" Click="OnUnbindKeybindingClick" Content="Unbind" IsEnabled="{Binding CanUnbind}" />
                              <Button Classes="TextButton" Click="OnResetKeybindingClick" Content="Reset" IsEnabled="{Binding CanResetShortcut}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Grid.Row="1" Margin="24" HorizontalAlignment="Center" Spacing="5" IsVisible="{Binding KeybindingEditorSession.HasNoResults}">
                    <TextBlock FontWeight="SemiBold" Text="No matching keybindings" />
                    <TextBlock Classes="Muted" Text="Change the search query or choose another profile." />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Unknown commands are preserved so older builds never erase newer bindings." />
                <Button Grid.Column="1" Classes="SecondaryButton" Click="OnResetAllKeybindingsClick" Content="Reset profile" IsEnabled="{Binding KeybindingEditorSession.CanEditRows}" />
                <Button Grid.Column="2" Classes="PrimaryButton" Click="OnSaveKeybindingsClick" Content="Save keybindings" IsEnabled="{Binding KeybindingEditorSession.CanSave}" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsFilesSettingsVisible}">
              <StackPanel Spacing="5"><TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Files &amp; transfers" /><TextBlock Classes="Muted" Text="Provider capabilities stay explicit; queued copies and moves are bounded, cancellable, and conflict-aware." /></StackPanel>
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="SectionHeading" Text="CONFIGURED PROVIDERS" /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnAddFileProviderClick" Content="Add provider" /></Grid>
                <ItemsControl ItemsSource="{Binding FileProviderDefinitions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Classes="SettingsCard">
                        <Grid Margin="14,11" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="14" /></Border>
                          <StackPanel Grid.Column="1" Spacing="2"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Eyebrow" Text="{Binding Kind}" /></StackPanel><TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding StatusDetail}" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"><Border Classes="StatusPill"><TextBlock Text="{Binding Status}" /></Border><Button Classes="SecondaryButton" Click="OnEditFileProviderClick" Content="Edit" /><Button Classes="DangerButton" Click="OnDeleteFileProviderClick" AutomationProperties.Name="Delete file provider"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button></StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="NoticeCard"><TextBlock Margin="14" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Home is always available as a built-in local provider. Saved profiles persist in SQLite; credentials remain in the OS vault." TextWrapping="Wrap" /></Border>
              </StackPanel>
              <StackPanel Spacing="9">
                <TextBlock Classes="SectionHeading" Text="TRANSFER QUEUE" />
                <Border Classes="NoticeCard" IsVisible="{Binding HasNoFileTransfers}">
                  <StackPanel Margin="18" HorizontalAlignment="Center" Spacing="6"><icons:SymbolIcon HorizontalAlignment="Center" Symbol="Info" FontSize="20" Foreground="{DynamicResource ShellMutedBrush}" /><TextBlock FontWeight="SemiBold" Text="No transfers yet" /><TextBlock Classes="Muted" Text="Select a regular file in a File Viewer panel and choose Transfer." /></StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding FileTransfers}" IsVisible="{Binding HasFileTransfers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Classes="SettingsCard">
                        <Grid Margin="14,11" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="Eyebrow" Text="{Binding Operation}" /><TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Source}" /><icons:SymbolIcon Symbol="ArrowRight" FontSize="12" /><TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Destination}" /></StackPanel>
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Stage}" />
                            <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Progress}" />
                            <TextBlock Foreground="{DynamicResource ShellDangerBrush}" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <Border Classes="StatusPill"><TextBlock Text="{Binding State}" /></Border>
                            <Button Classes="SecondaryButton" Click="OnCancelFileTransferClick" Content="Cancel" IsVisible="{Binding CanCancel}" />
                            <Button Classes="SecondaryButton" Click="OnRetryFileTransferClick" Content="Retry" IsVisible="{Binding CanRetry}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsTerminalSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Terminal" />
                  <TextBlock Classes="Muted" Text="Tune the stored renderer profile. Existing sessions keep the snapshot they launched with." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Classes="PrimaryButton" Click="OnSaveTerminalProfileClick" Content="Save profile" />
              </Grid>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="16">
                  <TextBlock Classes="SectionHeading" Text="TYPE &amp; CURSOR" />
                  <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Font family" /><TextBox Text="{Binding TerminalSettingsEditor.FontFamily}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Font size" /><NumericUpDown Minimum="6" Maximum="96" Increment="0.5" Value="{Binding TerminalSettingsEditor.FontSize}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Line height" /><NumericUpDown Minimum="0.8" Maximum="3" Increment="0.05" Value="{Binding TerminalSettingsEditor.LineHeight}" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Scrollback" /><NumericUpDown Minimum="0" Maximum="10000000" Increment="1000" Value="{Binding TerminalSettingsEditor.ScrollbackLines}" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Cursor shape" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.CursorStyles}" SelectedItem="{Binding TerminalSettingsEditor.CursorStyle}" /></StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8" IsChecked="{Binding TerminalSettingsEditor.CursorBlink}" Content="Blink cursor" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="TERMINAL PALETTE" />
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Foreground" /><TextBox Classes="Monospace" Text="{Binding TerminalSettingsEditor.Foreground}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Background" /><TextBox Classes="Monospace" Text="{Binding TerminalSettingsEditor.Background}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Cursor" /><TextBox Classes="Monospace" Text="{Binding TerminalSettingsEditor.Cursor}" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Selection" /><TextBox Classes="Monospace" Text="{Binding TerminalSettingsEditor.Selection}" /></StackPanel>
                  </Grid>
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Use six-digit RGB values such as #E8E4DE. The profile’s sixteen ANSI colors remain unchanged." />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="16">
                  <TextBlock Classes="SectionHeading" Text="INPUT &amp; SAFETY" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Clipboard read" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ClipboardAccessOptions}" SelectedItem="{Binding TerminalSettingsEditor.ClipboardRead}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Clipboard write" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ClipboardAccessOptions}" SelectedItem="{Binding TerminalSettingsEditor.ClipboardWrite}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Paste safety" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.PasteSafetyOptions}" SelectedItem="{Binding TerminalSettingsEditor.PasteSafety}" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Terminal keymap" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.TerminalKeymaps}" SelectedItem="{Binding TerminalSettingsEditor.SelectedKeymap}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Open terminal links" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.LinkPolicies}" SelectedItem="{Binding TerminalSettingsEditor.LinkPolicy}" /></StackPanel>
                    <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8" IsChecked="{Binding TerminalSettingsEditor.ImeEnabled}" Content="Enable IME input" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="INTEGRATION &amp; COMPATIBILITY" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Shell integration" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.ShellIntegrationModes}" SelectedItem="{Binding TerminalSettingsEditor.ShellIntegration}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Bell" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.BellModes}" SelectedItem="{Binding TerminalSettingsEditor.BellMode}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Compatibility" /><ComboBox ItemsSource="{Binding TerminalSettingsEditor.CompatibilityProfiles}" SelectedItem="{Binding TerminalSettingsEditor.Compatibility}" /></StackPanel>
                  </Grid>
                  <Border Classes="NoticeCard"><TextBlock Margin="14" Classes="Muted" Text="Connection startup settings live with each saved connection or saved-screen panel; this profile only controls terminal behavior and rendering." TextWrapping="Wrap" /></Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsQuickTerminalSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Quick Terminal" />
                  <TextBlock Classes="Muted" Text="Configure the global drop-down independently from normal workspace windows." />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Classes="PrimaryButton" Click="OnSaveQuickTerminalSettingsClick" Content="Save settings" />
              </Grid>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="ACTIVATION" />
                  <Grid ColumnDefinitions="*,280" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="Global hotkey" />
                      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding QuickTerminalSettingsEditor.HotkeyHelpText}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="Monospace" Text="{Binding QuickTerminalSettingsEditor.HotkeyText}" />
                  </Grid>
                  <Border Height="1" Background="{DynamicResource ShellBorderBrush}" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding QuickTerminalSettingsEditor.RegistrationStatusBrush}" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding QuickTerminalSettingsEditor.RegistrationStatus}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="DISPLAY &amp; SIZE" />
                  <Grid ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="18">
                    <StackPanel Spacing="3"><TextBlock FontWeight="SemiBold" Text="Show on display" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Follow the GhostSHELL window or always use the primary display." /></StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding QuickTerminalSettingsEditor.MonitorPolicies}" SelectedItem="{Binding QuickTerminalSettingsEditor.MonitorPolicy}" />
                    <StackPanel Grid.Row="1" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Panel height" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Percentage of the selected display's working area." /></StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Minimum="25" Maximum="90" Increment="1" Value="{Binding QuickTerminalSettingsEditor.HeightPercent}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Monospace Muted" Text="%" /></Grid>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="BACKGROUND" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Window opacity (%)" /><NumericUpDown Minimum="30" Maximum="100" Increment="1" Value="{Binding QuickTerminalSettingsEditor.OpacityPercent}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Background blur (px)" /><NumericUpDown Minimum="0" Maximum="100" Increment="1" Value="{Binding QuickTerminalSettingsEditor.BlurRadius}" /></StackPanel>
                  </Grid>
                  <Border Classes="NoticeCard"><TextBlock Margin="14" Classes="Muted" Text="Blur is requested from the desktop compositor. Some platforms expose only on/off blur, so the stored radius is applied at the nearest supported level." TextWrapping="Wrap" /></Border>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="14">
                  <TextBlock Classes="SectionHeading" Text="MOTION &amp; BEHAVIOR" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <StackPanel Spacing="10">
                      <CheckBox IsChecked="{Binding QuickTerminalSettingsEditor.AnimateSlide}" Content="Animate the drop-down" />
                      <CheckBox IsChecked="{Binding QuickTerminalSettingsEditor.ReduceMotion}" Content="Reduce motion (overrides animation)" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Animation duration (ms)" /><NumericUpDown Minimum="0" Maximum="1000" Increment="10" Value="{Binding QuickTerminalSettingsEditor.AnimationDurationMilliseconds}" /></StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource ShellBorderBrush}" />
                  <CheckBox IsChecked="{Binding QuickTerminalSettingsEditor.HideOnFocusLoss}" Content="Hide when focus moves to another application" />
                  <CheckBox IsChecked="{Binding QuickTerminalSettingsEditor.RestoreLastSession}" Content="Keep the terminal session and scrollback between openings" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Escape always hides the panel. Turning session restore off closes the hidden Quick Terminal session and starts a fresh shell next time." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsSecretsSettingsVisible}">
              <StackPanel Spacing="5"><TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Secrets" /><TextBlock Classes="Muted" Text="Credential values live only in the operating-system vault. GhostSHELL stores opaque references in definitions." /></StackPanel>
              <Border Classes="NoticeCard"><Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="10"><icons:SymbolIcon Symbol="Shield" FontSize="16" Foreground="{DynamicResource ShellWarningBrush}" /><TextBlock Grid.Column="1" Classes="Muted" Text="{Binding SecretVaultStatus}" TextWrapping="Wrap" /></Grid></Border>
              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="13">
                  <TextBlock Classes="SectionHeading" Text="NEW CONNECTION CREDENTIAL" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Connection" /><ComboBox x:Name="SecretConnectionPicker" ItemsSource="{Binding Connections}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Kind" /><ComboBox x:Name="SecretKindPicker" ItemsSource="{Binding SecretKinds}" SelectedIndex="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Label" /><TextBox x:Name="SecretLabelInput" PlaceholderText="Production password" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Value" /><TextBox x:Name="SecretValueInput" PasswordChar="●" PlaceholderText="Never displayed again" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="The connection editor uses the resulting opaque reference." /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateConnectionSecretClick" Content="Store credential" /></Grid>
                </StackPanel>
              </Border>
              <Border Classes="SettingsCard">
                <StackPanel Margin="18" Spacing="13">
                  <TextBlock Classes="SectionHeading" Text="NEW FILE-PROVIDER CREDENTIAL" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="File provider" /><ComboBox x:Name="SecretFileProviderPicker" ItemsSource="{Binding FileProviderDefinitions}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Kind" /><ComboBox x:Name="FileProviderSecretKindPicker" ItemsSource="{Binding SecretKinds}" SelectedIndex="0" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Label" /><TextBox x:Name="FileProviderSecretLabelInput" PlaceholderText="Production provider credential" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Value" /><TextBox x:Name="FileProviderSecretValueInput" PasswordChar="●" PlaceholderText="Never displayed again" /></StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Save the provider first, store its scoped credential here, then select the opaque reference while editing." TextWrapping="Wrap" /><Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateFileProviderSecretClick" Content="Store credential" /></Grid>
                </StackPanel>
              </Border>
              <StackPanel Spacing="9">
                <TextBlock Classes="SectionHeading" Text="STORED METADATA" />
                <ItemsControl ItemsSource="{Binding Secrets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Classes="SettingsCard">
                        <Grid Margin="14,11" ColumnDefinitions="Auto,*,220,Auto" ColumnSpacing="12">
                          <Border Width="32" Height="32" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Key" FontSize="14" /></Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontWeight="SemiBold" Text="{Binding Label}" /><TextBlock Classes="Eyebrow" Text="{Binding Kind}" /></StackPanel>
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Scope}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Dependencies}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LastUsed, StringFormat={}Last used: {0}}" />
                          </StackPanel>
                          <TextBox Grid.Column="2" VerticalAlignment="Center" Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" IsReadOnly="True" Text="{Binding Reference.Value}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                            <Button Classes="SecondaryButton" Click="OnEditSecretClick" Content="Manage" />
                            <Button Classes="DangerButton" Click="OnDeleteSecretClick" ToolTip.Tip="Delete credential" AutomationProperties.Name="Delete credential"><icons:SymbolIcon Symbol="Delete" FontSize="13" /></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsAgentSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="AI providers" />
                  <TextBlock Classes="Muted" Text="Native Anthropic and OpenAI-compatible adapters. Credentials resolve from the OS vault only for a bounded request." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Classes="PrimaryButton" Click="OnAddAiProviderClick" Content="Add provider" AutomationProperties.Name="Add AI provider" />
              </Grid>

              <ItemsControl ItemsSource="{Binding AiProviderDefinitions}" IsVisible="{Binding HasAiProviders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,9" Classes="SettingsCard">
                      <Grid Margin="15,13" ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto" ColumnSpacing="12">
                        <Border Width="36" Height="36" Classes="IconTile">
                          <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Bot" FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="Eyebrow" Text="{Binding Kind}" />
                          </StackPanel>
                          <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DefaultModel, StringFormat={}Default model: {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                            <TextBlock Classes="Eyebrow" Text="{Binding Order, StringFormat={}ORDER {0}}" />
                          </StackPanel>
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding StatusDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="SecondaryButton" Click="OnEditAiProviderClick" Content="Edit" />
                        <Button Grid.Column="4" Classes="DangerButton" Click="OnDeleteAiProviderClick" ToolTip.Tip="Delete AI provider" AutomationProperties.Name="Delete AI provider">
                          <icons:SymbolIcon Symbol="Delete" FontSize="13" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="SettingsCard" IsVisible="{Binding HasNoAiProviders}">
                <StackPanel Margin="24" HorizontalAlignment="Center" Spacing="10">
                  <Border Width="48" Height="48" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="14">
                    <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Bot" FontSize="24" Foreground="{DynamicResource ShellAccentBrush}" />
                  </Border>
                  <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="No provider configured" />
                  <TextBlock MaxWidth="540" Classes="Muted" Text="Add a provider to enable the governed agent. Every run stays bound to its selected live panel scope and all panel actions pass through the capability broker." TextAlignment="Center" TextWrapping="Wrap" />
                  <Button Classes="SecondaryButton" Click="OnAddAiProviderClick" Content="Add first provider" />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="16" Spacing="11">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="SectionHeading" Text="STORE PROFILE CREDENTIAL" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Save the profile first. Its opaque credential slot is fixed in the definition; this action fills that exact profile-scoped slot in the OS vault." TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Provider" />
                      <ComboBox x:Name="AiProviderSecretProfilePicker" ItemsSource="{Binding AiProviderDefinitions}" SelectedIndex="0">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Label" />
                      <TextBox x:Name="AiProviderSecretLabelInput" PlaceholderText="Provider API key" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="AiProviderSecretValueInput" PasswordChar="●" PlaceholderText="API key · never displayed again" />
                    <Button Grid.Column="1" Classes="PrimaryButton" Click="OnCreateAiProviderSecretClick" Content="Store credential" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="NoticeCard">
                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <icons:SymbolIcon Symbol="Shield" FontSize="17" Foreground="{DynamicResource ShellAccentBrush}" />
                  <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Provider output currently becomes text or inert tool proposals only. It has no terminal, process, filesystem, browser, or session-host authority." TextWrapping="Wrap" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel x:Name="McpSettingsSection" Spacing="18" IsVisible="{Binding IsMcpSettingsVisible}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="MCP servers" />
                  <TextBlock
                      Classes="Muted"
                      Text="Native .NET stdio integrations for governed agent runs. Each server is a direct local process; no agent is installed on connected remote machines."
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="PrimaryButton"
                    Click="OnAddMcpServerClick"
                    Content="Add server"
                    AutomationProperties.Name="Add MCP server" />
              </Grid>

              <ItemsControl ItemsSource="{Binding McpServerDefinitions}" IsVisible="{Binding HasMcpServers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                        Margin="0,0,0,9"
                        Classes="SettingsCard"
                        AutomationProperties.Name="{Binding Name, StringFormat={}MCP server {0}}">
                      <Grid Margin="15,13" ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto" ColumnSpacing="12">
                        <Border Width="36" Height="36" Classes="IconTile">
                          <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Code" FontSize="16" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock
                              Classes="Muted Monospace"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding Executable}"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding Executable}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ArgumentSummary}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding EnvironmentBindingSummary}" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding EnabledToolSummary}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock
                              FontWeight="SemiBold"
                              Text="{Binding Status}"
                              AutomationProperties.LiveSetting="Polite"
                              AutomationProperties.Name="{Binding Status, StringFormat={}MCP server status · {0}}" />
                          <TextBlock
                              Classes="Muted"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding StatusDetail}"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Classes="SecondaryButton"
                            Click="OnTestMcpServerClick"
                            Content="{Binding TestActionLabel}"
                            IsEnabled="{Binding CanTest}"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Test MCP server {0}}" />
                        <Button
                            Grid.Column="4"
                            Classes="SecondaryButton"
                            Click="OnEditMcpServerClick"
                            Content="Edit"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Edit MCP server {0}}" />
                        <Button
                            Grid.Column="5"
                            Classes="DangerButton"
                            Click="OnDeleteMcpServerClick"
                            ToolTip.Tip="Delete MCP server"
                            AutomationProperties.Name="{Binding Name, StringFormat={}Delete MCP server {0}}">
                          <icons:SymbolIcon Symbol="Delete" FontSize="13" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="SettingsCard" IsVisible="{Binding HasNoMcpServers}">
                <StackPanel Margin="24" HorizontalAlignment="Center" Spacing="10">
                  <Border Width="48" Height="48" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="14">
                    <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Code" FontSize="24" Foreground="{DynamicResource ShellAccentBrush}" />
                  </Border>
                  <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="No MCP server configured" />
                  <TextBlock
                      MaxWidth="560"
                      Classes="Muted"
                      Text="Add a trusted stdio server, map only the vault references it needs, and enable an exact tool allowlist. The agent cannot discover or call anything outside that saved boundary."
                      TextAlignment="Center"
                      TextWrapping="Wrap" />
                  <Button
                      Classes="SecondaryButton"
                      Click="OnAddMcpServerClick"
                      Content="Add first server"
                      AutomationProperties.Name="Add first MCP server" />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Margin="16" Spacing="11">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="SectionHeading" Text="STORE ENVIRONMENT CREDENTIAL" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize10}"
                        Text="Save the server and its environment binding first. This fills that exact opaque SecretRef in the operating-system vault; the value is never displayed again."
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Environment binding" />
                      <ComboBox
                          x:Name="McpEnvironmentSecretTargetPicker"
                          ItemsSource="{Binding McpEnvironmentSecretTargets}"
                          SelectedIndex="0"
                          AutomationProperties.Name="MCP environment binding">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Kind" />
                      <ComboBox
                          x:Name="McpServerSecretKindPicker"
                          ItemsSource="{Binding SecretKinds}"
                          SelectedIndex="0"
                          AutomationProperties.Name="MCP environment credential kind" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Label" />
                      <TextBox
                          x:Name="McpServerSecretLabelInput"
                          PlaceholderText="Server token"
                          AutomationProperties.Name="MCP environment credential label" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock FontWeight="SemiBold" Text="Value" />
                      <TextBox
                          x:Name="McpServerSecretValueInput"
                          PasswordChar="●"
                          PlaceholderText="Never displayed again"
                          AutomationProperties.Name="MCP environment credential value" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize10}"
                        Text="Only a selected profile-scoped binding can receive this value."
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Classes="PrimaryButton"
                        Click="OnCreateMcpServerSecretClick"
                        Content="Store credential"
                        IsEnabled="{Binding HasMcpEnvironmentSecretTargets}"
                        AutomationProperties.Name="Store MCP environment credential" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="NoticeCard">
                <Grid Margin="14" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <icons:SymbolIcon Symbol="Shield" FontSize="17" Foreground="{DynamicResource ShellAccentBrush}" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize10}"
                      Text="Settings shows saved configuration and the last bounded test result, not live MCP process state. Governed runs initialize eligible servers only when needed, and each MCP tool call requires explicit human approval."
                      TextWrapping="Wrap" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsDiagnosticsSettingsVisible}">
              <StackPanel Spacing="5">
                <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="Data &amp; diagnostics" />
                <TextBlock Classes="Muted" Text="Export bounded support information without terminal content, commands, credentials, or environment values." TextWrapping="Wrap" />
              </StackPanel>
              <Border Classes="SettingsCard">
                <Grid Margin="16" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Getting started &amp; local privacy" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Review local shell and credential prerequisites, import durable definitions, or change bounded session-history retention." TextWrapping="Wrap" />
                    <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HistoryRetentionStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Current session history privacy" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Classes="SecondaryButton" Click="OnReviewOnboardingClick" Content="Review setup" AutomationProperties.Name="Review getting started setup" />
                    <Button Classes="SecondaryButton" Click="OnReviewHistoryPrivacyClick" Content="History privacy" AutomationProperties.Name="Open session history privacy controls" />
                  </StackPanel>
                </Grid>
              </Border>
              <views:LocalArtifactControlView x:Name="LocalArtifactControlView" />
              <views:RecoveryDataControlView x:Name="RecoveryDataControlView" />
              <views:DiagnosticsExportView x:Name="DiagnosticsExportView" />
            </StackPanel>

            <StackPanel Spacing="18" IsVisible="{Binding IsAboutSettingsVisible}">
              <StackPanel Spacing="5">
                <TextBlock FontSize="{DynamicResource ShellFontSize25}" FontWeight="SemiBold" Text="About GhostSHELL" />
                <TextBlock Classes="Muted" Text="The native .NET agent can operate governed terminal, browser, and File Viewer panels. Actions stay scoped to exact live targets; risky mutations require explicit one-time approval." TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="SettingsCard">
                <Grid Margin="18" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="15" ColumnSpacing="24">
                  <StackPanel Spacing="3"><TextBlock Classes="Eyebrow" Text="VERSION" /><TextBlock Classes="Monospace" FontWeight="SemiBold" Text="{Binding ApplicationVersion}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3"><TextBlock Classes="Eyebrow" Text="PLATFORM" /><TextBlock Classes="Monospace" Text="{Binding PlatformDescription}" /></StackPanel>
                  <StackPanel Grid.Row="1" Spacing="3"><TextBlock Classes="Eyebrow" Text="RUNTIME" /><TextBlock Classes="Monospace" Text="{Binding RuntimeDescription}" /></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Classes="Eyebrow" Text="AGENT RUNTIME" /><TextBlock Classes="Monospace" Text="{Binding AgentRuntimeDescription}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Target architecture: native .NET in process, without an external JavaScript runtime." TextWrapping="Wrap" /></StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3"><TextBlock Classes="Eyebrow" Text="UPDATES" /><TextBlock Classes="Monospace" Text="{Binding UpdateStatus}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Install newer builds through the same channel that provided this copy." TextWrapping="Wrap" /></StackPanel>
                </Grid>
              </Border>

              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3"><TextBlock Classes="SectionHeading" Text="OPEN-SOURCE COMPONENTS" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Key runtime components are shown here; the bundled notice records the current managed inventory and release-license work still open." TextWrapping="Wrap" /></StackPanel>
                  <Button Grid.Column="1" Classes="SecondaryButton" Click="OnOpenThirdPartyNoticesClick" Content="Open bundled notices" AutomationProperties.Name="Open bundled third-party notices" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ProductComponents}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Classes="SettingsCard">
                        <Grid Margin="14,11" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="7">
                          <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Purpose}" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" VerticalAlignment="Top" Classes="Eyebrow" Text="BUNDLED" />
                          <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Margin="0,0,18,0" Classes="Monospace" Text="{Binding Version}" TextWrapping="Wrap" />
                            <TextBlock Classes="Muted" Text="{Binding License}" TextWrapping="Wrap" />
                          </WrapPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Docked overlays. Runtime native views are hidden while these are open. -->
    <Grid IsVisible="{Binding HasOverlay}" Background="#F20B0B0C">
      <Border Width="680" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="OverlayCard" IsVisible="{Binding IsCommandPaletteVisible}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="58,*,44">
          <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="17" />
            <TextBox
                x:Name="CommandSearchBox"
                Grid.Column="1"
                BorderThickness="0"
                Background="Transparent"
                KeyDown="OnCommandSearchKeyDown"
                PlaceholderText="Search connections, screens, workspaces, sessions, or commands…"
                AutomationProperties.Name="Search commands and launch targets"
                Text="{Binding LauncherSearchQuery}" />
            <Button Grid.Column="2" Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="OnCloseOverlayClick" AutomationProperties.Name="Close command palette">
              <Border Classes="Keycap"><TextBlock Classes="Monospace" Text="ESC" /></Border>
            </Button>
          </Grid>
          <ListBox
              x:Name="LauncherSearchResultList"
              Grid.Row="1"
              Background="Transparent"
              BorderThickness="0"
              AutomationProperties.Name="Commands and launch targets"
              ItemsSource="{Binding LauncherSearchResults}"
              SelectedItem="{Binding SelectedLauncherSearchResult, Mode=TwoWay}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Button
                    Margin="4,0"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    Click="OnLauncherSearchResultClick"
                    IsEnabled="{Binding IsAvailable}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                    <Border Width="34" Height="34" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding IconSymbol}" FontSize="14" /></Border>
                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="SectionHeading" FontSize="{DynamicResource ShellFontSize8}" Text="{Binding Group}" /><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayDetail}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Border Grid.Column="2" Classes="Keycap" VerticalAlignment="Center" IsVisible="{Binding HasTrailingText}"><TextBlock Classes="Monospace" Text="{Binding TrailingText}" /></Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" IsVisible="{Binding HasNoLauncherSearchResults}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Launcher search has no results"><icons:SymbolIcon HorizontalAlignment="Center" Symbol="Search" FontSize="24" /><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No results" /><TextBlock MaxWidth="420" HorizontalAlignment="Center" Classes="Muted" TextAlignment="Center" Text="{Binding LauncherSearchEmptyState}" TextWrapping="Wrap" /></StackPanel>
          <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="14,0" ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Unavailable results stay visible but cannot be opened." /><TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="↑↓ navigate  ↵ activate" /></Grid></Border>
        </Grid>
      </Border>

      <Border
          Margin="90,54"
          MaxWidth="1120"
          MaxHeight="760"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Classes="OverlayCard"
          KeyboardNavigation.TabNavigation="Cycle"
          IsVisible="{Binding IsNewItemVisible}">
        <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Classes="SearchButton" HorizontalContentAlignment="Stretch" Click="OnShowCommandPaletteClick" AutomationProperties.Name="Search commands, connections, screens, workspaces, and session history">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <icons:SymbolIcon Symbol="Search" FontSize="16" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize13}" Text="Search connections, screens, workspaces, sessions, or commands…" />
                <Border Grid.Column="2" Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding CommandPaletteShortcut}" /></Border>
              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="IconButton Large" Click="OnCloseOverlayClick" ToolTip.Tip="Close launcher" AutomationProperties.Name="Close new tab or session launcher"><icons:SymbolIcon Symbol="Dismiss" FontSize="14" /></Button>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="{Binding NewItemLauncherTitle}" />
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
              <Button x:Name="NewTerminalButton" Classes="ChooserButton LauncherChooser" Click="OnNewLocalTerminalClick" AutomationProperties.Name="Open a new local terminal">
                <StackPanel Spacing="10"><Border Width="38" Height="38" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="WindowConsole" FontSize="19" /></Border><TextBlock FontWeight="SemiBold" Text="New terminal" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Open the default local shell" /></StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="ChooserButton LauncherChooser" AutomationProperties.Name="Open a new native browser" Click="OnNewBrowserClick" IsEnabled="{Binding CanCreateBrowserPanel}">
                <StackPanel Spacing="10"><Border Width="38" Height="38" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Globe" FontSize="19" /></Border><TextBlock FontWeight="SemiBold" Text="New browser" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Operating-system webview panel" /></StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="ChooserButton LauncherChooser" Click="OnNewStatisticsClick" AutomationProperties.Name="Open local host statistics">
                <StackPanel Spacing="10"><Border Width="38" Height="38" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="PulseSquare" FontSize="19" /></Border><TextBlock FontWeight="SemiBold" Text="Statistics" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Live system metrics" /></StackPanel>
              </Button>
              <Button Grid.Column="3" Classes="ChooserButton LauncherChooser" Click="OnNewFileViewerClick" AutomationProperties.Name="Open a new File Viewer">
                <StackPanel Spacing="10"><Border Width="38" Height="38" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="19" /></Border><TextBlock FontWeight="SemiBold" Text="File Viewer" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Browse configured providers" /></StackPanel>
              </Button>
              <Button Grid.Column="4" Classes="ChooserButton LauncherChooser" Click="OnNewProcessMonitorClick" AutomationProperties.Name="Open local process monitor">
                <StackPanel Spacing="10"><Border Width="38" Height="38" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Gauge" FontSize="19" /></Border><TextBlock FontWeight="SemiBold" Text="Process monitor" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Watch running processes" /></StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Workspaces" /><Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding Workspaces.Count}" /></Border></StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Workspaces}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="38" Height="38" Padding="0" Background="{Binding Accent}" Click="OnOpenWorkspaceClick" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><icons:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="15" /></Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" IsVisible="{Binding HasNoWorkspaces}" Text="No saved workspaces yet." />
          </Grid>

          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Saved connections" /><Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding Connections.Count}" /></Border></StackPanel><Button Grid.Column="1" Classes="TextButton" Click="OnAddConnectionClick" Content="Add" /></Grid>
              <Border Classes="ListCard">
                <ScrollViewer MaxHeight="255">
                  <ItemsControl ItemsSource="{Binding Connections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                            Padding="12,9"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ShellBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0"
                            HorizontalContentAlignment="Stretch"
                            Click="OnOpenConnectionClick"
                            IsEnabled="{Binding CanOpen}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Open saved connection {0} in a tab}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="28" Height="28" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="WindowConsole" FontSize="13" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Detail}" /></StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding Kind}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="9">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Saved screens" /><Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding Screens.Count}" /></Border></StackPanel><Button Grid.Column="1" Classes="TextButton" Click="OnShowLayoutDesignerClick" Content="Layouts" /></Grid>
              <Border Classes="ListCard">
                <ScrollViewer MaxHeight="255">
                  <ItemsControl ItemsSource="{Binding Screens}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                            Padding="12,9"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ShellBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0"
                            HorizontalContentAlignment="Stretch"
                            Click="OnOpenScreenClick"
                            AutomationProperties.Name="{Binding Name, StringFormat=Open saved screen {0} in a tab}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="38" Height="28" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="13" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Eyebrow" Text="{Binding PanelCount, StringFormat={}{0} PANELS}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Row="4" Classes="NoticeCard">
            <Grid Margin="12" ColumnDefinitions="Auto,170,Auto,Auto,170,Auto,*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Create" />
              <TextBox x:Name="NewWorkspaceName" Grid.Column="1" MinHeight="30" PlaceholderText="Workspace name" />
              <Button Grid.Column="2" Classes="SecondaryButton" Click="OnCreateWorkspaceClick" Content="Workspace" />
              <Border Grid.Column="3" Width="1" Margin="4,0" Background="{DynamicResource ShellBorderBrush}" />
              <TextBox x:Name="NewScreenName" Grid.Column="4" MinHeight="30" PlaceholderText="Saved screen name" />
              <Button Grid.Column="5" Classes="SecondaryButton" Click="OnCreateScreenClick" Content="Screen" />
              <TextBlock Grid.Column="6" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Definitions are durable; every open creates fresh runtime IDs." TextWrapping="Wrap" />
              <Button Grid.Column="7" Classes="TextButton Accent" Click="OnAddConnectionClick" Content="Connection…" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Width="900" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="OverlayCard" IsVisible="{Binding IsNewPanelVisible}" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Margin="22" Spacing="18">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="{DynamicResource ShellFontSize20}" FontWeight="SemiBold" Text="Add a panel" /><TextBlock Classes="Muted" Text="Choose an adapter supported by this desktop milestone." /></StackPanel><Button Grid.Column="1" Classes="IconButton" Click="OnCloseOverlayClick" AutomationProperties.Name="Close panel chooser"><icons:SymbolIcon Symbol="Dismiss" FontSize="14" /></Button></Grid>
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
            <Button x:Name="NewPanelTerminalButton" Classes="ChooserButton PanelChooser" Click="OnAddTerminalPanelClick"><StackPanel Spacing="9"><Border Width="36" Height="36" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="WindowConsole" FontSize="18" /></Border><TextBlock FontWeight="SemiBold" Text="Terminal" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Local PTY" /></StackPanel></Button>
            <Button Grid.Column="1" Classes="ChooserButton PanelChooser" AutomationProperties.Name="Add native browser panel" Click="OnAddBrowserPanelClick" IsEnabled="{Binding CanCreateBrowserPanel}"><StackPanel Spacing="9"><Border Width="36" Height="36" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Globe" FontSize="18" /></Border><TextBlock FontWeight="SemiBold" Text="Browser" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Native webview" /></StackPanel></Button>
            <Button Grid.Column="2" Classes="ChooserButton PanelChooser" Click="OnAddStatisticsPanelClick" AutomationProperties.Name="Add Statistics panel"><StackPanel Spacing="9"><Border Width="36" Height="36" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="PulseSquare" FontSize="18" /></Border><TextBlock FontWeight="SemiBold" Text="Statistics" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Live metrics" /></StackPanel></Button>
            <Button Grid.Column="3" Classes="ChooserButton PanelChooser" Click="OnAddFilePanelClick"><StackPanel Spacing="9"><Border Width="36" Height="36" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="18" /></Border><TextBlock FontWeight="SemiBold" Text="Files" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Saved providers" /></StackPanel></Button>
            <Button Grid.Column="4" Classes="ChooserButton PanelChooser" Click="OnAddProcessMonitorPanelClick" AutomationProperties.Name="Add Process Monitor panel"><StackPanel Spacing="9"><Border Width="36" Height="36" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Gauge" FontSize="18" /></Border><TextBlock FontWeight="SemiBold" Text="Processes" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Running processes" /></StackPanel></Button>
          </Grid>
          <Button Classes="TextButton Accent" Click="OnShowLayoutDesignerClick" Content="Open layout designer instead" />
        </StackPanel>
      </Border>

      <Border Width="1000" Height="648" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="OverlayCard" IsVisible="{Binding IsLayoutDesignerVisible}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid RowDefinitions="60,Auto,*,60">
          <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                <Border Width="30" Height="30" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="8">
                  <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Grid" FontSize="16" Foreground="{DynamicResource ShellAccentBrush}" />
                </Border>
                <StackPanel Spacing="1">
                  <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="Bold" Text="Design custom layout" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Paint panels onto the grid" />
                </StackPanel>
                <Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding LayoutDesignerEditor.DirtyStatus}" /></Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="IconButton" Click="OnCloseOverlayClick" AutomationProperties.Name="Close layout designer">
                <icons:SymbolIcon Symbol="Dismiss" FontSize="16" />
              </Button>
            </Grid>
          </Border>

          <Border Grid.Row="1" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,14" Spacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" FontWeight="SemiBold" Text="Layout name" />
                <TextBox x:Name="NewLayoutName" Text="{Binding LayoutDesignerEditor.Name, Mode=TwoWay}" PlaceholderText="My layout" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Columns" />
                  <NumericUpDown Width="110" x:Name="LayoutColumnsPicker" Minimum="1" Maximum="12" Value="{Binding LayoutDesignerEditor.Columns}" ValueChanged="OnLayoutGridSizeChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Rows" />
                  <NumericUpDown Width="110" x:Name="LayoutRowsPicker" Minimum="1" Maximum="12" Value="{Binding LayoutDesignerEditor.Rows}" ValueChanged="OnLayoutGridSizeChanged" />
                </StackPanel>
                <Button Grid.Column="3" Classes="SecondaryButton" Click="OnResetLayoutClick" Content="Reset" ToolTip.Tip="Restore the saved layout" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" ColumnDefinitions="*,300">
            <Border Background="{DynamicResource ShellBackgroundBrush}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Border
                    Width="560"
                    Height="324"
                    Background="{DynamicResource ShellBackgroundBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                  <Grid>
                    <controls:LayoutDesignerGridVisual
                        IsHitTestVisible="False"
                        Columns="{Binding LayoutDesignerEditor.Columns}"
                        Rows="{Binding LayoutDesignerEditor.Rows}"
                        PreviewBounds="{Binding LayoutDesignerEditor.PaintPreviewBounds}"
                        GridBackgroundBrush="{DynamicResource ShellBackgroundBrush}"
                        GridLineBrush="{DynamicResource ShellBorderBrush}"
                        PreviewBrush="{DynamicResource ShellAccentSoftBrush}"
                        PreviewBorderBrush="{DynamicResource ShellAccentBrush}" />
                    <ItemsControl
                        x:Name="LayoutDesignerGrid"
                        DataContext="{Binding LayoutDesignerEditor}"
                        Focusable="True"
                        ItemsSource="{Binding Slots}"
                        KeyDown="OnLayoutDesignerKeyDown"
                        AutomationProperties.Name="Editable layout grid"
                        AutomationProperties.HelpText="Drag across empty cells to paint a panel. Drag panel edges to resize. Alt plus arrow keys moves; Shift plus arrow keys grows; Control plus arrow keys shrinks; Page Up and Page Down select panels.">
                      <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                      </ItemsControl.Styles>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <controls:LayoutDesignerPreviewPanel Background="Transparent" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Classes="LayoutSlotButton"
                              Classes.active="{Binding IsSelected}"
                              Classes.orange="{Binding UsesOrangePalette}"
                              Classes.blue="{Binding UsesBluePalette}"
                              Classes.green="{Binding UsesGreenPalette}"
                              Classes.pink="{Binding UsesPinkPalette}"
                              Click="OnLayoutSlotClick"
                              AutomationProperties.Name="{Binding PositionLabel}">
                            <Grid>
                              <Border Margin="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#59000000" CornerRadius="6">
                                <TextBlock FontSize="{DynamicResource ShellFontSize10}" FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                              </Border>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                <TextBlock HorizontalAlignment="Center" Classes="Monospace" FontSize="{DynamicResource ShellFontSize28}" FontWeight="Bold" Text="{Binding Order}" />
                                <TextBlock MaxWidth="180" HorizontalAlignment="Center" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding PositionLabel}" TextAlignment="Center" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
                <Border Padding="14,8" Background="{DynamicResource ShellSurfaceRaisedBrush}" CornerRadius="999">
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="Drag across empty cells to paint a panel · drag edges to resize" />
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="Bold" Text="Panels" />
                    <Border Grid.Column="1" Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding LayoutDesignerEditor.Slots.Count}" /></Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding LayoutDesignerEditor.Slots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button
                            Margin="0,0,0,6"
                            Padding="10,8"
                            HorizontalContentAlignment="Stretch"
                            Classes="SecondaryButton"
                            Classes.active="{Binding IsSelected}"
                            Click="OnLayoutSlotClick"
                            AutomationProperties.Name="{Binding PositionLabel}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                            <Border
                                Width="24"
                                Height="24"
                                Classes="LayoutSlotBadge"
                                Classes.orange="{Binding UsesOrangePalette}"
                                Classes.blue="{Binding UsesBluePalette}"
                                Classes.green="{Binding UsesGreenPalette}"
                                Classes.pink="{Binding UsesPinkPalette}"
                                CornerRadius="6">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Monospace" FontWeight="Bold" Foreground="{DynamicResource ShellBackgroundBrush}" Text="{Binding Order}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock FontWeight="SemiBold" Text="{Binding OrderLabel}" />
                              <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding PositionLabel}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <icons:SymbolIcon Grid.Column="2" VerticalAlignment="Center" Symbol="ChevronRight" FontSize="12" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button
                      HorizontalAlignment="Stretch"
                      Classes="SecondaryButton"
                      Classes.painting="{Binding LayoutDesignerEditor.IsPaintMode}"
                      Click="OnLayoutTogglePaintModeClick"
                      AutomationProperties.Name="Toggle paint new panel mode">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                      <icons:SymbolIcon Symbol="Edit" FontSize="14" />
                      <TextBlock Text="{Binding LayoutDesignerEditor.PaintModeLabel}" />
                    </StackPanel>
                  </Button>

                  <Border Classes="NoticeCard">
                    <TextBlock Margin="12" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Panels are generic regions — assign connections later when you open the screen." TextWrapping="Wrap" />
                  </Border>

                  <Border Classes="SettingsCard">
                    <StackPanel Margin="12" Spacing="9">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding LayoutDesignerEditor.SelectedSlot.OrderLabel}" />
                          <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LayoutDesignerEditor.SelectedSlot.PositionLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <Button Classes="IconButton" Click="OnLayoutMoveEarlierClick" IsEnabled="{Binding LayoutDesignerEditor.CanMoveSelectedEarlier}" ToolTip.Tip="Earlier in keyboard order" AutomationProperties.Name="Move selected panel earlier">
                            <icons:SymbolIcon Symbol="ArrowUp" FontSize="13" />
                          </Button>
                          <Button Classes="IconButton" Click="OnLayoutMoveLaterClick" IsEnabled="{Binding LayoutDesignerEditor.CanMoveSelectedLater}" ToolTip.Tip="Later in keyboard order" AutomationProperties.Name="Move selected panel later">
                            <icons:SymbolIcon Symbol="ArrowDown" FontSize="13" />
                          </Button>
                        </StackPanel>
                      </Grid>

                      <TextBlock Classes="SectionHeading" Text="MOVE ONE CELL" />
                      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                        <Button Classes="SecondaryButton" Click="OnLayoutMoveLeftClick" AutomationProperties.Name="Move panel left"><icons:SymbolIcon Symbol="ArrowLeft" FontSize="13" /></Button>
                        <Button Grid.Column="1" Classes="SecondaryButton" Click="OnLayoutMoveUpClick" AutomationProperties.Name="Move panel up"><icons:SymbolIcon Symbol="ArrowUp" FontSize="13" /></Button>
                        <Button Grid.Column="2" Classes="SecondaryButton" Click="OnLayoutMoveDownClick" AutomationProperties.Name="Move panel down"><icons:SymbolIcon Symbol="ArrowDown" FontSize="13" /></Button>
                        <Button Grid.Column="3" Classes="SecondaryButton" Click="OnLayoutMoveRightClick" AutomationProperties.Name="Move panel right"><icons:SymbolIcon Symbol="ArrowRight" FontSize="13" /></Button>
                      </Grid>

                      <TextBlock Classes="SectionHeading" Text="RESIZE ONE CELL" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <StackPanel Spacing="4">
                          <Button Classes="TextButton" Click="OnLayoutGrowLeftClick" Content="Grow left" />
                          <Button Classes="TextButton" Click="OnLayoutGrowRightClick" Content="Grow right" />
                          <Button Classes="TextButton" Click="OnLayoutGrowTopClick" Content="Grow top" />
                          <Button Classes="TextButton" Click="OnLayoutGrowBottomClick" Content="Grow bottom" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <Button Classes="TextButton" Click="OnLayoutShrinkLeftClick" Content="Shrink left" />
                          <Button Classes="TextButton" Click="OnLayoutShrinkRightClick" Content="Shrink right" />
                          <Button Classes="TextButton" Click="OnLayoutShrinkTopClick" Content="Shrink top" />
                          <Button Classes="TextButton" Click="OnLayoutShrinkBottomClick" Content="Shrink bottom" />
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button HorizontalAlignment="Stretch" Classes="SecondaryButton" Click="OnLayoutAddSlotClick" Content="Add 1 cell" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Classes="DestructiveButton" Click="OnLayoutRemoveSlotClick" Content="Remove" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding LayoutDesignerEditor.PaintModeStatus}"
                      TextWrapping="Wrap"
                      AutomationProperties.LiveSetting="Polite"
                      AutomationProperties.Name="Layout painting status" />
                  <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="Alt+arrows move · Shift+arrows grow · Ctrl+arrows shrink · Page Up/Down selects" TextWrapping="Wrap" />
                  <Border Classes="NoticeCard" IsVisible="{Binding LayoutDesignerEditor.HasOperationError}">
                    <TextBlock Margin="12" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding LayoutDesignerEditor.LastOperationIssue.Message}" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding LayoutDesignerEditor.ValidationSummary}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LayoutDesignerEditor.MinimumCanvasWidth, StringFormat={}Minimum width {0:0}px}" />
                  <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LayoutDesignerEditor.MinimumCanvasHeight, StringFormat={}Minimum height {0:0}px}" />

                  <TextBlock Classes="SectionHeading" Text="SAVED LAYOUTS" />
                  <ItemsControl ItemsSource="{Binding Layouts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Margin="0,0,0,6" Padding="10,8" Classes="SecondaryButton" HorizontalContentAlignment="Stretch" Click="OnEditLayoutClick">
                          <Grid ColumnDefinitions="*,70" ColumnSpacing="8">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding SlotCount, StringFormat={}{0} SLOTS}" TextAlignment="Right" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <Border Grid.Row="3" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding LayoutDesignerEditor.GridSummary}" />
              <Button Grid.Column="1" VerticalAlignment="Center" Classes="SecondaryButton" Click="OnCloseOverlayClick" Content="Cancel" />
              <Button Grid.Column="2" VerticalAlignment="Center" Classes="PrimaryButton" Click="OnSaveLayoutDesignerClick" Content="Save layout" IsEnabled="{Binding LayoutDesignerEditor.CanSave}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border
          Margin="42,58,42,34"
          MaxWidth="1280"
          HorizontalAlignment="Center"
          VerticalAlignment="Stretch"
          Classes="OverlayCard"
          ClipToBounds="True"
          KeyboardNavigation.TabNavigation="Cycle"
          IsVisible="{Binding IsDefinitionEditorVisible}">
        <views:WorkspaceEditorView
            x:Name="WorkspaceDefinitionEditor"
            DataContext="{Binding WorkspaceEditor}"
            SaveRequested="OnWorkspaceEditorSaveRequested"
            CancelRequested="OnWorkspaceEditorCancelRequested" />
      </Border>
    </Grid>

    <Border
        Margin="0,0,0,62"
        Padding="12,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        MaxWidth="620"
        Classes="NoticeCard"
        IsVisible="{Binding HasApplicationKeySequenceHint}"
        AutomationProperties.LiveSetting="Polite"
        AutomationProperties.Name="Application key sequence status">
      <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ApplicationKeySequenceHint}" TextWrapping="Wrap" />
    </Border>

    <Border
        Margin="0,0,18,18"
        Padding="13,10"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        MaxWidth="520"
        Background="{DynamicResource ShellDangerSoftBrush}"
        BorderBrush="{DynamicResource ShellDangerBorderBrush}"
        BorderThickness="1"
        CornerRadius="9"
        IsVisible="{Binding HasOperationError}"
        AutomationProperties.LiveSetting="Assertive"
        AutomationProperties.Name="Operation error">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <icons:SymbolIcon Symbol="ErrorCircle" FontSize="15" Foreground="{DynamicResource ShellDangerBrush}" />
        <TextBlock Grid.Column="1" Foreground="{DynamicResource ShellTextBrush}" Text="{Binding OperationError}" TextWrapping="Wrap" />
        <Button Grid.Column="2" Classes="IconButton" Click="OnClearErrorClick" AutomationProperties.Name="Dismiss error"><icons:SymbolIcon Symbol="Dismiss" FontSize="12" /></Button>
      </Grid>
    </Border>
  </Grid>
</Window>
