<Window
    x:Class="GhostShell.App.Views.ConnectionEditorDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Connection"
    Width="720"
    Height="760"
    MinWidth="620"
    MinHeight="620"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="58,*,68">
    <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding EditorTitle}" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Profiles store secret references, never secret values." />
      </StackPanel>
      <Button
          Grid.Column="1"
          Classes="IconButton"
          Click="OnCancelClick"
          Content="×"
          IsCancel="True"
          AutomationProperties.Name="Close connection editor" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="{controls:Inset Horizontal=Lg, Top=Sm, Bottom=Xl}" Spacing="{DynamicResource ShellSpaceMd}">
        <controls:SurfaceCard Padding="0">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,220" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ShellSpaceMd}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Name" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Shown in launchers, tabs, and agent scope." />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Production shell" />
            <StackPanel Grid.Row="1" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Connection type" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Each type uses a structured native launch plan." />
            </StackPanel>
            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                ItemsSource="{Binding ConnectionKinds}"
                SelectedItem="{Binding Kind}" />
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Padding="0" IsVisible="{Binding IsLocal}">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,320">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Shell executable" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Leave blank to use the host default shell." />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding LocalShell}" PlaceholderText="/bin/zsh" />
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Padding="0" IsVisible="{Binding IsSsh}">
          <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
            <Grid ColumnDefinitions="*,110,180" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Host" /><TextBox Text="{Binding Host}" PlaceholderText="server.example.com" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Port" /><NumericUpDown Minimum="1" Maximum="65535" Value="{Binding Port}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Username" /><TextBox Text="{Binding Username}" PlaceholderText="Current local user" /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Authentication" /><ComboBox ItemsSource="{Binding AuthenticationChoices}" SelectedItem="{Binding Authentication}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Host-key policy" /><ComboBox ItemsSource="{Binding HostKeyPolicies}" SelectedItem="{Binding HostKeyPolicy}" /></StackPanel>
            </Grid>
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding UsesSecretReference}">
              <TextBlock FontWeight="SemiBold" Text="Credential secret reference" />
              <TextBox Text="{Binding SecretReference}" PlaceholderText="Opaque secret ID from the OS vault" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Diagnostics authenticate inside the secure adapter boundary. A terminal claims the stored credential through a one-use, lifetime-bound helper when it starts." TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding UsesPassphraseReference}">
              <TextBlock FontWeight="SemiBold" Text="Passphrase secret reference (optional)" />
              <TextBox Text="{Binding PassphraseSecretReference}" />
            </StackPanel>
          </StackPanel>
        </controls:SurfaceCard>

        <controls:SurfaceCard Padding="0" IsVisible="{Binding IsDocker}">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Container" /><TextBox Text="{Binding Container}" PlaceholderText="api-dev" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Docker context (optional)" /><TextBox Text="{Binding DockerContext}" PlaceholderText="desktop-linux" /></StackPanel>
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Padding="0" IsVisible="{Binding IsWsl}">
          <Grid Margin="{controls:Inset Lg}" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Distribution" /><TextBox Text="{Binding Distribution}" PlaceholderText="Ubuntu-24.04" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Username (optional)" /><TextBox Text="{Binding Username}" /></StackPanel>
          </Grid>
        </controls:SurfaceCard>

        <controls:SurfaceCard Padding="0">
          <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="Startup directory" />
              <TextBox Text="{Binding StartupDirectory}" PlaceholderText="Optional working directory" />
            </StackPanel>
            <Grid ColumnDefinitions="*,140,140" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontWeight="SemiBold" Text="Keep alive" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding #KeepAliveSwitch.IsChecked, Converter={StaticResource OnOffConverter}}" />
                  </StackPanel>
                  <ToggleSwitch x:Name="KeepAliveSwitch" Grid.Column="1" IsChecked="{Binding KeepAliveEnabled}" AutomationProperties.Name="Keep the connection alive" />
                </Grid>
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Text="Remote runtimes use explicit keepalive arguments."
                    TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Interval (seconds)" /><NumericUpDown Minimum="1" Maximum="86400" Value="{Binding KeepAliveSeconds}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="Max failures" /><NumericUpDown Minimum="1" Maximum="100" Value="{Binding KeepAliveFailures}" /></StackPanel>
            </Grid>
          </StackPanel>
        </controls:SurfaceCard>

        <controls:SurfaceCard Tone="Notice" Padding="0">
          <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
            <Border Width="9" Height="9" VerticalAlignment="Top" Margin="{controls:Inset Top=Xs}" Background="{DynamicResource ShellWarningBrush}" CornerRadius="{DynamicResource ShellControlCornerRadius}" />
            <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="{Binding TestStatus}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TestDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </controls:SurfaceCard>

        <ItemsControl ItemsSource="{Binding Diagnostics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="{controls:Inset Xs}" ColumnDefinitions="9,110,80,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" />
                <TextBlock Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Stage}" />
                <TextBlock Grid.Column="2" Classes="Eyebrow" Text="{Binding Status}" />
                <TextBlock Grid.Column="3" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SurfaceCard Padding="0" IsVisible="{Binding HasHostKeyReview}">
          <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceSm}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReview.Endpoint}" />
              </StackPanel>
              <Button
                  Grid.Column="1"
                  Classes="SecondaryButton"
                  Click="OnTrustHostKeyClick"
                  Content="{Binding TrustHostKeyLabel}"
                  IsVisible="{Binding CanTrustHostKey}" />
            </Grid>
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="Eyebrow" Text="Algorithm" />
              <TextBlock Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReview.Presented.Algorithm}" />
              <TextBlock Grid.Row="1" Classes="Eyebrow" Text="Presented" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReview.Presented.Sha256Fingerprint}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Classes="Eyebrow" Text="Previous" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TrustedHostKeyFingerprint}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </controls:SurfaceCard>

        <TextBlock
            x:Name="ValidationError"
            Foreground="{DynamicResource ShellDangerBrush}"
            IsVisible="False"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Opening revalidates runtime, credentials, and platform support." />
          <CheckBox
              x:Name="SaveConnectionCheckBox"
              Content="Save connection"
              IsChecked="True"
              IsVisible="False"
              AutomationProperties.Name="Save this connection for later" />
        </StackPanel>
        <Button Grid.Column="1" MinWidth="120" Classes="SecondaryButton" Click="OnTestClick" Content="Run diagnostics" />
        <Button x:Name="SubmitButton" Grid.Column="2" MinWidth="110" Classes="PrimaryButton" Click="OnSubmitClick" Content="Save" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
