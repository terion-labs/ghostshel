<UserControl
    x:Class="GhostShell.App.Views.LocalArtifactControlView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia">
  <controls:SurfaceCard Padding="0">
    <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontWeight="SemiBold" Text="App-managed cache &amp; logs" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="Review only files stored in GhostSHELL’s dedicated cache and inactive-log locations."
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="RefreshLocalArtifactsButton"
            Grid.Column="1"
            Classes="SecondaryButton"
            Click="OnRefreshClick"
            Content="Refresh"
            IsEnabled="{Binding CanRefresh}"
            AutomationProperties.Name="Refresh app-managed cache and log metadata" />
      </Grid>

      <controls:SurfaceCard Tone="Notice" Padding="0">
        <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon Symbol="Shield" FontSize="16" />
          <TextBlock
              Grid.Column="1"
              Classes="Muted"
              Text="Saved definitions, secrets, history, recovery snapshots, terminal content, OS caches, debug trace output, and any active log are outside this cleanup boundary."
              TextWrapping="Wrap" />
        </Grid>
      </controls:SurfaceCard>

      <TextBlock
          Classes="Muted Monospace"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />

      <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoInventory}">
        <controls:EmptyStatePanel Margin="{controls:Inset Md}"
            ShowsGlyph="False"
            Heading="No storage metadata"
            Body="Use Refresh to inspect GhostSHELL’s app-managed locations." />
      </controls:SurfaceCard>

      <controls:SurfaceCard Tone="Notice" Padding="0" IsVisible="{Binding HasError}">
        <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontWeight="SemiBold" Text="Storage metadata unavailable" />
          <TextBlock
              Classes="Muted"
              Text="The bounded inventory could not be completed. No additional files will be removed automatically; use Refresh to try again."
              TextWrapping="Wrap" />
        </StackPanel>
      </controls:SurfaceCard>

      <ItemsControl
          ItemsSource="{Binding Items}"
          IsEnabled="{Binding CanClearItems}"
          IsVisible="{Binding HasInventory}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:SurfaceCard Tone="Notice" Padding="0" Margin="{controls:Inset Bottom=Sm}">
              <Grid Margin="{controls:Inset Md}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding Description}"
                      TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Margin="{controls:Inset Right=Md}" Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding FileCountLabel}" />
                    <TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SizeLabel}" />
                  </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="DestructiveButton"
                    Click="OnClearClick"
                    Content="Clear"
                    IsEnabled="{Binding HasFiles}"
                    AutomationProperties.Name="{Binding ClearAutomationName}" />
              </Grid>
            </controls:SurfaceCard>          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
