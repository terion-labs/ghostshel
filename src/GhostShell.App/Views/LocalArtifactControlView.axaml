<UserControl
    x:Class="GhostShell.App.Views.LocalArtifactControlView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia">
  <Border Classes="SettingsCard">
    <StackPanel Margin="16" Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="3">
          <TextBlock FontWeight="SemiBold" Text="App-managed cache &amp; logs" />
          <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="Review only files stored in GhostSHELL’s dedicated cache and inactive-log locations."
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="RefreshLocalArtifactsButton"
            Grid.Column="1"
            Classes="SecondaryButton"
            Click="OnRefreshClick"
            Content="Refresh"
            IsEnabled="{Binding CanRefresh}"
            AutomationProperties.Name="Refresh app-managed cache and log metadata" />
      </Grid>

      <Border Classes="NoticeCard">
        <Grid Margin="12" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <icons:SymbolIcon Symbol="Shield" FontSize="16" />
          <TextBlock
              Grid.Column="1"
              Classes="Muted"
              Text="Saved definitions, secrets, history, recovery snapshots, terminal content, OS caches, debug trace output, and any active log are outside this cleanup boundary."
              TextWrapping="Wrap" />
        </Grid>
      </Border>

      <TextBlock
          Classes="Muted Monospace"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding StatusAutomationName}" />

      <Border Classes="NoticeCard" IsVisible="{Binding HasNoInventory}">
        <StackPanel Margin="14" HorizontalAlignment="Center" Spacing="5">
          <TextBlock FontWeight="SemiBold" Text="No storage metadata" />
          <TextBlock
              Classes="Muted"
              Text="Use Refresh to inspect GhostSHELL’s app-managed locations."
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="NoticeCard" IsVisible="{Binding HasError}">
        <StackPanel Margin="14" Spacing="5">
          <TextBlock FontWeight="SemiBold" Text="Storage metadata unavailable" />
          <TextBlock
              Classes="Muted"
              Text="The bounded inventory could not be completed. No additional files will be removed automatically; use Refresh to try again."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl
          ItemsSource="{Binding Items}"
          IsEnabled="{Binding CanClearItems}"
          IsVisible="{Binding HasInventory}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8" Classes="NoticeCard">
              <Grid Margin="12" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding Description}"
                      TextWrapping="Wrap" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,14,0" Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding FileCountLabel}" />
                    <TextBlock Classes="Monospace Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SizeLabel}" />
                  </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="DestructiveButton"
                    Click="OnClearClick"
                    Content="Clear"
                    IsEnabled="{Binding HasFiles}"
                    AutomationProperties.Name="{Binding ClearAutomationName}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
