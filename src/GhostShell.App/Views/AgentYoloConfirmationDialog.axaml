<Window
    x:Class="GhostShell.App.Views.AgentYoloConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Title="Enable YOLO for this run"
    Width="560"
    MinWidth="420"
    MaxHeight="760"
    SizeToContent="Height"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Opened="OnOpened">
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="*,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock
            FontSize="{DynamicResource ShellFontSize18}"
            FontWeight="SemiBold"
            Text="Enable terminal YOLO for 15 minutes?"
            TextWrapping="Wrap" />
        <TextBlock
            Classes="Muted"
            Text="This is a temporary override for the current governed run, not a saved setting."
            TextWrapping="Wrap" />
      </StackPanel>

      <Border
          Padding="{controls:Inset Md}"
          Background="{DynamicResource ShellDangerSoftBrush}"
          BorderBrush="{DynamicResource ShellDangerBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource ShellCardCornerRadius}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon
              Symbol="Warning"
              FontSize="18"
              Foreground="{DynamicResource ShellDangerBrush}" />
          <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Foreground="{DynamicResource ShellDangerBrush}" Text="High-risk run override" />
            <TextBlock
                Text="Terminal input and destructive terminal actions can execute without per-action approval until this window expires."
                TextWrapping="Wrap" />
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize10}"
                Text="Exact target scope, provider isolation, human-input preemption, Stop, secret non-disclosure, and audit remain enforced."
                TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <controls:SurfaceCard Padding="0">
        <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="Exact terminal scope" />
          <TextBlock x:Name="TargetTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock
              x:Name="ExactTarget"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize9}"
              TextWrapping="Wrap" />
          <StackPanel Margin="{controls:Inset Top=Xs}" Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Connection" />
            <TextBlock
                x:Name="ConnectionBoundary"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock Classes="Eyebrow" Text="Working directory" />
            <TextBlock
                x:Name="WorkingDirectory"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="Eyebrow" Margin="{controls:Inset Top=Xs}" Text="Duration" />
          <TextBlock Text="15 minutes · this run only" />
        </StackPanel>
      </controls:SurfaceCard>

      <CheckBox
          x:Name="Acknowledgement"
          Click="OnAcknowledgementChanged"
          AutomationProperties.Name="I understand destructive terminal actions will not ask again during this 15-minute window"
          AutomationProperties.HelpText="Required acknowledgement before enabling the run-only YOLO override">
        <TextBlock
            Text="I understand that destructive terminal actions will not ask again during this window."
            TextWrapping="Wrap" />
      </CheckBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button
          Classes="SecondaryButton"
          Click="OnCancelClick"
          Content="Cancel"
          IsCancel="True"
          AutomationProperties.Name="Cancel enabling YOLO" />
      <Button
          x:Name="ConfirmButton"
          Classes="DestructiveButton"
          Click="OnConfirmClick"
          Content="Enable YOLO"
          IsEnabled="False"
          IsDefault="True"
          AutomationProperties.Name="Enable YOLO for 15 minutes" />
    </StackPanel>
  </Grid>
</Window>
