<Window
    x:Class="GhostShell.App.Views.RecoveryDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Recover GhostSHELL"
    Width="560"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="{controls:Inset Xl}" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="GhostSHELL did not close cleanly" />
      <TextBlock
          Classes="Muted"
          Text="Saved connections, screens, and workspaces are intact. Choose how to handle the previous runtime state."
          TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Padding="{controls:Inset Md}" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}">
      <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
        <TextBlock FontWeight="SemiBold" Text="Recovery choices" />
        <TextBlock Classes="Muted" Text="Restore reopens the saved runtime snapshot." TextWrapping="Wrap" />
        <TextBlock Classes="Muted" Text="Safe mode starts without reopening it and does not delete the stored snapshot." TextWrapping="Wrap" />
        <TextBlock Classes="Muted" Text="Discard removes runtime state only; durable definitions are never deleted." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button
          MinWidth="104"
          Click="OnDiscardClick"
          Content="Discard state"
          AutomationProperties.Name="Discard previous runtime state" />
      <Button
          MinWidth="104"
          Click="OnSafeModeClick"
          Content="Safe mode"
          AutomationProperties.Name="Start GhostSHELL in safe mode" />
      <Button
          MinWidth="104"
          Click="OnRestoreClick"
          Content="Restore"
          AutomationProperties.Name="Restore previous runtime state" />
    </StackPanel>
  </Grid>
</Window>
