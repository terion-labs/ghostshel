<UserControl
    x:Class="GhostShell.App.Views.AgentWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <Border Classes="AgentPanel">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Grid MinHeight="64" Margin="14,0" ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="AI agent" />
          <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.ScopeLabel}" TextTrimming="CharacterEllipsis" />
          <TextBlock
              Classes="Muted Monospace"
              FontSize="{DynamicResource ShellFontSize8}"
              Text="{Binding AgentChat.TargetContextLabel}"
              TextTrimming="CharacterEllipsis"
              IsVisible="{Binding AgentChat.HasTargetContext}" />
        </StackPanel>
        <Border
            Grid.Column="1"
            VerticalAlignment="Center"
            Classes="StatusPill"
            Classes.Warning="{Binding AgentChat.NeedsProviderAttention}">
          <TextBlock
              Text="{Binding AgentChat.ConnectionStatus}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="{Binding AgentChat.ConnectionStatus, StringFormat={}AI agent state · {0}}" />
        </Border>
      </Grid>
      <Grid
          Grid.Row="1"
          MinHeight="48"
          Margin="10,0,10,8"
          RowDefinitions="Auto,Auto,Auto"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="9"
          RowSpacing="6">
        <TextBlock VerticalAlignment="Center" Classes="Eyebrow" Text="PROVIDER" />
        <ComboBox
            Grid.Column="1"
            MinWidth="210"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AgentChat.Providers}"
            SelectedItem="{Binding AgentChat.SelectedProvider, Mode=TwoWay}"
            IsEnabled="{Binding AgentChat.CanChangeProvider}"
            AutomationProperties.Name="AI agent provider">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock
            Grid.Row="1"
            VerticalAlignment="Center"
            Classes="Eyebrow"
            Text="SCOPE" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="210"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AgentRunScopeOptions}"
            SelectedItem="{Binding SelectedAgentRunScope, Mode=TwoWay}"
            IsEnabled="{Binding AgentChat.CanChangeProvider}"
            AutomationProperties.Name="AI agent target scope"
            AutomationProperties.HelpText="Choose the terminal boundary before starting the governed run">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,2,0,0"
            Padding="9"
            Background="{DynamicResource ShellSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsEnabled="{Binding AgentChat.CanChangeProvider}"
            IsVisible="{Binding IsAgentSelectedPanelsScope}"
            AutomationProperties.Name="Selected terminals for the AI agent"
            AutomationProperties.HelpText="Choose exact live terminals. Terminal and tab labels are untrusted metadata; stable IDs are shown below.">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="Eyebrow" Text="SELECT TERMINALS" />
              <TextBlock
                  Grid.Column="1"
                  Classes="Muted Monospace"
                  FontSize="{DynamicResource ShellFontSize8}"
                  Text="{Binding AgentTerminalSelectionSummary}" />
            </Grid>
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="Choose exact live terminals. Names below are untrusted labels."
                TextWrapping="Wrap" />
            <ScrollViewer
                MaxHeight="156"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                IsVisible="{Binding HasAgentTerminalSelectionOptions}"
                AutomationProperties.Name="Available live terminals">
              <ItemsControl ItemsSource="{Binding AgentTerminalSelectionOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox
                        Margin="0,2"
                        HorizontalAlignment="Stretch"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding AutomationName}"
                        AutomationProperties.HelpText="{Binding AutomationHelpText}">
                      <StackPanel Margin="4,0,0,0" Spacing="1">
                        <TextBlock Text="{Binding PanelTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="Muted"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding TabTitle, StringFormat={}Tab · {0}}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="Muted Monospace"
                            FontSize="{DynamicResource ShellFontSize8}"
                            Text="{Binding IdentityLabel}"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding AgentTerminalSelectionStatus}"
                TextWrapping="Wrap"
                IsVisible="{Binding !HasAgentTerminalSelectionError}"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock
                Foreground="{DynamicResource ShellDangerBrush}"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding AgentTerminalSelectionStatus}"
                TextWrapping="Wrap"
                IsVisible="{Binding HasAgentTerminalSelectionError}"
                AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
        </Border>
      </Grid>
      <ScrollViewer
          x:Name="AgentChatTranscript"
          Grid.Row="2"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto"
          ScrollChanged="OnAgentChatTranscriptScrollChanged"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding AgentChat.Status, StringFormat={}AI agent activity · {0}}">
        <StackPanel>
          <Border
              Margin="10,0,10,8"
              Padding="11"
              Background="{DynamicResource ShellDangerSoftBrush}"
              BorderBrush="{DynamicResource ShellDangerBorderBrush}"
              BorderThickness="1"
              CornerRadius="9"
              IsVisible="{Binding AgentChat.HasYoloAuthority}"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding AgentChat.YoloAuthority.Scope, StringFormat={}YOLO enabled · exact scope {0}}">
            <StackPanel Spacing="7">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Classes="StatusPill Danger" HorizontalAlignment="Left">
                  <TextBlock Text="YOLO ENABLED" />
                </Border>
                <TextBlock Grid.Column="1" Classes="Eyebrow" VerticalAlignment="Center" Text="{Binding AgentChat.YoloAuthority.Duration}" />
              </Grid>
              <TextBlock Text="{Binding AgentChat.YoloAuthority.Warning}" TextWrapping="Wrap" />
              <StackPanel Spacing="2">
                <TextBlock Classes="Eyebrow" Text="EXACT SCOPE" />
                <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize8}" Text="{Binding AgentChat.YoloAuthority.Scope}" TextWrapping="Wrap" />
                <TextBlock
                    Classes="Muted Monospace"
                    FontSize="{DynamicResource ShellFontSize8}"
                    Text="{Binding AgentChat.TargetContextLabel}"
                    TextWrapping="Wrap"
                    IsVisible="{Binding AgentChat.HasTargetContext}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.YoloAuthority.ExpiresAt, StringFormat={}Expires · {0}}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                <Button
                    Classes="DestructiveButton"
                    Click="OnDisableAgentYoloClick"
                    Content="Disable now"
                    IsEnabled="{Binding AgentChat.CanDisableYolo}"
                    AutomationProperties.Name="Disable YOLO now" />
                <Button
                    Grid.Column="1"
                    Classes="SecondaryButton"
                    Click="OnCancelAgentChatClick"
                    Content="Stop run"
                    IsEnabled="{Binding AgentChat.CanRequestStop}"
                    AutomationProperties.Name="Stop AI agent run and revoke YOLO" />
              </Grid>
            </StackPanel>
          </Border>
          <Border
              Margin="10,0,10,8"
              Padding="10"
              Background="{DynamicResource ShellSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              IsVisible="{Binding AgentChat.HasCapabilityNotice}"
              AutomationProperties.Name="{Binding AgentChat.CapabilityNotice, StringFormat={}AI agent terminal capability · {0}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <icons:SymbolIcon Symbol="Shield" FontSize="17" Foreground="{DynamicResource ShellWarningBrush}" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="Eyebrow" Text="{Binding AgentChat.CapabilityLabel}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding AgentChat.CapabilityNotice}" TextWrapping="Wrap" />
                <TextBlock
                    FontSize="{DynamicResource ShellFontSize9}"
                    FontWeight="SemiBold"
                    Text="{Binding AgentChat.TargetTitle}"
                    TextWrapping="Wrap"
                    IsVisible="{Binding AgentChat.HasExactTarget}" />
                <TextBlock
                    Classes="Muted Monospace"
                    FontSize="{DynamicResource ShellFontSize8}"
                    Text="{Binding AgentChat.ExactTarget}"
                    TextWrapping="Wrap"
                    IsVisible="{Binding AgentChat.HasExactTarget}" />
                <Grid
                    Margin="0,3,0,0"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="7"
                    IsVisible="{Binding AgentChat.HasTargetContext}">
                  <TextBlock Classes="Eyebrow" FontSize="{DynamicResource ShellFontSize8}" Text="CONTEXT" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="Muted Monospace"
                      FontSize="{DynamicResource ShellFontSize8}"
                      Text="{Binding AgentChat.TargetContextLabel}"
                      TextWrapping="Wrap" />
                </Grid>
                <Expander
                    x:Name="AgentContextInspector"
                    Margin="0,4,0,0"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{Binding AgentChat.IsContextInspectorExpanded, Mode=TwoWay}"
                    IsVisible="{Binding AgentChat.HasContextItems}"
                    AutomationProperties.Name="{Binding AgentChat.ContextInspectorAccessibleName}"
                    AutomationProperties.HelpText="Shows the exact fixed terminals and host-verified operations in this governed run">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock FontWeight="SemiBold" Text="Inspect context" />
                      <TextBlock
                          Grid.Column="1"
                          Classes="Muted Monospace"
                          FontSize="{DynamicResource ShellFontSize8}"
                          Text="{Binding AgentChat.ContextInspectorSummary}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="0,7,0,0" Spacing="6">
                    <TextBlock
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize9}"
                        Text="Display labels and terminal metadata are untrusted."
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentChat.ContextItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                              Margin="0,0,0,6"
                              Padding="9"
                              Background="{DynamicResource ShellSurfaceBrush}"
                              BorderBrush="{DynamicResource ShellBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              AutomationProperties.Name="{Binding AccessibleName}">
                            <StackPanel Spacing="3">
                              <TextBlock
                                  FontWeight="SemiBold"
                                  Text="{Binding Title}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Classes="Eyebrow"
                                  FontSize="{DynamicResource ShellFontSize8}"
                                  Text="{Binding State}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Classes="Muted"
                                  FontSize="{DynamicResource ShellFontSize9}"
                                  Text="{Binding TabTitle, StringFormat={}Tab · {0}}"
                                  TextTrimming="CharacterEllipsis" />
                              <TextBlock
                                  Classes="Muted Monospace"
                                  FontSize="{DynamicResource ShellFontSize8}"
                                  Text="{Binding ExactIdentity}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Classes="Muted Monospace"
                                  FontSize="{DynamicResource ShellFontSize8}"
                                  Text="{Binding Context}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Classes="Muted Monospace"
                                  FontSize="{DynamicResource ShellFontSize8}"
                                  Text="{Binding Operations, StringFormat={}Operations · {0}}"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
                <Expander
                    Margin="0,4,0,0"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding AgentChat.EffectivePolicySummary, StringFormat={}Inspect effective agent policy · {0}}"
                    AutomationProperties.HelpText="Shows the trusted policy captured for the current governed run">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock FontWeight="SemiBold" Text="Effective policy" />
                      <TextBlock
                          Grid.Column="1"
                          Classes="Muted Monospace"
                          FontSize="{DynamicResource ShellFontSize8}"
                          Text="{Binding AgentChat.PolicyModeLabel}" />
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="0,7,0,0" Spacing="6">
                    <TextBlock
                        Classes="Muted Monospace"
                        FontSize="{DynamicResource ShellFontSize8}"
                        Text="{Binding AgentChat.EffectivePolicySummary}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding AgentChat.EffectivePolicyCapabilities}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid
                              Margin="0,2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              AutomationProperties.Name="{Binding AccessibleName}">
                            <TextBlock
                                Classes="Muted"
                                FontSize="{DynamicResource ShellFontSize9}"
                                Text="{Binding Capability}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="Eyebrow"
                                FontSize="{DynamicResource ShellFontSize8}"
                                Text="{Binding Permission}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Classes="SecondaryButton"
                    Click="OnEnableAgentYoloClick"
                    Content="Enable run-only YOLO…"
                    IsEnabled="{Binding AgentChat.CanEnableYolo}"
                    IsVisible="{Binding AgentChat.CanOfferYolo}"
                    AutomationProperties.Name="Review and enable run-only YOLO" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid>
        <StackPanel
            Margin="18,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            IsVisible="{Binding AgentChat.HasNoProvider}">
          <Border Width="54" Height="54" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="16"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Bot" FontSize="27" Foreground="{DynamicResource ShellAccentBrush}" /></Border>
          <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="Connect an AI provider" TextAlignment="Center" />
          <TextBlock MaxWidth="270" Classes="Muted" Text="Add an Anthropic, OpenAI, or compatible endpoint. Credentials stay in the OS vault and panel actions remain broker-governed." TextAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="SecondaryButton" Click="OnShowAgentSettingsClick" Content="Open provider settings" />
        </StackPanel>
        <StackPanel
            Margin="18,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            IsVisible="{Binding AgentChat.CanStartConversation}">
          <Border Width="54" Height="54" Background="{DynamicResource ShellAccentSoftBrush}" CornerRadius="16"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Bot" FontSize="27" Foreground="{DynamicResource ShellAccentBrush}" /></Border>
          <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="Delegate in this workspace" TextAlignment="Center" />
          <TextBlock MaxWidth="270" Classes="Muted" Text="The agent stays bound to the selected live panel scope. Reads are bounded, mutations are one action at a time, and risky work waits for your approval." TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
            <StackPanel
                Margin="10,2"
                Spacing="9"
                IsVisible="{Binding AgentChat.HasAgentContent}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding AgentChat.Status, StringFormat={}AI agent transcript and activity · {0}}">
            <ItemsControl ItemsSource="{Binding AgentChat.Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,9">
                    <Border
                        MaxWidth="278"
                        Padding="11,9"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource ShellAccentSoftBrush}"
                        BorderBrush="{DynamicResource ShellNoticeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10,10,3,10"
                        IsVisible="{Binding IsUser}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="Eyebrow Accent" Text="{Binding Author}" />
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border
                        MaxWidth="292"
                        Padding="11,9"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ShellSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10,10,10,3"
                        IsVisible="{Binding IsAssistant}">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="Eyebrow" Text="{Binding Author}" />
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border
                MaxWidth="292"
                Padding="11,9"
                HorizontalAlignment="Left"
                Background="{DynamicResource ShellSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource ShellAccentBrush}"
                BorderThickness="1"
                CornerRadius="10,10,10,3"
                IsVisible="{Binding AgentChat.HasProvisionalAssistantText}">
              <StackPanel Spacing="4">
                <TextBlock Classes="Eyebrow Accent" Text="GHOSTSHELL · RESPONDING" />
                <TextBlock
                    Text="{Binding AgentChat.ProvisionalAssistantText}"
                    TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="AI response in progress" />
              </StackPanel>
            </Border>
            <Border
                x:Name="AgentCurrentProgress"
                Padding="11,9"
                Classes="AgentProgressCard"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                IsVisible="{Binding AgentChat.HasCurrentProgress}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding AgentChat.CurrentProgress.AccessibleName}"
                AutomationProperties.HelpText="Live status reported by the AI model. This text is not durable audit evidence">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="Eyebrow Accent" Text="AGENT PROGRESS" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="Eyebrow Monospace"
                      Text="{Binding AgentChat.CurrentProgress.PercentLabel}"
                      IsVisible="{Binding AgentChat.CurrentProgress.HasPercent}" />
                </Grid>
                <TextBlock
                    Text="{Binding AgentChat.CurrentProgress.Message}"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Height="3"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding AgentChat.CurrentProgress.ProgressValue}"
                    IsIndeterminate="{Binding AgentChat.CurrentProgress.IsIndeterminate}"
                    AutomationProperties.Name="{Binding AgentChat.CurrentProgress.AccessibleName}" />
              </StackPanel>
            </Border>
            <Border
                x:Name="AgentPendingQuestion"
                Padding="12,11"
                Classes="NoticeCard"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                IsVisible="{Binding AgentChat.HasPendingQuestion}"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding AgentChat.PendingQuestion.AccessibleName}"
                AutomationProperties.HelpText="{Binding AgentChat.PendingQuestion.ResponseWarning}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Eyebrow" Text="INPUT NEEDED" />
                    <TextBlock
                        FontSize="{DynamicResource ShellFontSize13}"
                        FontWeight="SemiBold"
                        Text="Untrusted model question"
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <Border
                      Grid.Column="1"
                      VerticalAlignment="Top"
                      Classes="StatusPill"
                      Classes.Warning="True">
                    <TextBlock Text="NOT APPROVAL" />
                  </Border>
                </Grid>
                <TextBlock
                    Text="{Binding AgentChat.PendingQuestion.Question}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="{Binding AgentChat.PendingQuestion.ExpiresAt, StringFormat={}Expires · {0}}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="8"
                    Background="{DynamicResource ShellWarningSoftBrush}"
                    BorderBrush="{DynamicResource ShellWarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <icons:SymbolIcon
                        Symbol="Warning"
                        FontSize="14"
                        Foreground="{DynamicResource ShellWarningBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize9}"
                        Text="{Binding AgentChat.PendingQuestion.ResponseWarning}"
                        TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Classes="Eyebrow" Text="YOUR ANSWER" />
                  <TextBox
                      x:Name="AgentQuestionResponseInput"
                      MinHeight="36"
                      Padding="8"
                      AcceptsReturn="False"
                      MaxLength="2048"
                      Text="{Binding AgentChat.QuestionResponseDraft, Mode=TwoWay}"
                      TextWrapping="NoWrap"
                      IsEnabled="{Binding AgentChat.CanRespondToQuestion}"
                      KeyDown="OnAgentQuestionResponseKeyDown"
                      TabIndex="0"
                      AutomationProperties.Name="Answer the AI agent question"
                      AutomationProperties.HelpText="Single-line non-sensitive clarification only. This is not approval. Do not enter credentials." />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Button
                      Classes="SecondaryButton"
                      Click="OnDeclineAgentQuestionClick"
                      Content="Skip / decline"
                      IsEnabled="{Binding AgentChat.CanDeclineQuestion}"
                      TabIndex="1"
                      AutomationProperties.Name="Skip or decline the AI agent question"
                      AutomationProperties.HelpText="Continues without an answer and grants no authority" />
                  <Button
                      Grid.Column="1"
                      Classes="PrimaryButton"
                      Click="OnSubmitAgentQuestionClick"
                      Content="Send answer"
                      IsEnabled="{Binding AgentChat.CanSubmitQuestionResponse}"
                      TabIndex="2"
                      AutomationProperties.Name="Send non-sensitive answer to the AI agent"
                      AutomationProperties.HelpText="Sends clarification only; it does not approve an action" />
                </Grid>
              </StackPanel>
            </Border>
            <Border
                x:Name="AgentPendingCapabilityRequest"
                Padding="12,11"
                Classes="NoticeCard"
                Focusable="True"
                KeyboardNavigation.IsTabStop="True"
                IsVisible="{Binding AgentChat.HasPendingCapabilityRequest}"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding AgentChat.PendingCapabilityRequest.AccessibleName}"
                AutomationProperties.HelpText="{Binding AgentChat.PendingCapabilityRequest.GrantWarning}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Eyebrow" Text="CAPABILITY REQUEST" />
                    <TextBlock
                        FontSize="{DynamicResource ShellFontSize13}"
                        FontWeight="SemiBold"
                        Text="{Binding AgentChat.PendingCapabilityRequest.DisplayTitle}"
                        TextWrapping="Wrap" />
                  </StackPanel>
                  <Border
                      Grid.Column="1"
                      VerticalAlignment="Top"
                      Classes="StatusPill"
                      Classes.Warning="True">
                    <TextBlock Text="OFF → ASK" />
                  </Border>
                </Grid>
                <TextBlock
                    Classes="Muted Monospace"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="{Binding AgentChat.PendingCapabilityRequest.CapabilityToken, StringFormat={}Capability · {0}}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                  <TextBlock Classes="Eyebrow" Text="EXACT RUN TARGET" />
                  <TextBlock
                      Classes="Monospace"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding AgentChat.PendingCapabilityRequest.ExactTarget}"
                      TextWrapping="Wrap" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding AgentChat.PendingCapabilityRequest.TargetTitle}"
                      TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Classes="Eyebrow" Text="AFFECTED TOOLS" />
                  <ItemsControl ItemsSource="{Binding AgentChat.PendingCapabilityRequest.AffectedToolTitles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock
                            Margin="0,0,0,2"
                            FontSize="{DynamicResource ShellFontSize9}"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="{Binding AgentChat.PendingCapabilityRequest.ExpiresAt, StringFormat={}Expires · {0}}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="8"
                    Background="{DynamicResource ShellWarningSoftBrush}"
                    BorderBrush="{DynamicResource ShellWarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <icons:SymbolIcon
                        Symbol="Warning"
                        FontSize="14"
                        Foreground="{DynamicResource ShellWarningBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Classes="Muted"
                        FontSize="{DynamicResource ShellFontSize9}"
                        Text="{Binding AgentChat.PendingCapabilityRequest.GrantWarning}"
                        TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Button
                      Classes="SecondaryButton"
                      Click="OnKeepAgentCapabilityOffClick"
                      Content="Keep Off"
                      IsEnabled="{Binding AgentChat.CanDecideCapabilityRequest}"
                      TabIndex="0"
                      AutomationProperties.Name="Keep this AI agent capability Off"
                      AutomationProperties.HelpText="Declines the run-local capability request and grants no authority" />
                  <Button
                      Grid.Column="1"
                      Classes="PrimaryButton"
                      Click="OnEnableAgentCapabilityAskClick"
                      Content="Enable Ask for this run"
                      IsEnabled="{Binding AgentChat.CanDecideCapabilityRequest}"
                      TabIndex="1"
                      AutomationProperties.Name="Enable Ask for this capability for this run"
                      AutomationProperties.HelpText="Changes this one capability from Off to Ask for the current run; it approves no action" />
                </Grid>
              </StackPanel>
            </Border>
            <Border
                Padding="11,9"
                Background="{DynamicResource ShellSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource ShellAccentBrush}"
                BorderThickness="1"
                CornerRadius="9"
                IsVisible="{Binding AgentChat.HasActiveTool}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="AI agent tool activity">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="Eyebrow Accent" Text="TOOL ACTIVE" />
                  <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding AgentChat.ActiveTool.Risk}" />
                </Grid>
                <TextBlock FontWeight="SemiBold" Text="{Binding AgentChat.ActiveTool.ToolTitle}" TextWrapping="Wrap" />
                <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.ActiveTool.ToolName}" TextWrapping="Wrap" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding AgentChat.ActiveTool.TargetTitle}" TextWrapping="Wrap" />
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Classes="SecondaryButton"
                    Click="OnCancelAgentActionClick"
                    Content="{Binding AgentChat.ActiveActionCancellationLabel}"
                    IsEnabled="{Binding AgentChat.CanCancelActiveAction}"
                    AutomationProperties.Name="{Binding AgentChat.ActiveActionCancellationLabel, StringFormat={}AI agent · {0}}"
                    AutomationProperties.HelpText="Requests cancellation of only this terminal action; completed terminal effects are not undone. The governed run remains available" />
              </StackPanel>
            </Border>
            <Border
                Padding="12,11"
                Classes="NoticeCard"
                IsVisible="{Binding AgentChat.HasPendingApproval}"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="AI agent action approval request">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="Eyebrow" Text="APPROVAL REQUIRED" />
                    <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding AgentChat.PendingApproval.ToolTitle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" VerticalAlignment="Top" Classes="StatusPill" Classes.Warning="True">
                    <TextBlock Text="{Binding AgentChat.PendingApproval.Permission, StringFormat={}{0} · ONCE}" />
                  </Border>
                  <Border Grid.Column="2" VerticalAlignment="Top" Classes="StatusPill" Classes.Warning="True">
                    <TextBlock Text="{Binding AgentChat.PendingApproval.Risk}" />
                  </Border>
                </Grid>
                <TextBlock
                    Classes="Muted Monospace"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="{Binding AgentChat.PendingApproval.ToolName, StringFormat={}Tool · {0}}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                  <TextBlock Classes="Eyebrow" Text="EXACT TARGET" />
                  <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.ExactTarget}" TextWrapping="Wrap" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.TargetTitle}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                  <TextBlock Classes="Eyebrow" Text="HOST" />
                  <TextBlock Grid.Column="1" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.Host}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Classes="Eyebrow" Text="WORKDIR" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.WorkingDirectory}" TextWrapping="Wrap" />
                </Grid>
                <StackPanel Spacing="3" IsVisible="{Binding AgentChat.PendingApproval.HasArguments}">
                  <TextBlock Classes="Eyebrow" Text="MATERIAL ARGUMENTS" />
                  <ItemsControl ItemsSource="{Binding AgentChat.PendingApproval.Arguments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,3" ColumnDefinitions="Auto,*" ColumnSpacing="7">
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Name, StringFormat={}{0}:}" />
                          <TextBlock Grid.Column="1" Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayValue}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.ExpiresAt, StringFormat={}Expires · {0}}" TextWrapping="Wrap" />
                <Border
                    Padding="8"
                    Background="{DynamicResource ShellWarningSoftBrush}"
                    BorderBrush="{DynamicResource ShellWarningBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsVisible="{Binding AgentChat.PendingApproval.TemporarilyYieldsTerminalInput}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <icons:SymbolIcon Symbol="Warning" FontSize="14" Foreground="{DynamicResource ShellWarningBrush}" />
                    <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.InputYieldWarning}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button
                      Classes="SecondaryButton"
                      Click="OnDenyAgentActionClick"
                      Content="Deny"
                      IsEnabled="{Binding AgentChat.CanDecideApproval}"
                      AutomationProperties.Name="Deny AI agent action" />
                  <Button
                      Grid.Column="1"
                      Classes="PrimaryButton"
                      Click="OnApproveAgentActionClick"
                      Content="Approve once"
                      IsEnabled="{Binding AgentChat.CanDecideApproval}"
                      AutomationProperties.Name="Approve AI agent action once" />
                </Grid>
              </StackPanel>
            </Border>
            <Expander
                x:Name="AgentRunAudit"
                Margin="0,2,0,0"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{Binding AgentChat.IsAuditExpanded, Mode=TwoWay}"
                IsVisible="{Binding AgentChat.CanShowAudit}"
                AutomationProperties.Name="Inspect durable AI agent audit evidence"
                AutomationProperties.HelpText="Shows bounded secret-free action and policy evidence for the exact current run">
              <Expander.Header>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <icons:SymbolIcon
                      VerticalAlignment="Center"
                      Symbol="History"
                      FontSize="14"
                      Foreground="{DynamicResource ShellAccentBrush}" />
                  <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Text="Audit evidence" />
                  <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Classes="Muted Monospace"
                      FontSize="{DynamicResource ShellFontSize8}"
                      Text="{Binding AgentChat.AuditSummary}" />
                </Grid>
              </Expander.Header>
              <StackPanel Margin="0,7,0,0" Spacing="7">
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="Durable phases only. Arguments, terminal content, page data, file data, labels, and actor identifiers are never shown here."
                    TextWrapping="Wrap" />
                <ProgressBar
                    Height="3"
                    IsIndeterminate="True"
                    IsVisible="{Binding AgentChat.IsAuditLoading}"
                    AutomationProperties.Name="Loading durable agent audit evidence" />
                <ItemsControl ItemsSource="{Binding AgentChat.AuditEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                          Margin="0,0,0,6"
                          Padding="9"
                          Background="{DynamicResource ShellSurfaceBrush}"
                          BorderBrush="{DynamicResource ShellBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="7"
                          AutomationProperties.Name="{Binding AccessibleName}">
                        <StackPanel Spacing="3">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                            <StackPanel Spacing="2">
                              <TextBlock
                                  Classes="Eyebrow Accent"
                                  FontSize="{DynamicResource ShellFontSize8}"
                                  Text="{Binding Kind}" />
                              <TextBlock
                                  FontWeight="SemiBold"
                                  Text="{Binding Title}"
                                  TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Classes="StatusPill">
                              <TextBlock Text="{Binding Outcome}" />
                            </Border>
                          </Grid>
                          <TextBlock
                              Classes="Muted Monospace"
                              FontSize="{DynamicResource ShellFontSize8}"
                              Text="{Binding ToolName}"
                              TextWrapping="Wrap"
                              IsVisible="{Binding HasToolName}" />
                          <TextBlock
                              Classes="Muted"
                              FontSize="{DynamicResource ShellFontSize9}"
                              Text="{Binding Evidence}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Classes="Monospace"
                              FontSize="{DynamicResource ShellFontSize8}"
                              Text="{Binding Timeline}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Classes="Muted Monospace"
                              FontSize="{DynamicResource ShellFontSize8}"
                              Text="{Binding Result}"
                              TextWrapping="Wrap"
                              IsVisible="{Binding HasResult}" />
                          <TextBlock
                              Classes="Muted Monospace"
                              FontSize="{DynamicResource ShellFontSize8}"
                              Text="{Binding TargetBinding}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Classes="Muted"
                              FontSize="{DynamicResource ShellFontSize8}"
                              Text="{Binding OccurredAt}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize9}"
                    Text="{Binding AgentChat.AuditStatus}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{Binding AgentChat.AuditStatus, StringFormat={}AI agent audit status · {0}}" />
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7">
                  <Button
                      Classes="SecondaryButton"
                      Click="OnRefreshAgentAuditClick"
                      Content="Refresh"
                      IsEnabled="{Binding AgentChat.CanRefreshAudit}"
                      AutomationProperties.Name="Refresh current AI agent audit evidence" />
                  <Button
                      Grid.Column="1"
                      Classes="TextButton"
                      Click="OnLoadOlderAgentAuditClick"
                      Content="Load older"
                      IsEnabled="{Binding AgentChat.CanLoadOlderAudit}"
                      AutomationProperties.Name="Load older AI agent audit evidence" />
                </Grid>
              </StackPanel>
            </Expander>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="3" Margin="10,7" Padding="9" Background="{DynamicResource ShellSurfaceRaisedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="9">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBox
              x:Name="AgentChatPromptInput"
              MinHeight="58"
              MaxHeight="116"
              Padding="8"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              MaxLength="65536"
              Text="{Binding AgentChat.Prompt, Mode=TwoWay}"
              IsEnabled="{Binding AgentChat.CanEnterPrompt}"
              PlaceholderText="{Binding AgentChat.PromptPlaceholder}"
              AutomationProperties.Name="AI agent prompt" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
            <Button
                Classes="TextButton"
                Click="OnClearAgentChatClick"
                Content="Clear"
                IsEnabled="{Binding AgentChat.CanClear}"
                AutomationProperties.Name="Clear AI agent run" />
            <Button
                Grid.Column="1"
                Classes="SecondaryButton"
                Click="OnCancelAgentChatClick"
                Content="Stop"
                IsEnabled="{Binding AgentChat.CanRequestStop}"
                IsVisible="{Binding AgentChat.CanStop}"
                AutomationProperties.Name="Stop AI agent run" />
            <Button
                Grid.Column="2"
                Classes="PrimaryButton"
                Click="OnSendAgentChatClick"
                Content="{Binding AgentChat.PrimaryActionLabel}"
                IsEnabled="{Binding AgentChat.CanSubmitPrompt}"
                IsVisible="{Binding AgentChat.CanShowPrimaryAction}"
                AutomationProperties.Name="{Binding AgentChat.PrimaryActionAccessibleName}" />
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="4" MinHeight="30" Margin="12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize9}"
            Text="{Binding AgentChat.Status}"
            TextWrapping="Wrap"
            ToolTip.Tip="{Binding AgentChat.Status}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding AgentChat.Status, StringFormat={}AI agent status · {0}}" />
        <TextBlock Grid.Column="1" Classes="Eyebrow" Text="{Binding AgentChat.PolicyModeLabel}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
