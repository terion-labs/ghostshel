<Window
    x:Class="GhostShell.App.Views.FileProviderProfileEditorDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="File provider"
    Width="820"
    Height="780"
    MinWidth="700"
    MinHeight="620"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="62,*,72">
    <Grid Margin="20,0" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding EditorTitle}" />
        <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding ProfileId, StringFormat={}Profile: {0}}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="IconButton" Click="OnCancelClick" Content="×" IsCancel="True" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="20,8,20,24" Spacing="14">
        <Border Classes="SettingsCard">
          <Grid Margin="16" ColumnDefinitions="2*,*" ColumnSpacing="10">
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Name" /><TextBox Text="{Binding Name}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Provider kind" /><ComboBox ItemsSource="{Binding ProviderKinds}" SelectedItem="{Binding Kind}" /></StackPanel>
          </Grid>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsLocal}">
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Classes="SectionHeading" Text="LOCAL FILESYSTEM" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="The adapter is confined to this existing directory and does not follow links outside it." />
            <TextBox Classes="Monospace" Text="{Binding LocalRoot}" PlaceholderText="Absolute directory path" />
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsS3}">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Classes="SectionHeading" Text="S3 / S3-COMPATIBLE" />
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
              <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Bucket" /><TextBox Text="{Binding BucketName}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Region" /><TextBox Text="{Binding Region}" PlaceholderText="us-east-1" /></StackPanel>
            </Grid>
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Service URI" /><TextBox Classes="Monospace" Text="{Binding ServiceUri}" PlaceholderText="Optional HTTPS endpoint for compatible services" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Initial prefix" /><TextBox Classes="Monospace" Text="{Binding RootPrefix}" PlaceholderText="Optional/path/prefix" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16"><CheckBox IsChecked="{Binding ForcePathStyle}" Content="Force path-style requests" /><CheckBox IsChecked="{Binding AllowInsecureTransport}" Content="Acknowledge HTTP transport" /></StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsSftp}">
          <StackPanel Margin="16" Spacing="10">
            <TextBlock Classes="SectionHeading" Text="SFTP" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="SFTP reuses the selected SSH endpoint, authentication reference, and durable host-key trust used by terminal SSH." TextWrapping="Wrap" />
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="SSH connection" /><ComboBox ItemsSource="{Binding SshConnections}" SelectedItem="{Binding SelectedSshConnection}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Remote root" /><TextBox Classes="Monospace" Text="{Binding RemoteRoot}" /></StackPanel>
            <Border Classes="NoticeCard" IsVisible="{Binding HasHostKeyReview}">
              <StackPanel Margin="14" Spacing="7">
                <TextBlock FontWeight="SemiBold" Text="{Binding HostKeyReviewTitle}" />
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HostKeyReviewStatus}" TextWrapping="Wrap" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="Eyebrow" Text="PRESENTED" />
                  <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding PresentedHostKey}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="3" IsVisible="{Binding HasTrustedHostKey}">
                  <TextBlock Classes="Eyebrow" Text="CURRENTLY TRUSTED" />
                  <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TrustedHostKey}" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Left"
                    Classes="DangerButton"
                    Click="OnTrustHostKeyClick"
                    Content="{Binding HostKeyActionText}"
                    IsEnabled="{Binding CanApplyHostKeyTrust}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsFtp}">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Classes="SectionHeading" Text="FTP / FTPS" />
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Host" /><TextBox Text="{Binding Host}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Port" /><NumericUpDown Minimum="1" Maximum="65535" Value="{Binding Port}" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="TLS mode" /><ComboBox ItemsSource="{Binding FtpSecurityModes}" SelectedItem="{Binding FtpSecurity}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Data connection" /><ComboBox ItemsSource="{Binding FtpConnectionModes}" SelectedItem="{Binding FtpConnectionMode}" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Username" /><TextBox Text="{Binding Username}" PlaceholderText="Blank for anonymous" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Remote root" /><TextBox Classes="Monospace" Text="{Binding RemoteRoot}" /></StackPanel></Grid>
            <CheckBox IsVisible="{Binding IsPlaintextFtp}" IsChecked="{Binding AllowPlaintext}" Content="I understand plaintext FTP exposes credentials and files" />
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsSmb}">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Classes="SectionHeading" Text="SMB 2/3" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Server" /><TextBox Text="{Binding Server}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Share" /><TextBox Text="{Binding Share}" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Authentication" /><ComboBox ItemsSource="{Binding SmbCredentialModes}" SelectedItem="{Binding SmbCredentialMode}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Remote root" /><TextBox Classes="Monospace" Text="{Binding RemoteRoot}" /></StackPanel></Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding UsesSmbCredential}"><StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Domain" /><TextBox Text="{Binding Domain}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontWeight="SemiBold" Text="Username" /><TextBox Text="{Binding Username}" /></StackPanel></Grid>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding IsWebDav}">
          <StackPanel Margin="16" Spacing="12">
            <TextBlock Classes="SectionHeading" Text="WEBDAV" />
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Base URI" /><TextBox Classes="Monospace" Text="{Binding BaseUri}" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock FontWeight="SemiBold" Text="Username" /><TextBox Text="{Binding Username}" PlaceholderText="Blank when authentication is not required" /></StackPanel>
            <CheckBox IsChecked="{Binding AllowInsecureTransport}" Content="Acknowledge HTTP transport" />
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding UsesProviderCredential}">
          <StackPanel Margin="16" Spacing="8">
            <TextBlock Classes="SectionHeading" Text="OS-VAULT CREDENTIAL" />
            <ComboBox ItemsSource="{Binding SecretOptions}" SelectedItem="{Binding SelectedCredential}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Only opaque secret references scoped to this profile are selectable. Secret values never enter this editor. S3 credentials use JSON fields accessKeyId, secretAccessKey, and optional sessionToken." TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="NoticeCard">
          <StackPanel Margin="14" Spacing="4"><TextBlock FontWeight="SemiBold" Text="{Binding TestStatus}" /><TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding TestDetail}" TextWrapping="Wrap" /></StackPanel>
        </Border>
        <TextBlock x:Name="ValidationError" Foreground="#FF8577" IsVisible="False" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="#2C2C30" BorderThickness="0,1,0,0">
      <Grid Margin="20,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Tests perform one bounded root listing." />
        <Button Grid.Column="1" MinWidth="100" Classes="SecondaryButton" Click="OnTestClick" Content="Test" />
        <Button Grid.Column="2" MinWidth="92" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button Grid.Column="3" MinWidth="120" Classes="PrimaryButton" Click="OnSaveClick" Content="Save provider" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
