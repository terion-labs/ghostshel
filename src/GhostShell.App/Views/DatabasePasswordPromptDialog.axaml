<Window
    x:Class="GhostShell.App.Views.DatabasePasswordPromptDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Width="400"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ShellBackgroundBrush}"
    Title="Database password">
  <StackPanel Margin="{controls:Inset Xl}" Spacing="{DynamicResource ShellSpaceMd}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock x:Name="PromptTitle" FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" Text="Database password" />
      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="This connection is saved without a password. It is used for this session only." TextWrapping="Wrap" />
    </StackPanel>
    <TextBox
        x:Name="PasswordInput"
        PasswordChar="•"
        PlaceholderText="password"
        KeyDown="OnPasswordKeyDown"
        AutomationProperties.Name="Database password" />
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <Button Grid.Column="1" MinWidth="88" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" AutomationProperties.Name="Cancel the password prompt" />
      <Button Grid.Column="2" MinWidth="110" Classes="PrimaryButton" Click="OnConnectClick" Content="Connect" AutomationProperties.Name="Connect with this password" />
    </Grid>
  </StackPanel>
</Window>
