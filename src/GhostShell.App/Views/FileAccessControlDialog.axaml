<Window
    x:Class="GhostShell.App.Views.FileAccessControlDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:vm="using:GhostShell.App.ViewModels"
    Width="520"
    Height="400"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="TopChrome">
      <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock
            FontSize="{DynamicResource ShellFontSize15}"
            FontWeight="SemiBold"
            Text="{Binding ItemName}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding Summary}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!--
      One table for both models. A filesystem's three parties and an object
      store's accounts are the same question asked of different systems, so they
      are read the same way: a name, and what that name is allowed.
    -->
    <Grid Grid.Row="1" Margin="{controls:Inset Lg}" RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,150,Auto" Margin="{controls:Inset Horizontal=Md, Bottom=Xs}">
        <TextBlock Classes="Eyebrow" Text="Name" />
        <TextBlock Grid.Column="1" Classes="Eyebrow" Text="Privilege" />
        <TextBlock
            Grid.Column="2"
            Width="64"
            Classes="Eyebrow"
            Text="Run"
            TextAlignment="Center"
            IsVisible="{Binding HasMode}" />
      </Grid>

      <controls:SurfaceCard Grid.Row="1" Padding="0" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FileAccessRowViewModel">
              <Grid
                  Margin="{controls:Inset Horizontal=Md, Vertical=Xs}"
                  ColumnDefinitions="*,150,Auto"
                  ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock
                      FontSize="{DynamicResource ShellFontSize10}"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                  <TextBlock
                      Classes="Muted"
                      FontSize="{DynamicResource ShellFontSize9}"
                      Text="{Binding Detail}"
                      IsVisible="{Binding HasDetail}"
                      TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Choices}"
                    SelectedItem="{Binding Privilege, Mode=TwoWay}"
                    IsEnabled="{Binding $parent[Window].DataContext.CanEdit}"
                    AutomationProperties.Name="{Binding PrivilegeLabel}" />
                <CheckBox
                    Grid.Column="2"
                    Width="64"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    IsChecked="{Binding CanRun, Mode=TwoWay}"
                    IsVisible="{Binding ShowsExecute}"
                    IsEnabled="{Binding $parent[Window].DataContext.CanEdit}"
                    AutomationProperties.Name="{Binding Name, StringFormat={}{0} can run this}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:SurfaceCard>

      <StackPanel Grid.Row="2" Margin="{controls:Inset Top=Md}" Spacing="{DynamicResource ShellSpaceXs}">
        <!-- The number, because it is what anybody working at a shell reads,
             and because the privileges above cannot express every mode. -->
        <TextBlock
            Classes="Muted"
            FontFamily="{DynamicResource ShellDataFontFamily}"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding ModeText}"
            IsVisible="{Binding HasMode}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Permission bits" />
        <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource ShellFontSize10}"
            Text="{Binding ReadOnlyReason}"
            IsVisible="{Binding !CanEdit}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button Grid.Column="1" Classes="SecondaryButton" Click="OnCancelClick" Content="Close" />
        <Button
            Grid.Column="2"
            Classes="PrimaryButton"
            Click="OnApplyClick"
            Content="Apply"
            IsEnabled="{Binding CanEdit}"
            AutomationProperties.Name="Apply permission changes" />
      </Grid>
    </Border>
  </Grid>
</Window>
