<Window
    x:Class="GhostShell.App.Views.FileTransferDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Width="620"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Queue transfer">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="TopChrome">
      <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="SemiBold" Text="Queue file transfer" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Transfers are bounded, cancellable, and preserve provider conflict semantics." />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceLg}">
      <controls:SurfaceCard Tone="Notice" Padding="0" x:Name="ValidationCard" IsVisible="False"><TextBlock x:Name="ValidationMessage" Margin="{controls:Inset Md}" Foreground="{DynamicResource ShellDangerBrush}" TextWrapping="Wrap" /></controls:SurfaceCard>
      <controls:SurfaceCard Tone="Notice" Padding="0">
        <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="SOURCE" />
          <TextBlock Classes="Monospace" Text="{Binding Source.Name}" />
          <TextBlock Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding SourceLocation}" />
        </StackPanel>
      </controls:SurfaceCard>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="Operation" /><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}"><TextBlock FontWeight="SemiBold" Text="When destination exists" /><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding ConflictPolicy}" /></StackPanel>
      </Grid>
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="Destination provider" />
        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedDestinationProfile}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      </StackPanel>
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="Destination location" />
        <TextBox Classes="Monospace" Text="{Binding Destination}" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="The location is parsed into a structured provider address; it is never appended to a local command string." />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button Grid.Column="1" Classes="SecondaryButton" Click="OnCancelClick" Content="Cancel" />
        <Button Grid.Column="2" Classes="PrimaryButton" Click="OnQueueClick" Content="Queue transfer" />
      </Grid>
    </Border>
  </Grid>
</Window>
