<Window
    x:Class="GhostShell.App.Views.DefinitionImportModeDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Import definitions"
    Width="560"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize19}" FontWeight="SemiBold" Text="Import definitions" />
      <TextBlock
          Classes="Muted"
          Text="Choose how identities already stored in this profile should be handled. The selected file is validated before anything changes."
          TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <Border Classes="SettingsCard">
        <RadioButton
            x:Name="FailOnConflictOption"
            Margin="14,12"
            GroupName="ImportMode"
            IsChecked="True">
          <StackPanel Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="Stop on conflicts" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Safest. Existing definitions are never replaced." />
          </StackPanel>
        </RadioButton>
      </Border>
      <Border Classes="SettingsCard">
        <RadioButton
            x:Name="ReplaceExistingOption"
            Margin="14,12"
            GroupName="ImportMode">
          <StackPanel Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="Replace matching definitions" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="Matching stable identities are replaced after preflight and explicit confirmation." TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
      <Button MinWidth="138" Classes="PrimaryButton" Click="OnChooseFileClick" Content="Choose file…" />
    </StackPanel>
  </Grid>
</Window>
