<Window
    x:Class="GhostShell.App.Views.RecoveryDataClearDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Clear crash recovery data"
    Width="480"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock Classes="Muted" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Row="1">
      <TextBlock
          Margin="{controls:Inset Md}"
          Classes="Muted"
          Text="Saved connections, screens, workspaces, secrets, session history, active sessions, and the current run’s protected crash snapshot are unaffected."
          TextWrapping="Wrap" />
    </controls:SurfaceCard>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button
          MinWidth="88"
          Click="OnCancelClick"
          Content="Cancel"
          IsCancel="True"
          AutomationProperties.Name="Cancel clearing crash recovery data" />
      <Button
          MinWidth="112"
          Classes="DestructiveButton"
          Click="OnConfirmClick"
          Content="{Binding ConfirmLabel}"
          AutomationProperties.Name="Confirm clearing crash recovery data" />
    </StackPanel>
  </Grid>
</Window>
