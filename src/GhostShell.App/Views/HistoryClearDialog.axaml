<Window
    x:Class="GhostShell.App.Views.HistoryClearDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Clear recent sessions"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="Clear recent sessions?" />
      <TextBlock
          Classes="Muted"
          Text="Recent definition metadata will be removed from this profile."
          TextWrapping="Wrap" />
    </StackPanel>
    <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Row="1">
      <TextBlock
          Margin="{controls:Inset Md}"
          Classes="Muted"
          Text="This does not close active sessions or delete saved connections, screens, or workspaces. Terminal content and commands were never stored here."
          TextWrapping="Wrap" />
    </controls:SurfaceCard>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel clear history" />
      <Button MinWidth="100" Classes="DestructiveButton" Click="OnConfirmClick" Content="Clear" AutomationProperties.Name="Confirm clear history" />
    </StackPanel>
  </Grid>
</Window>
