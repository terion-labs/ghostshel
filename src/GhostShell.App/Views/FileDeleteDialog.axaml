<Window
    x:Class="GhostShell.App.Views.FileDeleteDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete file item"
    Width="500"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock Classes="Muted" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="NoticeCard">
      <TextBlock Margin="13" Classes="Muted" Text="{Binding EffectText}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
      <Button MinWidth="128" Classes="DestructiveButton" Click="OnDeleteClick" Content="Delete permanently" />
    </StackPanel>
  </Grid>
</Window>
