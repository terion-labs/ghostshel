<Window
    x:Class="GhostShell.App.Views.FileDeleteDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Delete file item"
    Width="500"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock Classes="Muted" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Row="1">
      <TextBlock Margin="{controls:Inset Md}" Classes="Muted" Text="{Binding EffectText}" TextWrapping="Wrap" />
    </controls:SurfaceCard>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
      <Button MinWidth="128" Classes="DestructiveButton" Click="OnDeleteClick" Content="Delete permanently" />
    </StackPanel>
  </Grid>
</Window>
