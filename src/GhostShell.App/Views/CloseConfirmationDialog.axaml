<Window
    x:Class="GhostShell.App.Views.CloseConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Confirm close"
    Width="480"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="{controls:Inset Xl}" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock
          Classes="Muted"
          Text="{Binding Detail}"
          TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Padding="{controls:Inset Md}" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}">
      <TextBlock
          
          FontSize="{DynamicResource ShellFontSize10}"
          Foreground="{DynamicResource ShellWarningBrush}"
          Text="{Binding SessionSummary}"
          TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
      <Button
          MinWidth="88"
          Click="OnCancelClick"
          Content="Cancel"
          IsCancel="True"
          AutomationProperties.Name="Cancel close" />
      <Button
          MinWidth="126"
          Background="{DynamicResource ShellDangerBorderBrush}"
          Click="OnConfirmClick"
          Content="Close anyway"
          AutomationProperties.Name="Confirm force close" />
    </StackPanel>
  </Grid>
</Window>
