<Window
    x:Class="GhostShell.App.Views.OperationErrorDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="GhostSHELL error"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto" Margin="{controls:Inset Xl}" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="Unable to close" />
      <TextBlock Classes="Muted" Text="{Binding Message}" TextWrapping="Wrap" />
    </StackPanel>
    <Button
        Grid.Row="1"
        HorizontalAlignment="Right"
        MinWidth="88"
        Click="OnCloseClick"
        Content="Close"
        IsDefault="True"
        AutomationProperties.Name="Close error dialog" />
  </Grid>
</Window>
