<Window
    x:Class="GhostShell.App.Views.LocalArtifactClearDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clear app-managed storage"
    Width="480"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="{Binding Heading}" />
      <TextBlock Classes="Muted" Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="NoticeCard">
      <TextBlock
          Margin="12"
          Classes="Muted"
          Text="Saved definitions, secrets, history, recovery snapshots, terminal content, OS-managed data, and active sessions are unaffected."
          TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button
          MinWidth="88"
          Click="OnCancelClick"
          Content="Cancel"
          IsCancel="True"
          AutomationProperties.Name="Cancel clearing app-managed storage" />
      <Button
          MinWidth="112"
          Classes="DestructiveButton"
          Click="OnConfirmClick"
          Content="Clear files"
          AutomationProperties.Name="{Binding ConfirmAutomationName}" />
    </StackPanel>
  </Grid>
</Window>
