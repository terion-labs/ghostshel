<Window
    x:Class="GhostShell.App.Views.DefinitionImportPreflightDialog"
    x:DataType="views:DefinitionImportPreflightDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GhostShell.App.Views"
    xmlns:controls="using:GhostShell.App.Controls"
    Title="Review definition import"
    Width="680"
    MaxHeight="720"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="{controls:Inset Xl}" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="Review definition import" />
      <TextBlock Classes="Muted" Text="Preflight is complete. Nothing has been imported yet." />
    </StackPanel>

    <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" Grid.Row="1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceXs}">
        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Classes="Keycap"><TextBlock Text="{Binding ModeLabel}" /></Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Directory}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Summary}" />
      </Grid>
    </controls:SurfaceCard>

    <Grid Grid.Row="2" MaxHeight="330">
      <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" IsVisible="{Binding HasNoIssues}">
        <TextBlock Text="No conflicts or compatibility issues were found." />
      </controls:SurfaceCard>
      <ScrollViewer IsVisible="{Binding HasIssues}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:SurfaceCard Padding="{DynamicResource ShellCardPaddingCompact}" Margin="{controls:Inset Bottom=Sm}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <Border Classes="Keycap"><TextBlock Text="{Binding Label}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Message}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </controls:SurfaceCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
      <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding CommitHint}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
        <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
        <Button MinWidth="112" Classes="PrimaryButton" Click="OnImportClick" Content="Import definitions" IsEnabled="{Binding CanApply}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
