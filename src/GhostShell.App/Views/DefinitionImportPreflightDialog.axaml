<Window
    x:Class="GhostShell.App.Views.DefinitionImportPreflightDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review definition import"
    Width="680"
    MaxHeight="720"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize19}" FontWeight="SemiBold" Text="Review definition import" />
      <TextBlock Classes="Muted" Text="Preflight is complete. Nothing has been imported yet." />
    </StackPanel>

    <Border Grid.Row="1" Classes="SettingsCard">
      <Grid Margin="14,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
        <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding ModeLabel}" /></Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Directory}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Summary}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" MaxHeight="330">
      <Border Classes="NoticeCard" IsVisible="{Binding HasNoIssues}">
        <TextBlock Margin="14" Text="No conflicts or compatibility issues were found." />
      </Border>
      <ScrollViewer IsVisible="{Binding HasIssues}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Classes="SettingsCard">
                <Grid Margin="14,11" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="Keycap"><TextBlock Classes="Monospace" Text="{Binding Label}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Message}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding CommitHint}" TextWrapping="Wrap" />
      <Button Grid.Column="1" MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" />
      <Button Grid.Column="2" MinWidth="150" Classes="PrimaryButton" Click="OnImportClick" Content="Import definitions" IsEnabled="{Binding CanApply}" />
    </Grid>
  </Grid>
</Window>
