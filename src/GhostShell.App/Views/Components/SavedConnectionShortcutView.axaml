<UserControl
    x:Class="GhostShell.App.Views.Components.SavedConnectionShortcutView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Center">
  <!--
    One saved target, one row. The row opens it the usual way; the chevron
    appears only where the target supports more than one adapter, and offers
    the rest. Listing a host once per adapter instead said the same thing four
    times and buried the ordinary case.
  -->
  <Grid ColumnDefinitions="*,Auto">
    <Button
        Classes="ListRow ChooserListRow"
        Click="OnPrimaryClick"
        HorizontalContentAlignment="Stretch"
        IsEnabled="{Binding CanOpen}"
        ToolTip.Tip="{Binding DefaultLaunch.Label}"
        AutomationProperties.Name="{Binding Name}">
      <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Border VerticalAlignment="Center" Classes="StatusDot" Classes.available="{Binding CanOpen}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <controls:StatusChip Shape="Rounded" Tone="Default" IsOutlined="False" Grid.Column="2" Content="{Binding Kind}" />
      </Grid>
    </Button>
    <Button
        x:Name="ShortcutMenuButton"
        Grid.Column="1"
        Classes="IconButton"
        IsEnabled="{Binding CanOpen}"
        IsVisible="{Binding HasAlternatives}"
        ToolTip.Tip="Open with"
        AutomationProperties.Name="{Binding Name, StringFormat={}More ways to open {0}}">
      <icons:SymbolIcon Symbol="ChevronDown" FontSize="12" />
      <Button.Flyout>
        <Flyout Placement="Bottom" FlyoutPresenterClasses="SavedConnectionMenu">
          <ItemsControl ItemsSource="{Binding AlternativeLaunches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                    Classes="FlyoutMenuItem"
                    Click="OnAlternativeClick"
                    AutomationProperties.Name="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                    <icons:SymbolIcon VerticalAlignment="Center" Symbol="{Binding Icon}" FontSize="14" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
