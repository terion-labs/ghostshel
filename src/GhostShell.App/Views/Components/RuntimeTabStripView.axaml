<UserControl
    x:Class="GhostShell.App.Views.Components.RuntimeTabStripView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="False"
    Margin="{DynamicResource ShellTabStripTopClearance}"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <ScrollViewer
      x:Name="TabScrollViewer"
      HorizontalScrollBarVisibility="{Binding HorizontalScrollBars, ElementName=Root}"
      VerticalScrollBarVisibility="{Binding VerticalScrollBars, ElementName=Root}"
      AutomationProperties.Name="Open runtime tabs">
    <StackPanel Orientation="{Binding Orientation, ElementName=Root}" Spacing="{DynamicResource ShellSpaceXs}">
      <ItemsControl ItemsSource="{Binding Tabs, ElementName=Root}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="{Binding Orientation, ElementName=Root}" Spacing="{DynamicResource ShellSpaceXs}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <!-- Compact, because the active tab is now a filled accent block: at
               the old height it was the heaviest thing in the chrome and read
               as a banner rather than as one tab among several. -->
          <Grid
              Width="158"
              Height="22"
              Classes="RuntimeTabDropTarget"
              Classes.active="{Binding IsActive}"
              ColumnDefinitions="18,*,20"
              DragDrop.AllowDrop="True"
              DragDrop.DragEnter="OnDragEnter"
              DragDrop.DragLeave="OnDragLeave"
              DragDrop.DragOver="OnDragOver"
              DragDrop.Drop="OnDrop">
            <!-- Stretched, or the chip shrinks to its label and the close button
                 that belongs to this tab renders outside it. Avalonia buttons do
                 not stretch by default. -->
            <!-- The active tab wears the accent, and the accent is the open
                 workspace's own, so the tab strip says which workspace you are
                 in without repeating its name. Colour comes from the theme
                 rather than from the view model: a tab that carried its own hex
                 answered no appearance setting. -->
            <Button
                Grid.ColumnSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="{controls:Inset Horizontal=Lg}"
                Classes="RuntimeTabActivator"
                Classes.active="{Binding IsActive}"
                Click="OnActivate"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{Binding Title, StringFormat={}Activate tab {0}}"
                AutomationProperties.HelpText="Use the reorder handle to drag this tab, or use Move tab left and Move tab right from the command palette.">
              <!-- A grid, not a stack: a stacked label takes whatever width it
                   wants, so a long tab name ran under its own attention dot and
                   out through the close button instead of trimming. The label is
                   the only part that gives. -->
              <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
                <icons:SymbolIcon VerticalAlignment="Center" Symbol="WindowConsole" FontSize="11" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <controls:SignalDot Grid.Column="2" IsVisible="{Binding HasAttention}" />
              </Grid>
            </Button>
            <Border
                Grid.ColumnSpan="3"
                Width="3"
                Margin="{controls:Inset Vertical=Xs}"
                HorizontalAlignment="Left"
                Background="{DynamicResource ShellAccentBrush}"
                Classes="RuntimeTabDropIndicator Before"
                IsHitTestVisible="False"
                IsVisible="False" />
            <Border
                Grid.ColumnSpan="3"
                Width="3"
                Margin="{controls:Inset Vertical=Xs}"
                HorizontalAlignment="Right"
                Background="{DynamicResource ShellAccentBrush}"
                Classes="RuntimeTabDropIndicator After"
                IsHitTestVisible="False"
                IsVisible="False" />
            <Border
                Grid.Column="0"
                Background="Transparent"
                PointerCaptureLost="OnDragPointerCaptureLost"
                PointerMoved="OnDragPointerMoved"
                PointerPressed="OnDragPointerPressed"
                PointerReleased="OnDragPointerReleased"
                ToolTip.Tip="Drag to reorder tab"
                AutomationProperties.Name="{Binding Title, StringFormat={}Reorder tab {0}}"
                AutomationProperties.HelpText="Drag to change this tab's position without activating it.">
              <icons:SymbolIcon
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Symbol="ReOrderDotsVertical"
                  FontSize="10" />
            </Border>
            <Button
                Grid.Column="2"
                Width="18"
                Height="18"
                Classes="IconButton"
                Click="OnClose"
                IsVisible="{Binding CanClose}"
                ToolTip.Tip="Close tab"
                AutomationProperties.Name="{Binding Title, StringFormat={}Close tab {0}}"
                AutomationProperties.HelpText="Close this runtime tab using the normal session close policy.">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="9" />
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button
          x:Name="AddTabButton"
          Width="22"
          Height="22"
          Padding="0"
          Classes="IconButton"
          Click="OnAddTab"
          ToolTip.Tip="New tab"
          AutomationProperties.Name="Open a new tab">
        <icons:SymbolIcon Symbol="Add" FontSize="12" />
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
