<UserControl
    x:Class="GhostShell.App.Views.Components.AgentQuestionCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <Border
      x:Name="AgentPendingQuestion"
      Padding="12,11"
      Classes="NoticeCard"
      Focusable="True"
      KeyboardNavigation.IsTabStop="True"
      IsVisible="{Binding AgentChat.HasPendingQuestion}"
      AutomationProperties.LiveSetting="Assertive"
      AutomationProperties.Name="{Binding AgentChat.PendingQuestion.AccessibleName}"
      AutomationProperties.HelpText="{Binding AgentChat.PendingQuestion.ResponseWarning}">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Classes="Eyebrow" Text="INPUT NEEDED" />
          <TextBlock
              FontSize="{DynamicResource ShellFontSize13}"
              FontWeight="SemiBold"
              Text="Untrusted model question"
              TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Top" Classes="StatusPill" Classes.Warning="True">
          <TextBlock Text="NOT APPROVAL" />
        </Border>
      </Grid>
      <TextBlock Text="{Binding AgentChat.PendingQuestion.Question}" TextWrapping="Wrap" />
      <TextBlock
          Classes="Muted"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding AgentChat.PendingQuestion.ExpiresAt, StringFormat={}Expires · {0}}"
          TextWrapping="Wrap" />
      <Border
          Padding="8"
          Background="{DynamicResource ShellWarningSoftBrush}"
          BorderBrush="{DynamicResource ShellWarningBorderBrush}"
          BorderThickness="1"
          CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
          <icons:SymbolIcon Symbol="Warning" FontSize="14" Foreground="{DynamicResource ShellWarningBrush}" />
          <TextBlock
              Grid.Column="1"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize9}"
              Text="{Binding AgentChat.PendingQuestion.ResponseWarning}"
              TextWrapping="Wrap" />
        </Grid>
      </Border>
      <StackPanel Spacing="4">
        <TextBlock Classes="Eyebrow" Text="YOUR ANSWER" />
        <TextBox
            x:Name="AgentQuestionResponseInput"
            MinHeight="36"
            Padding="8"
            AcceptsReturn="False"
            MaxLength="2048"
            Text="{Binding AgentChat.QuestionResponseDraft, Mode=TwoWay}"
            TextWrapping="NoWrap"
            IsEnabled="{Binding AgentChat.CanRespondToQuestion}"
            KeyDown="OnAgentQuestionResponseKeyDown"
            TabIndex="0"
            AutomationProperties.Name="Answer the AI agent question"
            AutomationProperties.HelpText="Single-line non-sensitive clarification only. This is not approval. Do not enter credentials." />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Button
            Classes="SecondaryButton"
            Click="OnDeclineAgentQuestionClick"
            Content="Skip / decline"
            IsEnabled="{Binding AgentChat.CanDeclineQuestion}"
            TabIndex="1"
            AutomationProperties.Name="Skip or decline the AI agent question"
            AutomationProperties.HelpText="Continues without an answer and grants no authority" />
        <Button
            Grid.Column="1"
            Classes="PrimaryButton"
            Click="OnSubmitAgentQuestionClick"
            Content="Send answer"
            IsEnabled="{Binding AgentChat.CanSubmitQuestionResponse}"
            TabIndex="2"
            AutomationProperties.Name="Send non-sensitive answer to the AI agent"
            AutomationProperties.HelpText="Sends clarification only; it does not approve an action" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
