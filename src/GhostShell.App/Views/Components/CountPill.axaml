<UserControl
    x:Class="GhostShell.App.Views.Components.CountPill"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False"
    IsHitTestVisible="False">
  <Border
      Padding="7,2"
      Background="{DynamicResource ShellSurfaceHoverBrush}"
      CornerRadius="999">
    <TextBlock
        FontSize="{DynamicResource ShellFontSize11}"
        Foreground="{DynamicResource ShellMutedBrush}"
        Text="{Binding Value, ElementName=Root}" />
  </Border>
</UserControl>
