<UserControl
    x:Class="GhostShell.App.Views.Components.WindowControlsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    Focusable="False"
    VerticalAlignment="Center"
    WindowDecorationProperties.ElementRole="User">
  <UserControl.Resources>
    <!-- The platform's own colours, deliberately not the theme's. These read as
         window controls because everyone already knows them; an accent-tinted
         set would read as three buttons that happen to be round. -->
    <SolidColorBrush x:Key="WindowControlCloseBrush" Color="#FF5F57" />
    <SolidColorBrush x:Key="WindowControlMinimiseBrush" Color="#FEBC2E" />
    <SolidColorBrush x:Key="WindowControlZoomBrush" Color="#28C840" />
  </UserControl.Resources>

  <StackPanel
      Orientation="Horizontal"
      VerticalAlignment="Center"
      Spacing="{DynamicResource ShellSpaceSm}">
    <Button
        x:Name="CloseButton"
        Classes="WindowControl"
        Background="{StaticResource WindowControlCloseBrush}"
        Click="OnCloseClick"
        ToolTip.Tip="Close"
        AutomationProperties.Name="Close window" />
    <Button
        x:Name="MinimiseButton"
        Classes="WindowControl"
        Background="{StaticResource WindowControlMinimiseBrush}"
        Click="OnMinimiseClick"
        ToolTip.Tip="Minimise"
        AutomationProperties.Name="Minimise window" />
    <Button
        x:Name="ZoomButton"
        Classes="WindowControl"
        Background="{StaticResource WindowControlZoomBrush}"
        Click="OnZoomClick"
        ToolTip.Tip="Zoom"
        AutomationProperties.Name="Zoom window" />
  </StackPanel>
</UserControl>
