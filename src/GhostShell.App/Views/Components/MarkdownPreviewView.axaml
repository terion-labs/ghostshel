<UserControl
    x:Class="GhostShell.App.Views.Components.MarkdownPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Styles>
    <!-- Every text block is selectable, so a preview can be read out of as
         well as looked at: select, copy, paste elsewhere. -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource ShellAccentSoftBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel
        x:Name="Blocks"
        Margin="{controls:Inset Lg}"
        MaxWidth="820"
        HorizontalAlignment="Left"
        Spacing="{DynamicResource ShellSpaceSm}" />
  </ScrollViewer>
</UserControl>
