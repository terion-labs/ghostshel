<UserControl
    x:Class="GhostShell.App.Views.Components.LauncherView"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
  <UserControl.Styles>
    <!--
      These rows sit directly against a clipped card edge. A leading divider on
      the first generated item creates a second line beneath the card's own top
      border, so this compact catalog lets the card provide the surrounding
      chrome.
    -->
    <Style Selector="Button.ListRow.LauncherListRow">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource ShellSpaceLg}">
    <Grid ColumnDefinitions="*,Auto">
      <Button
          Classes="SearchButton"
          HorizontalContentAlignment="Stretch"
          Click="OnShowCommandPaletteClick"
          AutomationProperties.Name="Search commands, connections, screens, workspaces, and session history">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon Symbol="Search" FontSize="16" />
          <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize13}"
              Text="Search connections, screens, workspaces, sessions, or commands…"
              TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Classes="Keycap">
            <TextBlock Text="{Binding CommandPaletteShortcut}" />
          </Border>
        </Grid>
      </Button>
      <Button
          Grid.Column="1"
          Margin="{controls:Inset Left=Md}"
          Classes="IconButton Large"
          Click="OnCloseClick"
          IsVisible="{Binding ShowCloseAction, ElementName=Root}"
          ToolTip.Tip="Close launcher"
          AutomationProperties.Name="Close new tab or session launcher">
        <icons:SymbolIcon Symbol="Dismiss" FontSize="14" />
      </Button>
    </Grid>

    <!-- What is set up and what is not, until it is. It greets you here because
         this is the first thing open, rather than on a screen of its own that
         existed mostly to carry it. -->
    <controls:SurfaceCard
        Grid.Row="1"
        Padding="0"
        IsVisible="{Binding Onboarding.IsVisible, FallbackValue=False}"
        AutomationProperties.Name="Getting started">
      <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" Text="{Binding Onboarding.Title}" />
          <TextBlock Classes="Muted" Text="{Binding Onboarding.Introduction}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <controls:SurfaceCard Tone="Notice" Padding="0">
            <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="WindowConsole" FontSize="15" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Default terminal" />
              </Grid>
              <TextBlock Classes="Eyebrow" Text="{Binding Onboarding.LocalTerminalState}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Onboarding.LocalTerminalDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </controls:SurfaceCard>
          <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Column="1">
            <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="Shield" FontSize="15" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Secure password storage" />
              </Grid>
              <TextBlock Classes="Eyebrow" Text="{Binding Onboarding.CredentialVaultState}" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Onboarding.CredentialVaultDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </controls:SurfaceCard>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <TextBlock
              VerticalAlignment="Center"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize10}"
              Text="{Binding Onboarding.StatusMessage}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Getting started status" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
            <Button
                Classes="TextButton"
                Click="OnRetryOnboardingClick"
                IsVisible="{Binding Onboarding.CanRetry, FallbackValue=False}"
                Content="Retry" />
            <Button Classes="PrimaryButton" Click="OnFinishOnboardingClick" Content="Continue" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </controls:SurfaceCard>

    <StackPanel Grid.Row="2" Spacing="{DynamicResource ShellSpaceSm}">
      <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Start something new" />
      <controls:CardGridPanel MinItemWidth="150" Spacing="{DynamicResource ShellSpaceSm}">
        <Button x:Name="NewTerminalButton" Classes="ChooserButton LauncherTile" Click="OnNewLocalTerminalClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open a new local terminal">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="WindowConsole" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="New terminal" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Open the default local shell" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" AutomationProperties.Name="Open a new browser" Click="OnNewBrowserClick" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanStartBrowserSession}">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Globe" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="New browser" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Embedded Chromium browser panel" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" Click="OnNewStatisticsClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open local host statistics">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="PulseSquare" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="Statistics" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Live system metrics" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" Click="OnNewFileViewerClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open a new File Viewer">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Folder" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="File Viewer" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Browse configured providers" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" Click="OnNewProcessMonitorClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open local process monitor">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Gauge" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="Process monitor" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Watch running processes" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" Click="OnNewDatabaseClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open a new database viewer">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Database" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="Database" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Query SQLite, Postgres, MySQL" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="ChooserButton LauncherTile" Click="OnNewDockerClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open a Docker panel">
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="38" Height="38" HorizontalAlignment="Left" Classes="ChooserIconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Box" FontSize="19" /></Border>
            <TextBlock Foreground="{DynamicResource ShellTextBrush}" FontWeight="SemiBold" Text="Docker" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="Muted" Foreground="{DynamicResource ShellMutedBrush}" FontSize="{DynamicResource ShellFontSize11}" Text="Manage local or remote engines" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
      </controls:CardGridPanel>
    </StackPanel>

    <Grid
        Grid.Row="3"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource ShellSpaceMd}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Workspaces" />
        <components:CountPill Value="{Binding Workspaces.Count}" />
      </StackPanel>
      <ScrollViewer
          Grid.Column="1"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled"
          IsVisible="{Binding HasWorkspaces}"
          AutomationProperties.Name="Saved workspaces">
        <ItemsControl ItemsSource="{Binding Workspaces}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- The same tile the rail draws. The launcher is where you pick a
                   workspace, not where you end one, so it offers no close. -->
              <controls:WorkspaceRailTile
                  Accent="{Binding Accent}"
                  Icon="{Binding IconSymbol}"
                  IsRunning="{Binding IsOpen}"
                  IsCurrent="{Binding IsInFront}"
                  HasAttention="{Binding HasAttention}"
                  OpenRequested="OnOpenWorkspaceClick"
                  ToolTip.Tip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" IsVisible="{Binding HasNoWorkspaces}" Text="No saved workspaces yet." />
    </Grid>

    <Grid Grid.Row="4" VerticalAlignment="Top" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceLg}">
      <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Saved connections" />
            <components:CountPill Value="{Binding SavedConnectionShortcutCount}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0" Classes="TextButton" Click="OnAddConnectionClick" Content="Add" />
        </Grid>
        <controls:SurfaceCard Tone="Sunken" Padding="0" Grid.Row="1" VerticalAlignment="Top" MaxHeight="420">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SavedConnectionShortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <components:SavedConnectionShortcutView
                      LaunchRequested="OnConnectionLaunchRequested"
                      EditRequested="OnEditConnectionRequested"
                      DeleteRequested="OnDeleteConnectionRequested" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </controls:SurfaceCard>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="Saved screens" />
            <components:CountPill Value="{Binding Screens.Count}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" MinHeight="0" Padding="0" Classes="TextButton" Click="OnShowLayoutDesignerClick" Content="Layouts" />
        </Grid>
        <controls:SurfaceCard Tone="Sunken" Padding="0" Grid.Row="1" VerticalAlignment="Top" MaxHeight="420">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Screens}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button
                      Classes="ListRow LauncherListRow"
                      Click="OnOpenScreenClick"
                      AutomationProperties.Name="{Binding Name, StringFormat=Open saved screen {0} in a tab}">
                    <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Border
                          Width="44"
                          Height="30"
                          VerticalAlignment="Center"
                          Background="{DynamicResource ShellBackgroundBrush}"
                          BorderBrush="{DynamicResource ShellBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource ShellInnerCornerRadius}"
                          ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding PreviewPanels}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ScreenLayoutPreviewPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><Border Margin="1" Classes="ScreenPreviewPanel" Classes.primary="{Binding IsPrimary}" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </controls:SurfaceCard>
      </Grid>
    </Grid>

    <!-- What has been open before, beside what can be opened now. One answer to
         "what do I open", rather than a shortcut list here and a browser for it
         somewhere else. Retaining any of this is opt-in, so with it turned off
         there is nothing to show and the section says nothing. -->
    <Grid Grid.Row="5" RowDefinitions="Auto,*" RowSpacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding HasHistorySessions}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceSm}">
          <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize14}" FontWeight="SemiBold" Text="History" />
          <components:CountPill Value="{Binding HistoryResultCount}" />
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="14" />
          <TextBox
              x:Name="HistorySearchBox"
              Grid.Column="1"
              PlaceholderText="Search title, source, kind, outcome, or session ID…"
              AutomationProperties.Name="Search session history"
              KeyDown="OnHistorySearchKeyDown"
              Text="{Binding HistorySearchQuery}" />
        </Grid>
      </Grid>
      <controls:SurfaceCard Tone="Sunken" Padding="0" Grid.Row="1" VerticalAlignment="Top" MaxHeight="260">
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- Realized as it scrolls. History is bounded by the retention
                 policy rather than by anything on screen, so the list has to
                 cope with the largest a user may have chosen to keep. -->
            <ItemsControl ItemsSource="{Binding FilteredHistorySessions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button
                      Classes="ListRow LauncherListRow"
                      Click="OnOpenRecentSessionClick"
                      IsEnabled="{Binding CanOpen}"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding Title, StringFormat=Reopen session {0}}">
                    <Grid Margin="{controls:Inset Horizontal=Md, Vertical=Sm}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <Border VerticalAlignment="Center" Classes="StatusDot" Classes.available="{Binding CanOpen}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource ShellFontSize12}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <controls:StatusChip Shape="Rounded" Tone="Default" IsOutlined="False" Grid.Column="2" Content="{Binding PanelKindName}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel
              Margin="{controls:Inset Lg}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="{DynamicResource ShellSpaceXs}"
              IsVisible="{Binding HasNoFilteredHistorySessions}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Session history has no results">
            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No history results" />
            <TextBlock MaxWidth="430" HorizontalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HistorySearchEmptyState}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Panel>
      </controls:SurfaceCard>
    </Grid>
  </Grid>
</UserControl>
