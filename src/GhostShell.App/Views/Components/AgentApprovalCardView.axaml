<UserControl
    x:Class="GhostShell.App.Views.Components.AgentApprovalCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Focusable="False"
    HorizontalContentAlignment="Stretch">
  <controls:SurfaceCard Tone="Notice"
      Padding="{controls:Inset Md}"
      Focusable="True"
      KeyboardNavigation.TabNavigation="Local"
      AutomationProperties.LiveSetting="Assertive"
      AutomationProperties.Name="AI agent action approval request"
      AutomationProperties.HelpText="Review the exact tool, target, host, working directory, material arguments, and input-yield warning before choosing. Approval applies once to this exact action.">
    <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceXs}">
        <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
          <TextBlock Classes="Eyebrow" Text="APPROVAL REQUIRED" />
          <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding AgentChat.PendingApproval.ToolTitle}" TextWrapping="Wrap" />
        </StackPanel>
        <controls:StatusChip Grid.Column="1" VerticalAlignment="Top" Classes.Warning="True" Content="{Binding AgentChat.PendingApproval.Permission, StringFormat={}{0} · ONCE}" />
        <controls:StatusChip Grid.Column="2" VerticalAlignment="Top" Classes.Warning="True" Content="{Binding AgentChat.PendingApproval.Risk}" />
      </Grid>
      <TextBlock
          Classes="Muted Monospace"
          FontSize="{DynamicResource ShellFontSize9}"
          Text="{Binding AgentChat.PendingApproval.ToolName, StringFormat={}Tool · {0}}"
          TextWrapping="Wrap" />
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
        <TextBlock Classes="Eyebrow" Text="EXACT TARGET" />
        <TextBlock Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.ExactTarget}" TextWrapping="Wrap" />
        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.TargetTitle}" TextWrapping="Wrap" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" RowSpacing="{DynamicResource ShellSpaceXs}">
        <TextBlock Classes="Eyebrow" Text="HOST" />
        <TextBlock Grid.Column="1" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.Host}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Classes="Eyebrow" Text="WORKDIR" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Muted Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.WorkingDirectory}" TextWrapping="Wrap" />
      </Grid>
      <StackPanel Spacing="{DynamicResource ShellSpaceXs}" IsVisible="{Binding AgentChat.PendingApproval.HasArguments}">
        <TextBlock Classes="Eyebrow" Text="MATERIAL ARGUMENTS" />
        <ItemsControl ItemsSource="{Binding AgentChat.PendingApproval.Arguments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="{controls:Inset Bottom=Xs}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Name, StringFormat={}{0}:}" />
                <TextBlock Grid.Column="1" Classes="Monospace" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding DisplayValue}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.ExpiresAt, StringFormat={}Expires · {0}}" TextWrapping="Wrap" />
      <Border
          Padding="{controls:Inset Sm}"
          Background="{DynamicResource ShellWarningSoftBrush}"
          BorderBrush="{DynamicResource ShellWarningBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource ShellControlCornerRadius}"
          IsVisible="{Binding AgentChat.PendingApproval.TemporarilyYieldsTerminalInput}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
          <icons:SymbolIcon Symbol="Warning" FontSize="14" Foreground="{DynamicResource ShellWarningBrush}" />
          <TextBlock Grid.Column="1" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding AgentChat.PendingApproval.InputYieldWarning}" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <Button
            Classes="SecondaryButton"
            Click="OnDenyClick"
            Content="Deny"
            IsEnabled="{Binding AgentChat.CanDecideApproval}"
            KeyboardNavigation.TabIndex="0"
            AutomationProperties.Name="Deny AI agent action" />
        <Button
            Grid.Column="1"
            Classes="PrimaryButton"
            Click="OnApproveClick"
            Content="Approve once"
            IsEnabled="{Binding AgentChat.CanDecideApproval}"
            KeyboardNavigation.TabIndex="1"
            AutomationProperties.Name="Approve AI agent action once" />
      </Grid>
    </StackPanel>
  </controls:SurfaceCard>
</UserControl>
