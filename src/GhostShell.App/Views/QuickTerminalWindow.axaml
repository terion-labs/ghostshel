<Window
    x:Class="GhostShell.App.Views.QuickTerminalWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:icons="using:FluentIcons.Avalonia"
    Title="GhostSHELL Quick Terminal"
    Width="1200"
    Height="520"
    MinWidth="640"
    MinHeight="320"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Background="Transparent"
    Topmost="True"
    WindowStartupLocation="Manual">
  <Grid
      x:Name="RevealViewport"
      Background="Transparent"
      ClipToBounds="True">
    <Border
        x:Name="SlidingPanel"
        Background="Transparent"
        BorderBrush="{DynamicResource ShellAccentBrush}"
        BorderThickness="0,0,0,1"
        ClipToBounds="True"
        CornerRadius="{DynamicResource ShellPanelBottomCornerRadius}">
      <Grid RowDefinitions="*,36">
        <Grid>
          <controls:TerminalPresentationHost
              x:Name="QuickTerminalHost"
              ClientId="{Binding ClientId}"
              IsVisible="{Binding IsTerminalAvailable}"
              SessionClient="{Binding SessionClient}"
              SessionRequest="{Binding TerminalRequest}" />

          <Grid
              IsVisible="{Binding ShowTerminalPlaceholder}">
            <Border
                x:Name="QuickTerminalPlaceholderBackground"
                Background="{DynamicResource ShellBackgroundBrush}"
                IsHitTestVisible="False" />
            <controls:StateOverlay
                Glyph="Warning"
                Heading="{Binding TerminalPlaceholderTitle}"
                Body="{Binding TerminalUnavailableMessage}" />
          </Grid>
        </Grid>

        <Grid Grid.Row="1">
          <Border
              x:Name="QuickTerminalStatusBackground"
              Background="{DynamicResource ShellSurfaceBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="0,1,0,0"
              IsHitTestVisible="False" />
          <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
            <icons:SymbolIcon
                VerticalAlignment="Center"
                Symbol="WindowConsole"
                FontSize="14"
                Foreground="{DynamicResource ShellAccentBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource ShellFontSize10}"
                FontWeight="SemiBold"
                Text="Quick terminal" />
            <TextBlock VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ConnectionName}" />
          </StackPanel>

          <TextBlock
              Grid.Column="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="Muted"
              FontSize="{DynamicResource ShellFontSize9}"
              Text="{Binding ProfileName, StringFormat={}Profile · {0}}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}" VerticalAlignment="Center">
            <Border Classes="StatusDot" Background="{Binding ShortcutStatusBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding ShortcutStatus}"
                ToolTip.Tip="{Binding ShortcutDetail}" />
            <TextBlock
                VerticalAlignment="Center"
                Classes="Muted"
                FontSize="{DynamicResource ShellFontSize9}"
                Text="{Binding EscapeStatus}"
                ToolTip.Tip="{Binding EscapeDetail}" />
            <Button
                Classes="IconButton"
                Click="OnSettingsClick"
                ToolTip.Tip="Quick Terminal settings"
                AutomationProperties.Name="Open Quick Terminal settings">
              <icons:SymbolIcon Symbol="Settings" FontSize="12" />
            </Button>
            <Button
                Classes="IconButton"
                Click="OnHideClick"
                ToolTip.Tip="Hide Quick Terminal"
                AutomationProperties.Name="Hide Quick Terminal">
              <icons:SymbolIcon Symbol="Dismiss" FontSize="12" />
            </Button>
          </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
