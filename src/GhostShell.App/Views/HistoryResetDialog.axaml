<Window
    x:Class="GhostShell.App.Views.HistoryResetDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reset session history"
    Width="480"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="{DynamicResource ShellFontSize17}" FontWeight="SemiBold" Text="Reset unreadable history?" />
      <TextBlock
          Classes="Muted"
          Text="GhostSHELL could not safely read the retained session metadata. Resetting removes every history row, including malformed rows, so the local store can start clean."
          TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Classes="NoticeCard">
      <TextBlock
          Margin="12"
          Classes="Muted"
          Text="This recovery action does not close active sessions or delete saved connections, screens, or workspaces. It cannot be limited to the rows shown because unreadable rows are hidden."
          TextWrapping="Wrap" />
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
      <Button MinWidth="88" Click="OnCancelClick" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel history reset" />
      <Button MinWidth="112" Classes="DestructiveButton" Click="OnConfirmClick" Content="Reset history" AutomationProperties.Name="Confirm reset unreadable history" />
    </StackPanel>
  </Grid>
</Window>
