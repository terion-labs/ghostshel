<UserControl
    x:Class="GhostShell.App.Views.LauncherView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GhostShell.App.Controls"
    xmlns:components="using:GhostShell.App.Views.Components"
    xmlns:icons="using:FluentIcons.Avalonia"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<UserControl.Resources>
    <!-- One card definition per kind, shared by the Home summary and the
         dedicated page, so the two can never drift apart. -->
    <DataTemplate x:Key="ConnectionCardTemplate">
      <controls:SurfaceCard Classes="LaunchCard" Tone="Sunken" Padding="0">
        <Grid>
          <Button
              Classes="CardSurface"
              Click="OnOpenConnectionClick"
              IsEnabled="{Binding CanOpen}"
              ToolTip.Tip="{Binding Status}"
              AutomationProperties.Name="{Binding Name, StringFormat=Open saved connection {0} in a tab}">
            <StackPanel Spacing="{DynamicResource ShellSpaceSm}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <Border Classes="StatusDot" Classes.available="{Binding CanOpen}" />
                  <TextBlock
                      FontSize="{DynamicResource ShellFontSize13}"
                      FontWeight="SemiBold"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                  <controls:StatusChip Shape="Rounded" Tone="Default" IsOutlined="False" Content="{Binding Kind}" />
                </StackPanel>
              </Grid>
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize11}"
                  Text="{Binding Detail}"
                  TextTrimming="CharacterEllipsis" />
              <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" ClipToBounds="True">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <controls:StatusChip Tone="Default" Content="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                  Classes="Muted"
                  FontSize="{DynamicResource ShellFontSize10}"
                  Text="{Binding Status}"
                  IsVisible="{Binding !HasTags}" />
            </StackPanel>
          </Button>
          <StackPanel
              Margin="{controls:Inset Sm}"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Classes="CardActions"
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceXs}">
            <Button Classes="IconButton" Click="OnEditConnectionClick" ToolTip.Tip="Edit connection" AutomationProperties.Name="{Binding Name, StringFormat=Edit connection {0}}"><icons:SymbolIcon Symbol="Edit" FontSize="12" /></Button>
            <Button Classes="IconButton" Click="OnDeleteConnectionClick" ToolTip.Tip="Delete connection" AutomationProperties.Name="{Binding Name, StringFormat=Delete connection {0}}"><icons:SymbolIcon Symbol="Delete" FontSize="12" /></Button>
          </StackPanel>
        </Grid>
      </controls:SurfaceCard>
    </DataTemplate>

    <DataTemplate x:Key="ScreenCardTemplate">
      <controls:SurfaceCard Classes="LaunchCard" Tone="Sunken" Padding="0">
        <Grid>
          <Button
              Classes="CardSurface"
              Padding="{controls:Inset Md}"
              Click="OnOpenScreenClick"
              AutomationProperties.Name="{Binding Name, StringFormat=Open saved screen {0} in a tab}">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <Border Height="82" Background="{DynamicResource ShellBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ShellControlCornerRadius}" ClipToBounds="True">
                <ItemsControl Margin="{DynamicResource ShellPreviewTileInset}" ItemsSource="{Binding PreviewPanels}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ScreenLayoutPreviewPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                          Margin="{controls:Inset Xs}"
                          Classes="ScreenPreviewPanel"
                          Classes.primary="{Binding IsPrimary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize11}"
                    Text="{Binding Summary}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Layout}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <StackPanel
              Margin="32,26,32,48"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Classes="CardActions"
              Orientation="Horizontal"
              Spacing="{DynamicResource ShellSpaceXs}">
            <Button Classes="IconButton" Click="OnEditScreenClick" ToolTip.Tip="Edit saved screen" AutomationProperties.Name="{Binding Name, StringFormat=Edit saved screen {0}}"><icons:SymbolIcon Symbol="Edit" FontSize="12" /></Button>
          </StackPanel>
        </Grid>
      </controls:SurfaceCard>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <Border
        Classes="TopChrome"
        MinHeight="{Binding $parent[Window].TitleBarChromeHeight}"
        PointerPressed="OnTitleBarPointerPressed"
        WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Margin="{Binding $parent[Window].WindowTitleBarContentMargin}" ColumnSpacing="{DynamicResource ShellSpaceSm}">
        <components:RuntimeTabStripView
            x:Name="LauncherTabStrip"
            Tabs="{Binding RuntimeWorkspace.Tabs}"
            Orientation="Horizontal"
            ShowHomeTab="True"
            IsHomeActive="True"
            WindowDecorationProperties.ElementRole="User"
            AutomationProperties.Name="Open shell tabs"
            AddTabRequested="OnShowNewItemClick"
            HomeRequested="OnLauncherHomeClick"
            ActivateRequested="OnActivateTabClick"
            CloseRequested="OnCloseRuntimeTabClick" />
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="{DynamicResource ShellSpaceXs}"
            WindowDecorationProperties.ElementRole="User">
          <Button Classes="IconButton" Click="OnShowSettingsClick" ToolTip.Tip="Settings" AutomationProperties.Name="Open settings"><icons:SymbolIcon Symbol="Settings" FontSize="15" /></Button>
          <Button Classes="IconButton" Click="OnLockShellClick" ToolTip.Tip="Lock GhostSHELL" AutomationProperties.Name="Lock GhostSHELL" IsVisible="{Binding ApplicationSecurityEditor.IsProtectionEnabled}"><icons:SymbolIcon Symbol="LockClosed" FontSize="15" /></Button>
        </StackPanel>
      </Grid>
    </Border>
  
    <Grid Grid.Row="1" ColumnDefinitions="244,*">
      <Border
          Classes="FloatingSidebar"
          controls:Concentric.IsEnabled="True"
          Classes.routeSidebar="True">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="{controls:Inset Md}" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
            <Border Width="28" Height="28" Background="{DynamicResource ShellAccentBrush}" CornerRadius="{DynamicResource ShellControlCornerRadius}">
              <icons:SymbolIcon
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Symbol="Triangle"
                  FontSize="15"
                  Foreground="{DynamicResource ShellAccentForegroundBrush}" />
            </Border>
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontSize="{DynamicResource ShellFontSize14}" FontWeight="Bold" Text="GhostSHELL" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding ApplicationVersion}" />
            </StackPanel>
          </StackPanel>
  
          <StackPanel Grid.Row="1" Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
            <components:ShellNavigationItem
                x:Name="LauncherHomeButton"
                AutomationName="Launcher home"
                Click="OnLauncherHomeClick"
                Icon="Home"
                IconSize="16"
                IsActive="{Binding IsLauncherOverviewVisible}"
                Label="Home" />
            <components:ShellNavigationItem
                x:Name="LauncherConnectionsButton"
                AutomationName="Saved connections"
                Click="OnLauncherConnectionsClick"
                Icon="WindowConsole"
                IconSize="16"
                IsActive="{Binding IsLauncherConnectionsVisible}"
                Label="Saved Connections" />
            <components:ShellNavigationItem
                x:Name="LauncherScreensButton"
                AutomationName="Saved screens"
                Click="OnLauncherScreensClick"
                Icon="Grid"
                IconSize="16"
                IsActive="{Binding IsLauncherScreensVisible}"
                Label="Screens" />
            <components:ShellNavigationItem
                x:Name="LauncherHistoryButton"
                AutomationName="Session history"
                Click="OnLauncherHistoryClick"
                Icon="History"
                IconSize="16"
                IsActive="{Binding IsLauncherHistoryVisible}"
                Label="History" />
            <components:ShellNavigationItem
                AutomationName="Open settings"
                Click="OnShowSettingsClick"
                Icon="Settings"
                IconSize="16"
                Label="Settings" />
          </StackPanel>
        </Grid>
      </Border>
  
      <!-- The pages sit on the window's own surface, as the settings pages do.
           Wrapping them in a panel gave the shell two visual languages: cards
           on a panel here, cards on the window there, for the same kind of
           page. -->
      <Panel Grid.Column="1">
      <ScrollViewer x:Name="LauncherScrollViewer" IsVisible="{Binding IsLauncherOverviewVisible}">
        <StackPanel Margin="{controls:Inset Horizontal=Xxl, Top=Sm, Bottom=Xxl}" Spacing="{DynamicResource ShellSpaceXl}">
          <Grid
              x:Name="LauncherHomeSection"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{DynamicResource ShellSpaceLg}"
              Focusable="True"
              AutomationProperties.Name="Home overview">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontSize="{DynamicResource ShellFontSize22}" FontWeight="Bold" Text="Home" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="Launch a session or restore a saved workspace" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceMd}">
              <Button
                  Width="240"
                  Classes="SearchButton"
                  Click="OnShowCommandPaletteClick"
                  AutomationProperties.Name="Search commands, connections, screens, workspaces, and session history">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="14" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="Search everything…" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding CommandPaletteShortcut}" />
                </Grid>
              </Button>
              <Button
                  Classes="PrimaryButton"
                  Click="OnShowNewItemClick"
                  AutomationProperties.Name="{Binding NewItemLauncherTitle}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="Add" FontSize="16" />
                  <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize13}" Text="{Binding NewItemLauncherTitle}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
  
          <controls:SurfaceCard Padding="0"
              x:Name="LauncherOnboardingCard"
              IsVisible="{Binding Onboarding.IsVisible, FallbackValue=False}"
              AutomationProperties.Name="Getting started">
            <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
                <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontSize="{DynamicResource ShellFontSize18}" FontWeight="SemiBold" Text="{Binding Onboarding.Title}" />
                  <TextBlock Classes="Muted" Text="{Binding Onboarding.Introduction}" TextWrapping="Wrap" />
                </StackPanel>
                <controls:StatusChip Grid.Column="1" VerticalAlignment="Center" Content="Local profile" />
              </Grid>
  
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <controls:SurfaceCard Tone="Notice" Padding="0">
                  <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon Symbol="WindowConsole" FontSize="15" />
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Local shell" />
                    </Grid>
                    <TextBlock Classes="Eyebrow" Text="{Binding Onboarding.LocalTerminalState}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Onboarding.LocalTerminalDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
                <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Column="1">
                  <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon Symbol="Shield" FontSize="15" />
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Credential vault" />
                    </Grid>
                    <TextBlock Classes="Eyebrow" Text="{Binding Onboarding.CredentialVaultState}" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding Onboarding.CredentialVaultDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
                <controls:SurfaceCard Tone="Notice" Padding="0" Grid.Column="2">
                  <StackPanel Margin="{controls:Inset Md}" Spacing="{DynamicResource ShellSpaceXs}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                      <icons:SymbolIcon Symbol="History" FontSize="15" />
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Session history" />
                    </Grid>
                    <TextBlock Classes="Eyebrow" Text="Local metadata" />
                    <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding HistoryRetentionStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </controls:SurfaceCard>
              </Grid>
  
              <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ShellSpaceSm}">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="Muted"
                    FontSize="{DynamicResource ShellFontSize10}"
                    Text="{Binding Onboarding.StatusMessage}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="Getting started status" />
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button Margin="{controls:Inset Right=Sm, Bottom=Sm}" Classes="SecondaryButton" Click="OnImportDefinitionsClick" Content="Import setup…" IsEnabled="{Binding Onboarding.CanInteract}" AutomationProperties.Name="Import an existing GhostSHELL setup" />
                  <Button Margin="{controls:Inset Right=Sm, Bottom=Sm}" Classes="SecondaryButton" Click="OnReviewHistoryPrivacyClick" Content="Review privacy" IsEnabled="{Binding Onboarding.CanInteract}" AutomationProperties.Name="Review session history privacy" />
                  <Button Margin="{controls:Inset Right=Sm, Bottom=Sm}" Classes="SecondaryButton" Click="OnRetryOnboardingClick" Content="Retry checks" IsVisible="{Binding Onboarding.CanRetry}" AutomationProperties.Name="Retry getting started checks" />
                  <Button x:Name="OnboardingFinishButton" Margin="{controls:Inset Bottom=Sm}" Classes="PrimaryButton" Click="OnFinishOnboardingClick" Content="Finish setup" IsEnabled="{Binding Onboarding.CanFinish}" AutomationProperties.Name="Finish first-run setup" />
                </WrapPanel>
              </Grid>
            </StackPanel>
          </controls:SurfaceCard>
  
          <StackPanel
              x:Name="LauncherConnectionsSection"
              Focusable="True"
              Spacing="{DynamicResource ShellSpaceMd}"
              AutomationProperties.Name="Saved connections section">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize15}" FontWeight="Bold" Text="Saved Connections" />
                <components:CountPill Value="{Binding TotalConnectionCount}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="TextButton Accent" Click="OnAddConnectionClick" Content="New connection" AutomationProperties.Name="Create a saved connection" />
              <Button Grid.Column="2" Classes="TextButton" Click="OnLauncherConnectionsClick" AutomationProperties.Name="View all saved connections">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock VerticalAlignment="Center" Text="View all" />
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronRight" FontSize="12" />
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding ConnectionsPreview}" ItemTemplate="{StaticResource ConnectionCardTemplate}" IsVisible="{Binding HasConnections}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoConnections}">
              <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="WindowConsole" FontSize="17" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" Text="No saved connections yet." />
                <Button Grid.Column="2" Classes="TextButton Accent" Click="OnAddConnectionClick" Content="Create connection" />
              </Grid>
            </controls:SurfaceCard>
          </StackPanel>
  
          <StackPanel
              x:Name="LauncherScreensSection"
              Focusable="True"
              Spacing="{DynamicResource ShellSpaceMd}"
              AutomationProperties.Name="Saved screens section">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize15}" FontWeight="Bold" Text="Saved Screens" />
                <components:CountPill Value="{Binding Screens.Count}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="TextButton Accent" Click="OnCreateScreenClick" Content="New screen" AutomationProperties.Name="Create a saved screen" />
              <Button Grid.Column="2" Classes="TextButton" Click="OnLauncherScreensClick" AutomationProperties.Name="View all saved screens">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock VerticalAlignment="Center" Text="View all" />
                  <icons:SymbolIcon VerticalAlignment="Center" Symbol="ChevronRight" FontSize="12" />
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding ScreensPreview}" ItemTemplate="{StaticResource ScreenCardTemplate}" IsVisible="{Binding HasScreens}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoScreens}">
              <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon Symbol="Grid" FontSize="17" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" Text="No reusable screens yet." />
                <Button Grid.Column="2" Classes="TextButton Accent" Click="OnCreateScreenClick" Content="Create screen" />
              </Grid>
            </controls:SurfaceCard>
          </StackPanel>
  
          <StackPanel x:Name="LauncherHistorySection" Focusable="True" Spacing="{DynamicResource ShellSpaceMd}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="{DynamicResource ShellFontSize15}" FontWeight="Bold" Text="Recent Sessions" />
              <Button
                  Grid.Column="1"
                  Classes="TextButton"
                  Click="OnClearRecentSessionsClick"
                  Content="Clear history"
                  IsEnabled="{Binding CanClearRecentSessionHistory}"
                  ToolTip.Tip="Remove stored recent-session metadata" />
            </Grid>
            <controls:SurfaceCard Tone="Raised" Padding="0" IsVisible="{Binding HasRecentSessions}" ClipToBounds="True">
              <ItemsControl ItemsSource="{Binding RecentSessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button
                        Classes="ListRow"
                        Click="OnOpenRecentSessionClick"
                        IsEnabled="{Binding CanOpen}"
                        AutomationProperties.Name="{Binding Title, StringFormat=Reopen recent session {0}}">
                      <Grid Height="54" Margin="{controls:Inset Horizontal=Lg}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                        <Border Width="30" Height="30" VerticalAlignment="Center" Classes="IconTile Neutral">
                          <icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="{Binding SourceGlyph}" FontSize="15" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                          <TextBlock FontSize="{DynamicResource ShellFontSize13}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <controls:StatusChip Shape="Rounded" Tone="Default" IsOutlined="False" Grid.Column="2" Content="{Binding SourceKind}" />
                        <TextBlock Grid.Column="3" MinWidth="76" VerticalAlignment="Center" TextAlignment="Right" Classes="Muted" FontSize="{DynamicResource ShellFontSize11}" Text="{Binding LastUsed}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:SurfaceCard>
            <controls:SurfaceCard Tone="Raised" Padding="0" IsVisible="{Binding IsHistoryLoading}">
              <StackPanel Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceMd}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Loading recent session history">
                <ProgressBar Width="72" IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center" Classes="Muted" Text="Loading recent sessions…" />
              </StackPanel>
            </controls:SurfaceCard>
            <controls:SurfaceCard Tone="Raised" Padding="0" IsVisible="{Binding HasNoRecentSessions}">
              <Grid Margin="{controls:Inset Horizontal=Lg, Vertical=Md}" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                <Border Width="30" Height="30" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="History" FontSize="14" /></Border>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource ShellSpaceXs}">
                  <TextBlock FontWeight="SemiBold" Text="No recent sessions" />
                  <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding RecentSessionStatus}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </controls:SurfaceCard>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
  
      <!-- The sidebar names Saved Connections and Screens as destinations, and
           Home's "View all" needs somewhere to go, so each is a real page rather
           than a scroll position inside Home. Creating lives here, next to the
           full list it adds to. -->
      <ScrollViewer
          x:Name="LauncherConnectionsScrollViewer"
          IsVisible="{Binding IsLauncherConnectionsVisible}">
        <StackPanel Margin="{controls:Inset Horizontal=Xxl, Top=Sm, Bottom=Xxl}" Spacing="{DynamicResource ShellSpaceLg}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize22}" FontWeight="Bold" Text="Saved Connections" />
                <components:CountPill VerticalAlignment="Center" Value="{Binding TotalConnectionCount}" />
              </StackPanel>
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="Terminals, file transfer, and databases in one place" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="PrimaryButton"
                Click="OnAddConnectionClick"
                AutomationProperties.Name="Add a saved connection">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon VerticalAlignment="Center" Symbol="Add" FontSize="16" />
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize13}" Text="Add connection" />
              </StackPanel>
            </Button>
          </Grid>
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding HasTerminalConnections}">
            <TextBlock Classes="Eyebrow" Text="Terminal" />
            <ItemsControl
                x:Name="LauncherAllConnectionsList"
                ItemsSource="{Binding Connections}"
                ItemTemplate="{StaticResource ConnectionCardTemplate}"
                AutomationProperties.Name="Saved terminal connections">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding HasFileConnections}">
            <TextBlock Classes="Eyebrow" Text="File transfer" />
            <ItemsControl
                x:Name="LauncherFileConnectionsList"
                ItemsSource="{Binding FileConnections}"
                ItemTemplate="{StaticResource ConnectionCardTemplate}"
                AutomationProperties.Name="Saved file connections">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="{DynamicResource ShellSpaceSm}" IsVisible="{Binding HasDatabaseConnections}">
            <TextBlock Classes="Eyebrow" Text="Databases" />
            <ItemsControl
                x:Name="LauncherDatabaseConnectionsList"
                ItemsSource="{Binding DatabaseConnections}"
                ItemTemplate="{StaticResource ConnectionCardTemplate}"
                AutomationProperties.Name="Saved database connections">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoConnections}">
            <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon Symbol="WindowConsole" FontSize="17" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" Text="No saved connections yet." />
              <Button Grid.Column="2" Classes="TextButton Accent" Click="OnAddConnectionClick" Content="Create connection" />
            </Grid>
          </controls:SurfaceCard>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer
          x:Name="LauncherScreensScrollViewer"
          IsVisible="{Binding IsLauncherScreensVisible}">
        <StackPanel Margin="{controls:Inset Horizontal=Xxl, Top=Sm, Bottom=Xxl}" Spacing="{DynamicResource ShellSpaceLg}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceLg}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize22}" FontWeight="Bold" Text="Saved Screens" />
                <components:CountPill VerticalAlignment="Center" Value="{Binding Screens.Count}" />
              </StackPanel>
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="Reusable panel arrangements you can open as a tab" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="PrimaryButton"
                Click="OnCreateScreenClick"
                AutomationProperties.Name="Add a saved screen">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ShellSpaceSm}">
                <icons:SymbolIcon VerticalAlignment="Center" Symbol="Add" FontSize="16" />
                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize13}" Text="Add screen" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl
              x:Name="LauncherAllScreensList"
              ItemsSource="{Binding Screens}"
              ItemTemplate="{StaticResource ScreenCardTemplate}"
              IsVisible="{Binding HasScreens}"
              AutomationProperties.Name="All saved screens">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGridPanel MinItemWidth="256" Spacing="{DynamicResource ShellSpaceMd}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoScreens}">
            <Grid Margin="{controls:Inset Md}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <icons:SymbolIcon Symbol="Grid" FontSize="17" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="Muted" Text="No reusable screens yet." />
              <Button Grid.Column="2" Classes="TextButton Accent" Click="OnCreateScreenClick" Content="Create screen" />
            </Grid>
          </controls:SurfaceCard>
        </StackPanel>
      </ScrollViewer>

      <Grid
          Margin="{controls:Inset Horizontal=Xxl, Top=Sm, Bottom=Xxl}"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="{DynamicResource ShellSpaceLg}"
          IsVisible="{Binding IsLauncherHistoryVisible}">
        <Grid ColumnDefinitions="2*,*" ColumnSpacing="{DynamicResource ShellSpaceLg}">
          <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
            <TextBlock FontSize="{DynamicResource ShellFontSize22}" FontWeight="Bold" Text="Session History" />
            <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize12}" Text="Definition metadata only—never commands, output, environment values, or credentials" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ShellSpaceSm}">
            <icons:SymbolIcon VerticalAlignment="Center" Symbol="Search" FontSize="15" />
            <TextBox
                x:Name="HistorySearchBox"
                Grid.Column="1"
                PlaceholderText="Search title, source, kind, outcome, or session ID…"
                AutomationProperties.Name="Search session history"
                KeyDown="OnHistorySearchKeyDown"
                Text="{Binding HistorySearchQuery}" />
          </Grid>
        </Grid>
  
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="{DynamicResource ShellSpaceLg}">
          <controls:SurfaceCard Tone="Raised" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="42,*">
              <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="{controls:Inset Horizontal=Md}" ColumnDefinitions="*,Auto">
                  <TextBlock VerticalAlignment="Center" Classes="SectionHeading" Text="Retained sessions" />
                  <components:CountPill Grid.Column="1" VerticalAlignment="Center" Value="{Binding HistoryResultCount}" />
                </Grid>
              </Border>
              <ListBox
                  x:Name="HistorySessionList"
                  Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  AutomationProperties.Name="Retained session history"
                  ItemsSource="{Binding FilteredHistorySessions}"
                  SelectedItem="{Binding SelectedHistorySession, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="62" Margin="{controls:Inset Horizontal=Md, Vertical=Xs}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource ShellSpaceMd}">
                      <Border Width="34" Height="34" VerticalAlignment="Center" Classes="IconTile"><icons:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="History" FontSize="14" /></Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{DynamicResource ShellSpaceXs}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="{DynamicResource ShellSpaceXs}">
                        <Border HorizontalAlignment="Right" Classes="Keycap"><TextBlock Text="{Binding SourceKind}" /></Border>
                        <TextBlock HorizontalAlignment="Right" Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding LastUsed}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel
                  Grid.Row="1"
                  Margin="{controls:Inset Xl}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="{DynamicResource ShellSpaceSm}"
                  IsVisible="{Binding HasNoFilteredHistorySessions}"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="Session history has no results">
                <icons:SymbolIcon HorizontalAlignment="Center" Symbol="History" FontSize="24" />
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No history results" />
                <TextBlock MaxWidth="430" HorizontalAlignment="Center" Classes="Muted" Text="{Binding HistorySearchEmptyState}" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel
                  Grid.Row="1"
                  Margin="{controls:Inset Xl}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource ShellSpaceMd}"
                  IsVisible="{Binding IsHistoryLoading}"
                  AutomationProperties.LiveSetting="Polite"
                  AutomationProperties.Name="Loading retained session history">
                <ProgressBar Width="90" IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center" Classes="Muted" Text="Loading retained history…" />
              </StackPanel>
            </Grid>
          </controls:SurfaceCard>
  
          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="{DynamicResource ShellSpaceMd}">
              <controls:SurfaceCard Padding="0" IsVisible="{Binding HasSelectedHistorySession}">
                <StackPanel Margin="{controls:Inset Lg}" Spacing="{DynamicResource ShellSpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
                    <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
                      <TextBlock FontSize="{DynamicResource ShellFontSize16}" FontWeight="SemiBold" Text="{Binding SelectedHistorySession.Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="Muted" Text="{Binding SelectedHistorySession.Detail}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="PrimaryButton"
                        Click="OnOpenSelectedHistorySessionClick"
                        Content="Reopen"
                        IsEnabled="{Binding SelectedHistorySession.CanOpen}"
                        AutomationProperties.Name="Reopen selected history session" />
                  </Grid>
                  <controls:SurfaceCard Tone="Notice" Padding="0"><TextBlock Margin="{controls:Inset Md}" Classes="Muted" FontSize="{DynamicResource ShellFontSize10}" Text="{Binding SelectedHistorySession.ReopenStatus}" TextWrapping="Wrap" /></controls:SurfaceCard>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}" RowSpacing="{DynamicResource ShellSpaceSm}">
                    <TextBlock Classes="SectionHeading" Text="Source type" /><TextBlock Grid.Column="1" Text="{Binding SelectedHistorySession.SourceKind}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Classes="SectionHeading" Text="Source ID" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedHistorySession.SourceIdentifier}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Classes="SectionHeading" Text="Session ID" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHistorySession.SessionIdentifier}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Classes="SectionHeading" Text="Panel" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedHistorySession.PanelKindName}" />
                    <TextBlock Grid.Row="4" Classes="SectionHeading" Text="Started" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedHistorySession.Started}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Classes="SectionHeading" Text="Ended" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedHistorySession.Ended}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="6" Classes="SectionHeading" Text="Duration" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedHistorySession.Duration}" />
                  </Grid>
                </StackPanel>
              </controls:SurfaceCard>
              <controls:SurfaceCard Padding="0" IsVisible="{Binding HasNoSelectedHistorySession}">
                <TextBlock Margin="{controls:Inset Md}" Classes="Muted" Text="Select a retained session to review its exact metadata." TextWrapping="Wrap" />
              </controls:SurfaceCard>
            </StackPanel>
          </ScrollViewer>
        </Grid>
  
        <controls:SurfaceCard Padding="0" Grid.Row="2">
          <Grid Margin="{controls:Inset Lg}" RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource ShellSpaceMd}">
            <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock FontWeight="SemiBold" Text="History privacy" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HistoryRetentionStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="History retention status" />
              <TextBlock Classes="Muted" FontSize="{DynamicResource ShellFontSize9}" Text="{Binding HistoryExportStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="History export status" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ShellSpaceSm}">
              <StackPanel Spacing="{DynamicResource ShellSpaceXs}">
              <TextBlock Classes="SectionHeading" Text="Local retention" />
              <ComboBox
                  ItemsSource="{Binding HistoryRetentionOptions}"
                  SelectedItem="{Binding SelectedHistoryRetentionOption, Mode=TwoWay}"
                  IsEnabled="{Binding CanManageHistoryRetention}"
                  AutomationProperties.Name="Session history retention">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Bottom" Classes="SecondaryButton" Click="OnSaveHistoryRetentionClick" Content="Apply" IsEnabled="{Binding CanApplyHistoryRetention}" AutomationProperties.Name="Apply history retention" />
            </Grid>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Click="OnRetryRecentSessionHistoryClick" Content="Retry" IsEnabled="{Binding CanRetryRecentSessionHistory}" IsVisible="{Binding HasRecentSessionFailure}" AutomationProperties.Name="Retry loading session history" />
              <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Click="OnExportAllHistoryClick" Content="Export all" IsEnabled="{Binding CanExportAllHistory}" AutomationProperties.Name="Export all retained history metadata" />
              <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Click="OnExportFilteredHistoryClick" Content="Export results" IsEnabled="{Binding CanExportFilteredHistory}" AutomationProperties.Name="Export filtered history metadata" />
              <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="SecondaryButton" Click="OnCancelHistoryExportClick" Content="Cancel export" IsVisible="{Binding IsHistoryExporting}" AutomationProperties.Name="Cancel session history export" />
              <Button Margin="{controls:Inset Right=Xs, Bottom=Xs}" Classes="DestructiveButton" Click="OnClearRecentSessionsClick" Content="Clear" IsEnabled="{Binding CanClearRecentSessionHistory}" AutomationProperties.Name="Clear retained session history" />
              <Button Margin="{controls:Inset Bottom=Xs}" Classes="DestructiveButton" Click="OnResetRecentSessionHistoryClick" Content="Reset unreadable history" IsEnabled="{Binding CanResetRecentSessionHistory}" IsVisible="{Binding HasUnreadableRecentSessionHistory}" AutomationProperties.Name="Reset unreadable session history" />
            </WrapPanel>
          </Grid>
        </controls:SurfaceCard>
      </Grid>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
