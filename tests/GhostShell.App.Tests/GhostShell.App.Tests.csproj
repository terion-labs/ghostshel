<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared by link rather than copied: a second hand-written terminal fake
         would be a second set of rules to drift from the first, and these two
         files depend on nothing else in their own project. -->
    <Compile Include="..\GhostShell.SessionHost.Tests\FakeTerminalSession.cs"
             Link="Shared\FakeTerminalSession.cs" />
    <Compile Include="..\GhostShell.SessionHost.Tests\FakeTerminalSessionFactory.cs"
             Link="Shared\FakeTerminalSessionFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GhostShell.App\GhostShell.App.csproj" />
    <!-- The real session host, so a shell-level test can be wrong about the
         host's rules instead of agreeing with a fake that has none. -->
    <ProjectReference Include="..\..\src\GhostShell.SessionHost\GhostShell.SessionHost.csproj" />
  </ItemGroup>

</Project>
