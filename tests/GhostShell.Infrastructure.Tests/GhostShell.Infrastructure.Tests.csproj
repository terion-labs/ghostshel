<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SecurityCampaignCanaries.cs"
             Link="Shared\SecurityCampaignCanaries.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GhostShell.Infrastructure\GhostShell.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GhostShell.Terminal\GhostShell.Terminal.csproj" />
    <ProjectReference
      Include="..\..\tools\GhostShell.SqlLanguageTestWorker\GhostShell.SqlLanguageTestWorker.csproj"
      OutputItemType="_SqlLanguageTestWorkerTargetPath"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target
    Name="AddSqlLanguageTestWorkerPath"
    BeforeTargets="GetAssemblyAttributes"
    DependsOnTargets="ResolveProjectReferences">
    <Error
      Condition="'@(_SqlLanguageTestWorkerTargetPath)' == ''"
      Text="The SQL language test worker target path was not resolved." />
    <ItemGroup>
      <AssemblyMetadata Include="SqlLanguageTestWorkerPath">
        <Value>@(_SqlLanguageTestWorkerTargetPath->'%(FullPath)')</Value>
      </AssemblyMetadata>
    </ItemGroup>
  </Target>

</Project>
